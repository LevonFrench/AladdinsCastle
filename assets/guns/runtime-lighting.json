{
  "id": "gun_lighting_r2",
  "normal_space": "camera-view",
  "direction_to_light": [0.36, 0.70, 0.62],
  "normalize_normal_and_direction": true,
  "ambient": 0.35,
  "directional": 0.65,
  "albedo": "vertex_color * baseColorFactor * linear_body_or_accent_tint",
  "alpha": "product alpha preserved; runtime premultiplies after lighting",
  "output": "linear-to-sRGB",
  "specular": false,
  "shadows": false,
  "tone_mapping": false
}

+void GPU_HW_OpenGL::AcvrSelectEye(uint32_t eye)
+{
+  if (!m_acvr_stereo || eye == m_acvr_eye || m_acvr_other.fbo == 0)
+    return;
+  std::swap(m_vram_texture, m_acvr_other.vram);
+  std::swap(m_vram_depth_texture, m_acvr_other.depth);
+  std::swap(m_vram_read_texture, m_acvr_other.read);
+  std::swap(m_display_texture, m_acvr_other.display);
+  std::swap(m_vram_fbo_id, m_acvr_other.fbo);
+  m_acvr_eye = eye;
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_vram_fbo_id);
+  m_vram_read_texture.Bind();
+}

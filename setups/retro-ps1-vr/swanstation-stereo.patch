+// ACVR stereo: a histogram of PGXP depth (w) over valid vertices, printed every 600 frames
+// when ACVR_PS1_STEREO_STATS is set, to choose the zero-parallax depth per game.
+template <typename Vertex>
+static void AcvrRecordDepth(const Vertex* v, uint32_t count)
+{
+  static const bool enabled = [] { const char* e = std::getenv("ACVR_PS1_STEREO_STATS"); return e && *e && *e != '0'; }();
+  if (!enabled)
+    return;
+  static uint64_t bins[32] = {};
+  static uint64_t samples = 0, calls = 0;
+  for (uint32_t i = 0; i < count; i++)
+  {
+    // log2 bins from w = 1/1024 to w = 4
+    const float w = v[i].w;
+    int b = (w > 0.0f) ? static_cast<int>(std::floor(std::log2(w) * 2.0f)) + 20 : 0;
+    b = std::clamp(b, 0, 31);
+    bins[b]++;
+    samples++;
+  }
+  if ((++calls % 20000) == 0)
+  {
+    std::string line = "ACVR depth histogram (w lower bounds:count):";
+    for (int b = 0; b < 32; b++)
+      if (bins[b])
+        line += " " + std::to_string(std::exp2((b - 20) / 2.0)).substr(0, 6) + ":" + std::to_string(bins[b]);
+    Log_InfoPrintf("%s (vertices %llu)", line.c_str(), static_cast<unsigned long long>(samples));
+    std::fill(std::begin(bins), std::end(bins), 0);
+    samples = 0;
+  }
+}

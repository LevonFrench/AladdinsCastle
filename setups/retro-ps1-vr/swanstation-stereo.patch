+                      nullptr, false) ||
+      !e.read.Create(texture_width, texture_height, 1, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, nullptr, false, true) ||
+      !e.read.CreateFramebuffer() ||
+      !e.display.Create(GPU_MAX_DISPLAY_WIDTH * m_resolution_scale, GPU_MAX_DISPLAY_HEIGHT * m_resolution_scale, 1,
+                        GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, nullptr, false) ||
+      !e.display.CreateFramebuffer())
+  {
+    Log_ErrorPrintf("ACVR stereo: the right eye's VRAM could not be created");
+    return false;
+  }
+  if (e.fbo == 0)
+    glGenFramebuffers(1, &e.fbo);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, e.fbo);
+  glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, e.vram.GetGLTarget(), e.vram.GetGLId(), 0);
+  glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, e.depth.GetGLTarget(), e.depth.GetGLId(), 0);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_vram_fbo_id);
+  return true;
+}

+void GPU_HW::AcvrCountDepth(const BatchVertex* v, uint32_t count)
+{
+  if (!m_acvr_auto_conv)
+    return;
+  for (uint32_t i = 0; i < count; i++)
+  {
+    // quarter-octave bins from w = 1/4096 upwards
+    const float w = v[i].w;
+    if (!(w > 0.0f) || w == 1.0f)
+      continue;
+    const int b = std::clamp(static_cast<int>(std::floor(std::log2(w) * 4.0f)) + 48, 0, 47);
+    m_acvr_depth_bins[b]++;
+  }
+}
+
+void GPU_HW::AcvrDioramaEndFrame()
+{
+  if (m_acvr_auto_conv)
+  {
+    uint64_t total = 0;
+    for (uint32_t n : m_acvr_depth_bins)
+      total += n;
+    if (total >= 64)
+    {
+      uint64_t acc = 0;
+      int bin = 0;
+      for (; bin < 48; bin++)
+      {
+        acc += m_acvr_depth_bins[bin];
+        if (acc >= static_cast<uint64_t>(total * m_acvr_auto_percentile))
+          break;
+      }
+      const float target = std::exp2((bin - 48 + 0.5f) / 4.0f);
+      // Ease over about a second so a cut does not snap the whole scene.
+      m_acvr_auto_value += (target - m_acvr_auto_value) * 0.05f;
+    }
+    std::fill(std::begin(m_acvr_depth_bins), std::end(m_acvr_depth_bins), 0u);
+  }
+  if (!m_acvr_diorama)
+    return;
+  m_acvr_prim_total = std::max<uint32_t>(m_acvr_prim_index, 1u);
+  m_acvr_prim_index = 0;
+}
+
+void GPU_HW::AcvrDioramaApply(BatchVertex* first)
+{
+  BatchVertex* const last = m_batch_current_vertex_ptr;
+  if (!m_acvr_diorama || last <= first)
+    return;
+  const uint32_t index = m_acvr_prim_index++;
+  bool flat = true;
+  float x0 = first->x, x1 = first->x, y0 = first->y, y1 = first->y;
+  for (BatchVertex* v = first; v < last; v++)
+  {
+    flat &= (v->w == 1.0f);
+    x0 = std::min(x0, v->x); x1 = std::max(x1, v->x);
+    y0 = std::min(y0, v->y); y1 = std::max(y1, v->y);
+  }
+  if (!flat)
+    return; // real PGXP depth wins
+  // Only what is drawn into a frame buffer (a drawing area the size of the picture): pieces
+  // drawn into small off-screen work areas are often copied in later, and shifting them twice
+  // would tear their edges.
+  const float area_w = static_cast<float>(m_drawing_area.GetWidth()), area_h = static_cast<float>(m_drawing_area.GetHeight());
+  if (area_w < 0.8f * static_cast<float>(m_crtc_state.display_vram_width) ||
+      area_h < 0.8f * static_cast<float>(m_crtc_state.display_vram_height))
+    return;
+  const float order = std::min(static_cast<float>(index) / static_cast<float>(m_acvr_prim_total), 1.0f);
+  const float area = (x1 - x0) * (y1 - y0);
+  const float screen = static_cast<float>(std::max<uint32_t>(m_crtc_state.display_vram_width, 1u)) *
+                       static_cast<float>(std::max<uint32_t>(m_crtc_state.display_vram_height, 1u));
+  float k; // 1 = at infinity, 0 = on the screen, negative = in front
+  const float screen_w = static_cast<float>(std::max<uint32_t>(m_crtc_state.display_vram_width, 1u));
+  const float screen_h = static_cast<float>(std::max<uint32_t>(m_crtc_state.display_vram_height, 1u));
+  // Backdrops are often drawn as full-height or full-width strips: keep them on one layer.
+  // The first fifth of a frame, and tile-sized pieces of its first 60%, are the backdrop pass
+  // (often tiled): one layer, so tiles keep sharing their edges. The last tenth (usually the
+  // HUD) stays on the screen.
+  if (area > 0.4f * screen || (y1 - y0) > 0.6f * screen_h || (x1 - x0) > 0.6f * screen_w || order < 0.2f ||
+      (area > 0.02f * screen && order < 0.6f))
+    k = m_acvr_diorama_far + 0.2f;
+  else if (order > 0.9f)
+    k = 0.0f;
+  else
+    k = m_acvr_diorama_far + (m_acvr_diorama_near - m_acvr_diorama_far) * ((order - 0.2f) / 0.7f);
+  k = std::min(k, 0.95f);
+  // Whole PlayStation pixels only: a sprite moved by a fraction of a pixel samples the texel
+  // just outside its tile (often transparent) and shows a seam.
+  if (m_acvr_diorama_shift_px > 0.5f)
+    k = std::min(std::round(k * m_acvr_diorama_shift_px) / m_acvr_diorama_shift_px, 0.95f);
+  const float w = m_acvr_diorama_conv / (1.0f - k);
+  for (BatchVertex* v = first; v < last; v++)
+    v->w = w;
+}

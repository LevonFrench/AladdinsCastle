+/* ACVR depth experiment (ACVR_SAT_STEREO=1). Each drawing command gets a number in the order VDP1 draws it,
+ * and every pixel it draws records that number in VDP1_DepthFB (double-buffered with the framebuffer). Per
+ * command it keeps its kind: 2D sprite (normal/scaled: HUD, text), 3D (distorted sprite, polygon, line) with
+ * its rank among the frame's 3D commands, or backdrop (covers 40% of the screen). The Saturn draws back to
+ * front, so a later 3D command is nearer. VDP1_GetDepthLine turns that into a depth per pixel. */
+bool VDP1_DepthOn = false;
+uint16_t VDP1_DrawSeq = 0;
+static uint16_t VDP1_DepthFB[2][0x20000];
+uint16_t* VDP1_DepthFBDrawWhichPtr = VDP1_DepthFB[0];
+enum { ACVR_SEQ_MAX = 8192, ACVR_KIND_2D = 0, ACVR_KIND_3D = 1, ACVR_KIND_BACK = 2 };
+static uint8_t ACVR_SeqKind[2][ACVR_SEQ_MAX];
+static uint16_t ACVR_SeqRank[2][ACVR_SEQ_MAX];
+static uint16_t ACVR_Rank3D[2];
+static float ACVR_Far = 1.0f, ACVR_Pop = 0.3f;
+static int ACVR_BySize = 0;
+static uint32_t ACVR_SeqArea[2][ACVR_SEQ_MAX];
+
+static void ACVR_NoteCommand(const uint16_t* cmd, bool side)
+{
+ const unsigned type = cmd[0] & 0xF;
+ if(type > 7) return;
+ if(VDP1_DrawSeq < ACVR_SEQ_MAX - 1) VDP1_DrawSeq++;
+ int32_t x0, y0, x1, y1;
+ if(type <= 1)
+ {
+  const int32_t w = ((cmd[5] >> 8) & 0x3F) << 3, h = cmd[5] & 0xFF;
+  int32_t xa = (int16_t)(cmd[6] << 3) >> 3, ya = (int16_t)(cmd[7] << 3) >> 3;
+  if(type == 1 && ((cmd[0] >> 8) & 0xF) == 0) { const int32_t xc = (int16_t)(cmd[10] << 3) >> 3, yc = (int16_t)(cmd[11] << 3) >> 3; x0 = xa; y0 = ya; x1 = xc; y1 = yc; }
+  else if(type == 1) { x0 = xa; y0 = ya; x1 = xa + ((int16_t)(cmd[8] << 3) >> 3); y1 = ya + ((int16_t)(cmd[9] << 3) >> 3); }
+  else { x0 = xa; y0 = ya; x1 = xa + w; y1 = ya + h; }
+ }
+ else
+ {
+  x0 = y0 = 0x7FFFFFFF; x1 = y1 = -0x7FFFFFFF;
+  for(unsigned v = 0; v < 4; v++) { const int32_t vx = (int16_t)(cmd[6 + v * 2] << 3) >> 3, vy = (int16_t)(cmd[7 + v * 2] << 3) >> 3; if(vx < x0) x0 = vx; if(vx > x1) x1 = vx; if(vy < y0) y0 = vy; if(vy > y1) y1 = vy; }
+ }
+ int32_t bw = x1 - x0, bh = y1 - y0; if(bw < 0) bw = -bw; if(bh < 0) bh = -bh;
+ if(bw > 704) bw = 704; if(bh > 512) bh = 512;
+ const uint32_t area = (uint32_t)bw * (uint32_t)bh;
+ uint8_t kind = type <= 1 ? ACVR_KIND_2D : ACVR_KIND_3D;
+ if(area * 10 > 320u * 224u * 4) kind = ACVR_KIND_BACK;
+ ACVR_SeqKind[side][VDP1_DrawSeq] = kind;
+ ACVR_SeqArea[side][VDP1_DrawSeq] = area;
+ ACVR_SeqRank[side][VDP1_DrawSeq] = kind == ACVR_KIND_3D ? ACVR_Rank3D[side]++ : 0;
+}
+
+static void ACVR_NewDrawSide(void)
+{
+ VDP1_DepthFBDrawWhichPtr = VDP1_DepthFB[FBDrawWhich];
+ if(!VDP1_DepthOn) return;
+ memset(VDP1_DepthFBDrawWhichPtr, 0, sizeof(VDP1_DepthFB[0]));
+ VDP1_DrawSeq = 0; ACVR_Rank3D[FBDrawWhich] = 0;
+}
+
+/* Depth of each pixel of a displayed VDP1 line, coded 0 = no VDP1 pixel, else 1 + round((d + 0.5) * 100) with
+ * d in [-0.5, 1.5]: 0 on the screen plane, 1 at the eyes' separation (infinity), negative in front. */
+void VDP1_GetDepthLine(const int line, uint8_t* out, unsigned w)
+{
+ if(!VDP1_DepthOn || (VDP1_TVMR & VDP1_TVMR_ROTATE)) { memset(out, 0, w); return; }
+ const bool side = !FBDrawWhich;
+ const uint16_t* row = &VDP1_DepthFB[side][(line & 0xFF) << 9];
+ const uint32_t n3 = ACVR_Rank3D[side] > 1 ? ACVR_Rank3D[side] - 1 : 1;
+ for(unsigned i = 0; i < w; i++)
+ {
+  const uint16_t seq = row[i];
+  if(!seq) { out[i] = 0; continue; }
+  float d;
+  switch(ACVR_SeqKind[side][seq])
+  {
+   case ACVR_KIND_BACK: d = ACVR_Far; break;
+   case ACVR_KIND_3D:
+    if(ACVR_BySize) { const float a = ACVR_SeqArea[side][seq] / (320.0f * 224.0f * 0.25f); d = ACVR_Far - (ACVR_Far + ACVR_Pop) * (a > 1 ? 1 : a); }
+    else d = ACVR_Far - (ACVR_Far + ACVR_Pop) * ((float)ACVR_SeqRank[side][seq] / (float)n3);
+    break;
+   default: d = 0; break;
+  }
+  int v = (int)((d + 0.5f) * 100.0f + 0.5f); if(v < 0) v = 0; if(v > 200) v = 200;
+  out[i] = (uint8_t)(1 + v);
+ }
+}

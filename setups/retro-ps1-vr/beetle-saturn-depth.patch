+/* ACVR depth experiment (ACVR_SAT_STEREO=1): the renderer writes a depth code per surface pixel into
+ * ACVR_DepthPix (see VDP1_GetDepthLine); the frame goes out as two eyes side by side, the left eye as the
+ * game drew it (so the light gun maps to it unchanged) and the right eye with every pixel moved sideways by
+ * its depth: 0 on the screen plane, the eyes' separation on the screen (ACVR_PS1_IPD / ACVR_PS1_SCREEN_W of the
+ * picture width) at infinity. Holes left behind take the farther neighbour. */
+extern uint8_t* ACVR_DepthPix; extern int32_t ACVR_DepthPitch, ACVR_DepthRows; extern float ACVR_FarCode, ACVR_FloorCode;
+extern bool VDP1_DepthOn;
+static uint32_t *acvr_sbs = NULL; static size_t acvr_sbs_size = 0;
+static const void *acvr_stereo_frame(const uint32_t *pix, size_t pitch_px, unsigned w, unsigned h, unsigned first_row, unsigned x0)
+{
+   static float sep = -1.0f;
+   if (sep < 0.0f)
+   {
+      const char *ipd = getenv("ACVR_PS1_IPD"), *sw = getenv("ACVR_PS1_SCREEN_W"), *dp = getenv("ACVR_SAT_STEREO_SCALE");
+      const float i = ipd && *ipd ? (float)atof(ipd) : 0.064f, s = sw && *sw ? (float)atof(sw) : 2.4f, k = dp && *dp ? (float)atof(dp) : 1.0f;
+      sep = (s > 0.1f ? i / s : 0.0267f) * k;
+   }
+   const size_t need = (size_t)w * 2 * h;
+   if (need > acvr_sbs_size) { free(acvr_sbs); acvr_sbs = (uint32_t*)malloc(need * sizeof(uint32_t)); acvr_sbs_size = acvr_sbs ? need : 0; }
+   if (!acvr_sbs || w > 1024) return NULL;
+   static float zrow[1024]; static int16_t filled[1024];
+   const float inf_px = sep * (float)w;
+   for (unsigned y = 0; y < h; y++)
+   {
+      const uint32_t *src = pix + (size_t)y * pitch_px;
+      uint32_t *left = acvr_sbs + (size_t)y * w * 2, *right = left + w;
+      memcpy(left, src, w * sizeof(uint32_t));
+      const int32_t drow = (int32_t)(first_row + y);
+      const uint8_t *dsrc = (drow >= 0 && drow < ACVR_DepthRows) ? ACVR_DepthPix + (size_t)drow * ACVR_DepthPitch + x0 : NULL;
+      static int debug = -1; if (debug < 0) { const char *g = getenv("ACVR_SAT_STEREO_DEBUG"); debug = g && atoi(g) == 1; }
+      if (debug)
+      {
+         /* The right half shows the depth itself: white on the screen plane, darker further away, red in front,
+          * blue for VDP2 pixels with no sprite under them. */
+         for (unsigned x = 0; x < w; x++)
+         {
+            const uint8_t c = dsrc ? dsrc[x] : 0;
+            const float d = c ? (float)(c - 1) / 100.0f - 0.5f : 0.0f;
+            const int g = (int)(255.0f * (1.0f - (d > 0 ? (d > 1.2f ? 1.2f : d) / 1.2f : 0.0f)));
+            right[x] = d < 0 ? 0xFF0000u : (c == 0 ? 0x0000FFu : (uint32_t)((g << 16) | (g << 8) | g));
+         }
+         continue;
+      }
+      for (unsigned x = 0; x < w; x++) { zrow[x] = 1e9f; filled[x] = 0; }
+      for (unsigned x = 0; x < w; x++)
+      {
+         const uint8_t c = dsrc ? dsrc[x] : 0;
+         const float d = c ? (float)(c - 1) / 100.0f - 0.5f : 0.0f;
+         const int t = (int)x + (int)(d * inf_px + (d >= 0 ? 0.5f : -0.5f));
+         if (t < 0 || t >= (int)w || d >= zrow[t]) continue;
+         zrow[t] = d; right[t] = src[x]; filled[t] = 1;
+      }
+      for (unsigned x = 0; x < w; x++)
+      {
+         if (filled[x]) continue;
+         int l = (int)x - 1, r = (int)x + 1;
+         while (l >= 0 && !filled[l]) l--;
+         while (r < (int)w && !filled[r]) r++;
+         const bool useL = l >= 0 && (r >= (int)w || zrow[l] >= zrow[r]);
+         right[x] = useL ? right[l] : (r < (int)w ? right[r] : src[x]);
+      }
+   }
+   return acvr_sbs;
+}

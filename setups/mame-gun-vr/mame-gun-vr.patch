+	// crosshair shows where a script or the VR viewer is aiming.
+	s32 rawvalue = (m_use_adjoverride ? m_adjoverride : apply_settings(m_accum)) & (m_field.mask() >> m_shift);
 	return float(rawvalue - m_adjmin) / float(m_adjmax - m_adjmin);
 }
 

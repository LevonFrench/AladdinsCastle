+++ b/src/emu/ioport.cpp
@@ -4002,7 +4002,16 @@ void analog_field::read(ioport_value &result)
 	// if set programmatically, only use the override value
 	if (m_use_adjoverride)
 	{
-		result = m_adjoverride;
+		// ACVR gun-vr branch fix: the stock code did "result = m_adjoverride;",
+		// which ignored this field's shift, mask and invert flag and wiped every
+		// other bit of the same port.  Insert the override exactly like the
+		// normal path below does (remap, invert, then shift into the mask).
+		s32 value = m_adjoverride;
+		if (m_field.remap_table() != nullptr)
+			value = m_field.remap_table()[value];
+		if (m_field.analog_invert())
+			value = ~value;
+		result = (result & ~m_field.mask()) | ((value << m_shift) & m_field.mask());
 		return;
 	}
 
@@ -4036,7 +4045,9 @@ void analog_field::read(ioport_value &result)
 
 float analog_field::crosshair_read()

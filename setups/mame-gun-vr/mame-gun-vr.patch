+// ACVR gun-vr branch: launcher-approved absent files (see handle_missing_file)
+bool acvr_allowed_missing(std::string_view name)
+{
+	const char *list = std::getenv("MAME_VR_ALLOW_MISSING");
+	if (!list || !*list || name.empty()) return false;
+	std::string_view rest(list);
+	while (!rest.empty())
+	{
+		const size_t comma = rest.find(',');
+		if (rest.substr(0, comma) == name) return true;
+		if (comma == std::string_view::npos) break;
+		rest.remove_prefix(comma + 1);
+	}
+	return false;
+}

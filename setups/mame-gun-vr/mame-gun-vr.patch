diff --git a/src/frontend/mame/acvr_mono.cpp b/src/frontend/mame/acvr_mono.cpp
new file mode 100644
index 00000000..05bb5bc0
--- /dev/null
+++ b/src/frontend/mame/acvr_mono.cpp
@@ -0,0 +1,795 @@
+// license:BSD-3-Clause
+/***************************************************************************
+
+    acvr_mono.cpp
+
+    ACVR generic mono frame publisher and generic gun input (gun-vr branch).
+
+    Off unless an environment variable is set:
+      MAME_VR_PUBLISH=1    publish the first screen, as MAME renders it
+                           (game rotation and flips applied, the same native
+                           view and software renderer the snapshot code uses),
+                           into shared memory "Local\ACVRMG-<pid>" each frame.
+      MAME_VR_GUN=1        read normalised u,v + buttons for players 1 and 2
+                           from the same mapping and drive the game's lightgun
+                           / AD stick fields and buttons with set_value.
+      MAME_VR_CROSSHAIR=1  force MAME's own crosshair on (proof aid);
+                           =0 forces it off (clean pictures of the game's
+                           own cursor; script mode defaults to off).
+      MAME_VR_AIM=xs,xo,ys,yo[,margin]  per-game aim trim around the picture
+                           centre (margin: on-screen aim stays that far inside
+                           0..1, default 0.004, as gun boards read their extreme
+                           values as off-screen):
+                           u' = 0.5 + (u - 0.5) * xs + xo (same for v), applied
+                           to every on-screen aim before the crosshair inverse.
+      MAME_VR_SCRIPT=<file>  offline proof mode: input comes from a schedule
+                           keyed by emulated frame (deterministic), never from
+                           shared memory.  MAME_VR_SNAPDIR=<dir> receives PNGs
+                           of the exact picture the viewer would get and a log.
+                           Lines: "<frame> <command> ...", commands:
+                             aim <p> <u> <v>     aim (sticky), p = 1 or 2
+                             off <p>             point off-screen (sticky)
+                             hold <p> <TBSC> <n> hold trigger/button2/start/coin n frames
+                             press <TOKEN> <n>   hold any input type n frames
+                                                 (MAME tokens: SERVICE, SERVICE1, P1_BUTTON3, ...)
+                             dip <port> <mask> <value>  set a DIP / config field (hex)
+                             snap <name>         save <name>.png and a log line
+                             quit                exit normally
+
+    Aim mapping: MAME's crosshair is MAME's calibration of where a gun value
+    lands on screen (ioport_field::crosshair_read).  u,v on the displayed
+    picture are mapped back through the render target orientation and the
+    screen container orientation to native screen coordinates, then the
+    crosshair scale/offset is inverted to get the field value.
+
+***************************************************************************/
+
+#include "emu.h"
+#include "acvr_mono.h"
+#include "acvr_mono_frames.h"
+
+#include "crsshair.h"
+#include "render.h"
+#include "rendutil.h"
+#include "rendersw.hxx"
+#include "screen.h"
+
+#include "fileio.h"
+#include "png.h"
+#include "xmlfile.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <bit>
+#include <fstream>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace {
+
+bool env_on(const char *name)
+{
+	const char *text = std::getenv(name);
+	return text && text[0] == '1';
+}
+
+// orientation on a normalised point, same order as render.cpp apply_orientation
+void apply_orient(int o, float &x, float &y)
+{
+	if (o & ORIENTATION_SWAP_XY) std::swap(x, y);
+	if (o & ORIENTATION_FLIP_X) x = 1.0f - x;
+	if (o & ORIENTATION_FLIP_Y) y = 1.0f - y;
+}
+
+void undo_orient(int o, float &x, float &y)
+{
+	if (o & ORIENTATION_FLIP_X) x = 1.0f - x;
+	if (o & ORIENTATION_FLIP_Y) y = 1.0f - y;
+	if (o & ORIENTATION_SWAP_XY) std::swap(x, y);
+}
+
+float g_trackball[2] = { 0.0f, 0.0f }; // MAME_VR_TRACKBALL counts across the picture
+
+typedef software_renderer<u32, 0,0,0, 16,8,0, false, false> mono_renderer;
+
+struct gun_fields
+{
+	ioport_field *x = nullptr, *y = nullptr;
+	ioport_field *trigger = nullptr, *button2 = nullptr, *start = nullptr, *coin = nullptr;
+};
+
+struct script_line
+{
+	u64 frame = 0;
+	std::string cmd;
+	std::vector<std::string> args;
+};
+
+class acvr_mono_module
+{
+public:
+	acvr_mono_module(running_machine &machine, bool publish, bool gun, int crosshair, const char *script, const char *snapdir)
+		: m_machine(machine), m_publish(publish), m_gun(gun), m_crosshair(crosshair)
+	{
+		if (const char *aim = std::getenv("MAME_VR_AIM"))
+		{
+			float t[5] = { 1.0f, 0.0f, 1.0f, 0.0f, m_margin };
+			const int n = std::sscanf(aim, "%f,%f,%f,%f,%f", &t[0], &t[1], &t[2], &t[3], &t[4]);
+			if (n >= 4 && t[0] > 0.25f && t[0] < 4.0f && t[2] > 0.25f && t[2] < 4.0f)
+			{
+				std::copy(t, t + 4, std::begin(m_trim));
+				if (n == 5 && t[4] >= 0.0f && t[4] < 0.2f) m_margin = t[4];
+			}
+			osd_printf_info("ACVR gun: aim trim %.4f,%.4f,%.4f,%.4f edge margin %.4f\n", m_trim[0], m_trim[1], m_trim[2], m_trim[3], m_margin);
+		}
+		if (const char *tb = std::getenv("MAME_VR_TRACKBALL"))
+			if (std::sscanf(tb, "%f,%f", &g_trackball[0], &g_trackball[1]) == 2)
+				osd_printf_info("ACVR gun: trackball counts across the picture %.1f, %.1f\n", g_trackball[0], g_trackball[1]);
+		if (script && *script)
+			load_script(script, snapdir ? snapdir : ".");
+		machine.add_notifier(MACHINE_NOTIFY_FRAME, machine_notify_delegate(&acvr_mono_module::frame, this));
+		machine.add_notifier(MACHINE_NOTIFY_EXIT, machine_notify_delegate(&acvr_mono_module::exit, this));
+	}
+
+private:
+	running_machine &m_machine;
+	bool m_publish, m_gun;
+	int m_crosshair; // 1 force on, 0 force off, -1 MAME default
+	bool m_started = false;
+	float m_trim[4] = { 1.0f, 0.0f, 1.0f, 0.0f };
+	float m_margin = 0.004f; // on-screen aim stays this far inside 0..1 (5th MAME_VR_AIM value)
+
+	// script (offline proof) mode
+	bool m_script = false;
+	std::string m_snapdir;
+	std::vector<script_line> m_lines;
+	size_t m_next_line = 0;
+	u64 m_frame_no = 0;
+	FILE *m_log = nullptr;
+	acvr_mono::controls m_sin[acvr_mono::players] = {};
+	acvr_mono::gun_state m_sstate[acvr_mono::players] = {};
+	u64 m_until[acvr_mono::players][4] = {}; // trigger, button2, start, coin: hold while frame < until
+	struct held { ioport_field *field; u64 until; };
+	std::vector<held> m_held;
+
+	// motion cabinets: MAME_VR_MOTION="PORT:axis[:flags];..." maps the viewer's body axes
+	// onto analog fields; flags: h = 0..1 drives centre..max (self-centring levers),
+	// r = reversed. A field named here is never a gun axis.
+	struct motion_field { ioport_field *field; unsigned axis; bool half, reverse; std::string port; };
+	std::vector<motion_field> m_motion;
+	float m_saxis[acvr_mono::motion_axes] = {};
+	bool m_saxis_set[acvr_mono::motion_axes] = {};
+	bool m_motion_applied = false;
+
+	static int axis_index(const std::string &name)
+	{
+		static const char *const names[] = { "steer", "throttle", "brake", "stickx", "sticky", "throttle2", "lean", "twist", "pedal" };
+		for (int i = 0; i < int(std::size(names)); ++i) if (name == names[i]) return i;
+		return -1;
+	}
+	static bool axis_bipolar(unsigned a)
+	{
+		return a == acvr_mono::axis_steer || a == acvr_mono::axis_stick_x || a == acvr_mono::axis_stick_y || a == acvr_mono::axis_lean || a == acvr_mono::axis_twist;
+	}
+
+	void find_motion()
+	{
+		const char *spec = std::getenv("MAME_VR_MOTION");
+		if (!spec || !*spec) return;
+		std::string rest(spec);
+		for (size_t pos = 0; pos < rest.size(); )
+		{
+			size_t end = rest.find(';', pos); if (end == std::string::npos) end = rest.size();
+			const std::string item = rest.substr(pos, end - pos); pos = end + 1;
+			const size_t c1 = item.find(':'); if (c1 == std::string::npos) continue;
+			const size_t c2 = item.find(':', c1 + 1);
+			const std::string port = item.substr(0, c1), axis = item.substr(c1 + 1, c2 == std::string::npos ? std::string::npos : c2 - c1 - 1);
+			const std::string flags = c2 == std::string::npos ? std::string() : item.substr(c2 + 1);
+			const int a = axis_index(axis);
+			ioport_port *pp = m_machine.root_device().ioport(port);
+			ioport_field *field = nullptr;
+			if (pp) for (ioport_field &f : pp->fields()) if (!field && f.is_analog()) field = &f;
+			if (a < 0 || !field) { osd_printf_warning("ACVR motion: %s -> not found\n", item); continue; }
+			m_motion.push_back({ field, unsigned(a), flags.find('h') != std::string::npos, flags.find('r') != std::string::npos, port });
+			osd_printf_info("ACVR motion: %s '%s' %d..%d <- %s%s%s\n", port, field->name(), adj(*field, field->minval()), adj(*field, field->maxval()), axis,
+					flags.find('h') != std::string::npos ? " (centre..max)" : "", flags.find('r') != std::string::npos ? " reversed" : "");
+		}
+	}
+	bool is_motion_field(const ioport_field &f) const
+	{
+		for (const motion_field &m : m_motion) if (m.field == &f) return true;
+		return false;
+	}
+
+	// one body axis value -> the field value, following MAME's own direction for the field
+	static s32 motion_value(const motion_field &m, float value)
+	{
+		const ioport_field &f = *m.field;
+		const s32 lo = adj(f, f.minval()), hi = adj(f, f.maxval());
+		float n = axis_bipolar(m.axis) ? 0.5f + 0.5f * std::clamp(value, -1.0f, 1.0f) : std::clamp(value, 0.0f, 1.0f);
+		if (m.half) n = 0.5f + 0.5f * n;
+		if (f.analog_reverse() != m.reverse) n = 1.0f - n;
+		return std::clamp(s32(std::lround(lo + n * float(hi - lo))), std::min(lo, hi), std::max(lo, hi));
+	}
+
+	void apply_motion(const float *axis, const bool *set, bool fresh)
+	{
+		for (const motion_field &m : m_motion)
+		{
+			if (fresh && (!set || set[m.axis])) m.field->set_value(motion_value(m, axis[m.axis]));
+			else m.field->clear_value();
+		}
+		m_motion_applied = fresh;
+	}
+	acvr_mono::publisher m_shm;
+	render_target *m_target = nullptr;
+	screen_device *m_screen = nullptr;
+	bitmap_rgb32 m_bitmap;
+	gun_fields m_fields[acvr_mono::players];
+	bool m_applied[acvr_mono::players] = { false, false };
+
+	static s32 adj(const ioport_field &f, ioport_value v)
+	{
+		const ioport_value mask = f.mask();
+		const unsigned shift = mask ? std::countr_zero(mask) : 0U;
+		return s32((v & mask) >> shift);
+	}
+
+	int container_orientation() const { return m_screen ? m_screen->container().orientation() : 0; }
+
+	// displayed u,v -> native screen container x,y
+	void to_container(float u, float v, float &x, float &y) const
+	{
+		x = u; y = v;
+		undo_orient(m_target->orientation(), x, y);
+		undo_orient(container_orientation(), x, y);
+	}
+
+	void to_display(float x, float y, float &u, float &v) const
+	{
+		u = x; v = y;
+		apply_orient(container_orientation(), u, v);
+		apply_orient(m_target->orientation(), u, v);
+	}
+
+	// invert crosshair_read(): screen position on this field's axis -> value
+	static s32 aim_value(const ioport_field &f, float pos)
+	{
+		const s32 lo = adj(f, f.minval()), hi = adj(f, f.maxval());
+		float n = pos;
+		const float scale = f.crosshair_scale(), offset = f.crosshair_offset();
+		if (f.crosshair_axis() != CROSSHAIR_AXIS_NONE && scale != 0.0f)
+		{
+			if (scale < 0)
+				n = 1.0f - (pos - offset) / -scale;
+			else
+				n = (pos - offset) / scale;
+		}
+		else if (f.analog_reverse())
+		{
+			// no crosshair calibration: follow what MAME's own input does for a
+			// reversed field (moving right lowers the value the game reads), as the
+			// override bypasses the field settings (Operation Wolf 3 X)
+			n = 1.0f - pos;
+		}
+		if (f.type() == IPT_TRACKBALL_X || f.type() == IPT_TRACKBALL_Y)
+		{
+			// trackball games: the counter the game reads is driven as an absolute
+			// position, MAME_VR_TRACKBALL=<counts across the picture x>,<y>; the
+			// game turns counter steps into cursor steps, so with the right count
+			// the cursor follows the aim, and it re-aligns at each picture edge
+			const float k = f.type() == IPT_TRACKBALL_X ? g_trackball[0] : g_trackball[1];
+			const s32 value = s32(std::lround(std::clamp(n, 0.0f, 1.0f) * k));
+			return value & s32(f.mask() >> (f.mask() ? std::countr_zero(f.mask()) : 0));
+		}
+		const s32 value = s32(std::lround(lo + n * float(hi - lo)));
+		return std::clamp(value, std::min(lo, hi), std::max(lo, hi));
+	}
+
+	static bool axis_is_x(const ioport_field &f)
+	{
+		if (f.crosshair_axis() == CROSSHAIR_AXIS_X) return true;
+		if (f.crosshair_axis() == CROSSHAIR_AXIS_Y) return false;
+		return f.type() == IPT_LIGHTGUN_X || f.type() == IPT_AD_STICK_X || f.type() == IPT_TRACKBALL_X;
+	}
+
+	static s32 read_bits(ioport_field &f)
+	{
+		ioport_value v = 0;
+		if (f.is_analog()) f.live().analog->read(v);
+		return adj(f, v);
+	}
+
+	void find_fields()
+	{
+		for (auto &port : m_machine.ioport().ports())
+			for (ioport_field &f : port.second->fields())
+			{
+				const int p = f.player();
+				const ioport_type t = f.type();
+				if (is_motion_field(f)) continue;
+				for (unsigned i = 0; i < acvr_mono::players; ++i)
+				{
+					gun_fields &g = m_fields[i];
+					if (unsigned(p) == i)
+					{
+						if (t == IPT_LIGHTGUN_X && (!g.x || g.x->type() != IPT_LIGHTGUN_X)) g.x = &f;
+						else if (t == IPT_AD_STICK_X && !g.x) g.x = &f;
+						else if (t == IPT_LIGHTGUN_Y && (!g.y || g.y->type() != IPT_LIGHTGUN_Y)) g.y = &f;
+						else if (t == IPT_AD_STICK_Y && !g.y) g.y = &f;
+						else if (t == IPT_TRACKBALL_X && !g.x && g_trackball[0] > 0) g.x = &f;
+						else if (t == IPT_TRACKBALL_Y && !g.y && g_trackball[1] > 0) g.y = &f;
+						else if (t == IPT_BUTTON1 && !g.trigger) g.trigger = &f;
+						else if (t == IPT_BUTTON2 && !g.button2) g.button2 = &f;
+					}
+					if (t == ioport_type(IPT_START1 + i) && !g.start) g.start = &f;
+					if (t == ioport_type(IPT_COIN1 + i) && !g.coin) g.coin = &f;
+				}
+			}
+		for (unsigned i = 0; i < acvr_mono::players; ++i)
+		{
+			gun_fields &g = m_fields[i];
+			auto describe = [] (ioport_field *f) -> std::string
+			{
+				if (!f) return "none";
+				return util::string_format("%s:%X '%s' %d..%d xhair axis %d scale %.3f offset %.3f%s",
+						f->port().tag(), f->mask(), f->name(), adj(*f, f->minval()), adj(*f, f->maxval()),
+						int(f->crosshair_axis()), f->crosshair_scale(), f->crosshair_offset(), f->analog_invert() ? " invert" : "");
+			};
+			osd_printf_info("ACVR gun P%u: X %s\n", i + 1, describe(g.x));
+			osd_printf_info("ACVR gun P%u: Y %s\n", i + 1, describe(g.y));
+			osd_printf_info("ACVR gun P%u: trigger %s, button2 %s, start %s, coin %s\n", i + 1,
+					g.trigger ? g.trigger->name() : "none", g.button2 ? g.button2->name() : "none",
+					g.start ? g.start->name() : "none", g.coin ? g.coin->name() : "none");
+			if (m_crosshair >= 0 && (g.x || g.y) && m_machine.crosshair().get_usage())
+			{
+				render_crosshair &c = m_machine.crosshair().get_crosshair(i);
+				if (c.is_used())
+				{
+					c.set_mode(m_crosshair ? CROSSHAIR_VISIBILITY_ON : CROSSHAIR_VISIBILITY_OFF);
+					c.set_visible(m_crosshair != 0);
+				}
+			}
+		}
+		// other players' crosshairs (3-gun cabinets) follow the same rule
+		if (m_crosshair == 0 && m_machine.crosshair().get_usage())
+			for (int i = acvr_mono::players; i < MAX_PLAYERS; ++i)
+			{
+				render_crosshair &c = m_machine.crosshair().get_crosshair(i);
+				if (c.is_used()) { c.set_mode(CROSSHAIR_VISIBILITY_OFF); c.set_visible(false); }
+			}
+		if (!m_fields[0].x && !m_fields[0].y)
+			osd_printf_warning("ACVR gun: no lightgun or AD stick fields for player 1; gun input stays off\n");
+	}
+
+	void start()
+	{
+		m_started = true;
+		m_screen = screen_device_enumerator(m_machine.root_device()).first();
+		if (m_script)
+			m_gun = true; // the schedule drives the same gun mapping as play
+		else if (!m_shm.ok())
+		{
+			osd_printf_error("ACVR mono: shared memory unavailable\n");
+			m_publish = m_gun = false;
+			return;
+		}
+
+		// native target: one view per screen, the screen filling it (as video.cpp -snapview native)
+		util::xml::file::ptr const root(util::xml::file::create());
+		util::xml::data_node *const layoutnode(root->add_child("mamelayout", nullptr));
+		layoutnode->set_attribute_int("version", 2);
+		const unsigned screens = screen_device_enumerator(m_machine.root_device()).count();
+		for (unsigned i = 0; i < std::max(screens, 1U); ++i)
+		{
+			util::xml::data_node *const viewnode(layoutnode->add_child("view", nullptr));
+			viewnode->set_attribute("name", util::string_format("s%1$u", i).c_str());
+			util::xml::data_node *const screennode(viewnode->add_child("screen", nullptr));
+			screennode->set_attribute_int("index", i);
+			util::xml::data_node *const boundsnode(screennode->add_child("bounds", nullptr));
+			boundsnode->set_attribute_int("left", 0);
+			boundsnode->set_attribute_int("top", 0);
+			boundsnode->set_attribute_int("right", 1);
+			boundsnode->set_attribute_int("bottom", 1);
+		}
+		m_target = m_machine.render().target_alloc(*root, RENDER_CREATE_SINGLE_FILE | RENDER_CREATE_HIDDEN);
+		m_target->set_screen_overlay_enabled(false);
+		m_target->set_zoom_to_screen(false);
+		m_target->set_view(0);
+		m_target->resolve_tags(); // allocated after machine start resolved the others
+
+		// MAME_VR_DIPS="PORT:MASK:VALUE;..." (hex) sets DIP/config fields at start,
+		// e.g. a cabinet's control-type switch, without a cfg file
+		if (const char *dips = std::getenv("MAME_VR_DIPS"))
+		{
+			std::string rest(dips);
+			for (size_t pos = 0; pos < rest.size(); )
+			{
+				size_t end = rest.find(';', pos); if (end == std::string::npos) end = rest.size();
+				const std::string item = rest.substr(pos, end - pos); pos = end + 1;
+				const size_t c1 = item.find(':'), c2 = item.rfind(':');
+				if (c1 == std::string::npos || c1 == c2) continue;
+				ioport_port *port = m_machine.root_device().ioport(item.substr(0, c1));
+				const ioport_value mask = ioport_value(std::strtoul(item.substr(c1 + 1, c2 - c1 - 1).c_str(), nullptr, 16));
+				const ioport_value value = ioport_value(std::strtoul(item.substr(c2 + 1).c_str(), nullptr, 16));
+				bool done = false;
+				if (port)
+					for (ioport_field &fld : port->fields())
+						if (fld.mask() == mask) { ioport_field::user_settings us; fld.get_user_settings(us); us.value = value; fld.set_user_settings(us); done = true; }
+				osd_printf_info("ACVR dip %s -> %s\n", item, done ? "set" : "NOT FOUND");
+			}
+		}
+		find_motion();
+		if (m_gun)
+			find_fields();
+		osd_printf_info("ACVR mono: publish %d gun %d, target orientation %d, container orientation %d\n",
+				m_publish, m_gun, m_target->orientation(), container_orientation());
+	}
+
+	void apply_gun(unsigned i, const acvr_mono::controls &in, bool fresh, acvr_mono::gun_state &out)
+	{
+		gun_fields &g = m_fields[i];
+		auto press = [fresh] (ioport_field *f, std::uint32_t on)
+		{
+			if (!f) return;
+			if (fresh && on) f->set_value(1); else f->clear_value();
+		};
+		if (fresh)
+		{
+			float x, y;
+			// off-screen: just outside the top-left corner of the *displayed*
+			// picture, mapped back like any aim point, so flipped games (lethalen
+			// FLIP_Y + crosshair scale -1) get their own top edge, not the bottom
+			float u = in.u, v = in.v;
+			if (!in.off_screen)
+			{
+				// per-game trim; an on-screen aim never reaches the field's extreme
+				// values, which many gun boards report as off-screen (Time Crisis,
+				// Rail Chase): pointing off the screen is the only way to get those
+				const float lo = m_margin, hi = 1.0f - m_margin;
+				u = std::clamp(0.5f + (u - 0.5f) * m_trim[0] + m_trim[1], lo, hi);
+				v = std::clamp(0.5f + (v - 0.5f) * m_trim[2] + m_trim[3], lo, hi);
+			}
+			to_container(in.off_screen ? -0.05f : u, in.off_screen ? -0.05f : v, x, y);
+			for (ioport_field *f : { g.x, g.y })
+				if (f)
+				{
+					const s32 value = aim_value(*f, axis_is_x(*f) ? x : y);
+					f->set_value(value);
+					(f == g.x ? out.x_set : out.y_set) = value;
+				}
+			m_applied[i] = true;
+		}
+		else if (m_applied[i])
+		{
+			if (g.x) g.x->clear_value();
+			if (g.y) g.y->clear_value();
+			m_applied[i] = false;
+		}
+		press(g.trigger, in.trigger);
+		press(g.button2, in.button2);
+		// start/coin of player 2 may be the same field as nobody else's; only drive when found
+		press(g.start, in.start);
+		press(g.coin, in.coin);
+
+		out.active = fresh;
+		out.buttons = fresh ? ((in.trigger ? 1 : 0) | (in.button2 ? 2 : 0) | (in.start ? 4 : 0) | (in.coin ? 8 : 0)) : 0;
+	}
+
+	void fill_state(unsigned i, acvr_mono::gun_state &out)
+	{
+		gun_fields &g = m_fields[i];
+		out.has_x = g.x != nullptr; out.has_y = g.y != nullptr;
+		out.has_trigger = g.trigger != nullptr; out.has_button2 = g.button2 != nullptr;
+		out.has_start = g.start != nullptr; out.has_coin = g.coin != nullptr;
+		float cx = 0.5f, cy = 0.5f;
+		if (g.x)
+		{
+			out.x_min = adj(*g.x, g.x->minval()); out.x_max = adj(*g.x, g.x->maxval());
+			out.x_read = read_bits(*g.x);
+			(axis_is_x(*g.x) ? cx : cy) = g.x->crosshair_read();
+		}
+		if (g.y)
+		{
+			out.y_min = adj(*g.y, g.y->minval()); out.y_max = adj(*g.y, g.y->maxval());
+			out.y_read = read_bits(*g.y);
+			(axis_is_x(*g.y) ? cx : cy) = g.y->crosshair_read();
+		}
+		to_display(cx, cy, out.cross_u, out.cross_v);
+	}
+
+	// open frame: a driver's wider picture (see acvr_mono.h), else MAME's render
+	static bool wide_active()
+	{
+		return g_acvr_wide.bitmap && g_acvr_wide.margin > 0 && g_acvr_wide.width <= int(acvr_mono::max_width) && g_acvr_wide.height <= int(acvr_mono::max_height);
+	}
+	const bitmap_rgb32 &picture() const { return wide_active() ? *g_acvr_wide.bitmap : m_bitmap; }
+
+	// aim across the wide picture -> aim on the 4:3 screen; the added sides are off-screen
+	static void from_wide(acvr_mono::controls &in)
+	{
+		if (!wide_active() || in.off_screen) return;
+		const float total = float(g_acvr_wide.width), inner = total - 2.0f * g_acvr_wide.margin;
+		const float u = (in.u * total - float(g_acvr_wide.margin)) / inner;
+		if (u < 0.0f || u > 1.0f) in.off_screen = 1;
+		else in.u = u;
+	}
+
+	void frame()
+	{
+		if (!m_started)
+			start();
+		if (!m_target)
+			return;
+
+		// render first, outside the lock
+		s32 width = 0, height = 0;
+		if (m_publish || m_script)
+		{
+			m_target->compute_minimum_size(width, height);
+			if (width > s32(acvr_mono::max_width) || height > s32(acvr_mono::max_height))
+			{
+				const float s = std::min(float(acvr_mono::max_width) / width, float(acvr_mono::max_height) / height);
+				width = std::max(1, s32(width * s)); height = std::max(1, s32(height * s));
+			}
+			width = std::max(width, 1); height = std::max(height, 1);
+			m_target->set_bounds(width, height);
+			if (width != m_bitmap.width() || height != m_bitmap.height())
+				m_bitmap.resize(width, height);
+			render_primitive_list &primlist = m_target->get_primitives();
+			primlist.acquire_lock();
+			mono_renderer::draw_primitives(primlist, &m_bitmap.pix(0), width, height, m_bitmap.rowpixels());
+			primlist.release_lock();
+		}
+
+		if (m_script)
+		{
+			script_frame();
+			return;
+		}
+
+		acvr_mono::frame *f = m_shm.try_lock();
+		if (!f)
+			return; // viewer holds the lock: skip this frame, keep the last input
+
+		if (m_gun)
+			for (unsigned i = 0; i < acvr_mono::players; ++i)
+			{
+				acvr_mono::controls in = f->input[i];
+				const bool fresh = acvr_mono::publisher::fresh(in);
+				from_wide(in);
+				apply_gun(i, in, fresh, f->gun[i]);
+				if (i == 0 && !m_motion.empty())
+					apply_motion(f->body.axis, nullptr, acvr_mono::publisher::fresh(f->body));
+				fill_state(i, f->gun[i]);
+			}
+
+		if (m_publish)
+		{
+			const bitmap_rgb32 &pic = picture();
+			const s32 w43 = width;
+			width = pic.width(); height = pic.height();
+			for (s32 y = 0; y < height; ++y)
+				std::memcpy(&f->pixels[y * width], &pic.pix(y), width * 4);
+			f->w = width; f->h = height; f->stride = width;
+			float aspect = float(width) / float(height);
+			if (m_screen)
+			{
+				const auto pa = m_screen->physical_aspect();
+				const bool swap = (orientation_add(container_orientation(), m_target->orientation()) & ORIENTATION_SWAP_XY) != 0;
+				if (pa.first && pa.second)
+					aspect = swap ? float(pa.second) / pa.first : float(pa.first) / pa.second;
+				if (wide_active())
+					aspect *= float(g_acvr_wide.width) / float(g_acvr_wide.width - 2 * g_acvr_wide.margin);
+				(void)w43;
+				f->refresh_hz = float(m_screen->frame_period().as_hz());
+				f->frame_number = m_screen->frame_number();
+			}
+			f->physical_aspect = aspect;
+			f->orientation = orientation_add(container_orientation(), m_target->orientation());
+		}
+		f->emulated_seconds = m_machine.time().as_double();
+		++f->serial;
+		const bool exit = f->exit_request != 0;
+		m_shm.unlock();
+		if (exit)
+			m_machine.schedule_exit();
+	}
+
+	void load_script(const char *path, const char *snapdir)
+	{
+		std::ifstream in(path);
+		if (!in)
+		{
+			osd_printf_error("ACVR script: cannot read %s\n", path);
+			return;
+		}
+		std::string text;
+		while (std::getline(in, text))
+		{
+			if (!text.empty() && text.back() == '\r') text.pop_back();
+			if (text.empty() || text[0] == '#') continue;
+			std::istringstream ss(text);
+			script_line l;
+			if (!(ss >> l.frame >> l.cmd)) continue;
+			for (std::string a; ss >> a; ) l.args.push_back(a);
+			m_lines.push_back(std::move(l));
+		}
+		std::stable_sort(m_lines.begin(), m_lines.end(), [] (const script_line &a, const script_line &b) { return a.frame < b.frame; });
+		m_script = true;
+		m_snapdir = snapdir;
+		m_log = std::fopen((m_snapdir + "/script-log.txt").c_str(), "w");
+		for (unsigned i = 0; i < acvr_mono::players; ++i) { m_sin[i].valid = 1; m_sin[i].u = m_sin[i].v = 0.5f; }
+		osd_printf_info("ACVR script: %u lines from %s, pictures to %s\n", unsigned(m_lines.size()), path, snapdir);
+	}
+
+	static int player_arg(const script_line &l, size_t i)
+	{
+		const int p = i < l.args.size() ? std::atoi(l.args[i].c_str()) : 1;
+		return std::clamp(p, 1, int(acvr_mono::players)) - 1;
+	}
+
+	void run_line(const script_line &l)
+	{
+		const auto arg = [&l] (size_t i) -> std::string { return i < l.args.size() ? l.args[i] : std::string(); };
+		if (l.cmd == "aim" || l.cmd == "aimw")
+		{
+			// aim: u,v on the 4:3 screen; aimw: u,v across the published (possibly wide)
+			// picture, mapped exactly as the viewer's input is
+			const int p = player_arg(l, 0);
+			m_sin[p].u = std::strtof(arg(1).c_str(), nullptr);
+			m_sin[p].v = std::strtof(arg(2).c_str(), nullptr);
+			m_sin[p].off_screen = 0;
+			if (l.cmd == "aimw") from_wide(m_sin[p]);
+		}
+		else if (l.cmd == "axis")
+		{
+			// axis <name> <value>: a body axis as the viewer would send it (sticky)
+			const int a = axis_index(arg(0));
+			if (a >= 0) { m_saxis[a] = std::strtof(arg(1).c_str(), nullptr); m_saxis_set[a] = true; }
+			if (m_log) std::fprintf(m_log, "frame %llu axis %s %s%s\n", (unsigned long long)m_frame_no, arg(0).c_str(), arg(1).c_str(), a < 0 ? " UNKNOWN" : "");
+		}
+		else if (l.cmd == "off")
+			m_sin[player_arg(l, 0)].off_screen = 1;
+		else if (l.cmd == "hold")
+		{
+			const int p = player_arg(l, 0);
+			const std::string which = arg(1);
+			const u64 until = m_frame_no + std::max(1, std::atoi(arg(2).c_str()));
+			const char names[4] = { 'T', 'B', 'S', 'C' };
+			for (int b = 0; b < 4; ++b)
+				if (which.find(names[b]) != std::string::npos)
+					m_until[p][b] = until;
+		}
+		else if (l.cmd == "press")
+		{
+			int player = 0;
+			const ioport_type type = m_machine.ioport().token_to_input_type(arg(0).c_str(), player);
+			ioport_field *found = nullptr;
+			for (auto &port : m_machine.ioport().ports())
+				for (ioport_field &f : port.second->fields())
+					if (!found && f.type() == type && f.player() == player)
+						found = &f;
+			if (found)
+				m_held.push_back({ found, m_frame_no + std::max(1, std::atoi(arg(1).c_str())) });
+			if (m_log) std::fprintf(m_log, "frame %llu press %s -> %s\n", (unsigned long long)m_frame_no, arg(0).c_str(), found ? found->name().c_str() : "NOT FOUND");
+		}
+		else if (l.cmd == "dip")
+		{
+			ioport_port *port = m_machine.root_device().ioport(arg(0));
+			const ioport_value mask = ioport_value(std::strtoul(arg(1).c_str(), nullptr, 16));
+			const ioport_value value = ioport_value(std::strtoul(arg(2).c_str(), nullptr, 16));
+			bool done = false;
+			if (port)
+				for (ioport_field &f : port->fields())
+					if (f.mask() == mask)
+					{
+						ioport_field::user_settings s;
+						f.get_user_settings(s);
+						s.value = value;
+						f.set_user_settings(s);
+						done = true;
+					}
+			if (m_log) std::fprintf(m_log, "frame %llu dip %s %s %s -> %s\n", (unsigned long long)m_frame_no, arg(0).c_str(), arg(1).c_str(), arg(2).c_str(), done ? "set" : "NOT FOUND");
+		}
+		else if (l.cmd == "snap")
+			snap(arg(0));
+		else if (l.cmd == "quit")
+			m_machine.schedule_exit();
+	}
+
+	void snap(const std::string &name)
+	{
+		const bitmap_rgb32 &pic = picture();
+		if (!pic.valid() || name.empty()) return;
+		emu_file file(m_snapdir, OPEN_FLAG_WRITE | OPEN_FLAG_CREATE | OPEN_FLAG_CREATE_PATHS);
+		if (!file.open(name + ".png"))
+			util::png_write_bitmap(file, nullptr, pic, 0, nullptr);
+		if (!m_log) return;
+		std::fprintf(m_log, "frame %llu t %.4f snap %s %dx%d", (unsigned long long)m_frame_no, m_machine.time().as_double(), name.c_str(), pic.width(), pic.height());
+		for (unsigned i = 0; i < acvr_mono::players; ++i)
+		{
+			const acvr_mono::controls &c = m_sin[i];
+			const acvr_mono::gun_state &g = m_sstate[i];
+			std::fprintf(m_log, " | P%u aim %.4f %.4f%s btn %u X set %d read %d Y set %d read %d xhair %.4f %.4f",
+					i + 1, c.u, c.v, c.off_screen ? " OFF" : "", g.buttons, g.x_set, g.x_read, g.y_set, g.y_read, g.cross_u, g.cross_v);
+		}
+		std::fprintf(m_log, "\n");
+		std::fflush(m_log);
+	}
+
+	void script_frame()
+	{
+		++m_frame_no;
+		// releases first, then this frame's commands, then apply
+		m_held.erase(std::remove_if(m_held.begin(), m_held.end(), [this] (const held &h)
+		{
+			if (m_frame_no < h.until) return false;
+			h.field->clear_value();
+			return true;
+		}), m_held.end());
+		std::vector<const script_line *> snaps;
+		while (m_next_line < m_lines.size() && m_lines[m_next_line].frame <= m_frame_no)
+		{
+			const script_line &l = m_lines[m_next_line++];
+			if (l.cmd == "snap") snaps.push_back(&l); else run_line(l);
+		}
+		for (const held &h : m_held)
+			h.field->set_value(1);
+		for (unsigned i = 0; i < acvr_mono::players; ++i)
+		{
+			acvr_mono::controls in = m_sin[i];
+			in.trigger = m_frame_no < m_until[i][0];
+			in.button2 = m_frame_no < m_until[i][1];
+			in.start = m_frame_no < m_until[i][2];
+			in.coin = m_frame_no < m_until[i][3];
+			m_sin[i] = in;
+			apply_gun(i, in, true, m_sstate[i]);
+			fill_state(i, m_sstate[i]);
+		}
+		if (!m_motion.empty())
+			apply_motion(m_saxis, m_saxis_set, true);
+		// the picture rendered this frame shows the state before this frame's input
+		for (const script_line *l : snaps)
+			snap(l->args.empty() ? std::string() : l->args[0]);
+	}
+
+	void exit()
+	{
+		if (m_log)
+		{
+			std::fprintf(m_log, "exit at frame %llu t %.4f\n", (unsigned long long)m_frame_no, m_machine.time().as_double());
+			std::fclose(m_log);
+			m_log = nullptr;
+		}
+		for (gun_fields &g : m_fields)
+			for (ioport_field *f : { g.x, g.y, g.trigger, g.button2, g.start, g.coin })
+				if (f) f->clear_value();
+		for (const held &h : m_held)
+			h.field->clear_value();
+		if (m_target)
+			m_machine.render().target_free(m_target);
+		m_target = nullptr;
+	}
+};
+
+std::unique_ptr<acvr_mono_module> g_module;
+
+} // anonymous namespace
+
+void acvr_mono_start(running_machine &machine)
+{
+	g_module.reset();
+	const char *script = std::getenv("MAME_VR_SCRIPT");
+	const bool scripted = script && *script;
+	const bool publish = env_on("MAME_VR_PUBLISH"), gun = env_on("MAME_VR_GUN");
+	if (!publish && !gun && !scripted)
+		return;
+	const char *cross = std::getenv("MAME_VR_CROSSHAIR");
+	const int crosshair = cross && cross[0] == '1' ? 1 : (cross && cross[0] == '0') || scripted ? 0 : -1;
+	g_module = std::make_unique<acvr_mono_module>(machine, scripted ? false : publish, gun || scripted, crosshair, script, std::getenv("MAME_VR_SNAPDIR"));
+}

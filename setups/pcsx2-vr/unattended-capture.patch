+#include <thread>
+#include <cstdlib>
+#ifdef _WIN32
+#define XR_USE_PLATFORM_WIN32
+#define XR_USE_GRAPHICS_API_OPENGL
+#define XR_NO_PROTOTYPES
+#include "../../3rdparty/openxr/include/openxr/openxr.h"
+#include "../../3rdparty/openxr/include/openxr/openxr_platform.h"
+#endif
+
+namespace PS2Live
+{
+ static bool enabled = false, other = false;
+ static std::unique_ptr<GSRenderer> renderer;
+ static std::unique_ptr<GSTextureCache> cache;
+ static std::array<GSTexture*, 7> scanout{};
+ static std::unique_ptr<GLContext> context;
+ static std::unique_ptr<GLContext> window_context;
+#ifdef _WIN32
+ static HWND presenter_window = nullptr;
+#endif
+ static constexpr u32 CHAIN_WIDTH = 1920, CHAIN_HEIGHT = 1536;
+ static unsigned long long drained_errors = 0, frames_with_layers = 0;
+ static bool swapchain_pair_created = false;
+ static bool fbo_logged[2] = {};
+ static bool using_window_dc = false;
+ static std::mutex mutex;
+ static std::condition_variable ready;
+ static bool proof_pending=false;
+ static std::thread thread;
+ static std::atomic<bool> stop{false};
+ static GLuint eyes[2]{};
+ static GLuint pending[2]{};
+ static u32 pending_width=0, pending_height=0;
+ static u32 width = 0, height = 0;
+ static GLsync fence = nullptr;
+ static unsigned long serial = 0;
+ static unsigned long ticks = 0;
+ static FILE* live_log = nullptr;
+ static float native_width = 640;
+ // Guarded by the publication mutex: the exact eye transforms which rendered
+ // the published pair, rather than the newer poses used for the next pair.
+ static PS2VRInside::Packet published_inside;
+ static float Env(const char* name, float fallback)
+ {
+  const char* value = std::getenv(name);
+  return value ? StringUtil::FromChars<float>(value).value_or(fallback) : fallback;
+ }
+ static void LiveLog(const char* message) { if (live_log) { std::fprintf(live_log, "%s\n", message); std::fflush(live_log); } }
+ // Errors belong to a GL context. Drain at both sides of the boundary so a
+ // stale application error cannot be attributed to the runtime's next GL call.
+ static unsigned DrainGL(const char* phase, const char* operation)
+ {
+  unsigned count=0;
+  for (GLenum error; count<64 && (error=glGetError())!=GL_NO_ERROR; count++)
+  {
+   drained_errors++;
+   if (live_log) { std::fprintf(live_log,"GL error drained %s %s: 0x%04X (total=%llu)\n",phase,operation,error,drained_errors); std::fflush(live_log); }
+  }
+  if (count==64) LiveLog("GL error drain limit reached; context may be lost");
+  return count;
+ }
+ static GSVector2i UsedExtent()
+ {
+  const double scale=std::min({1.0,static_cast<double>(CHAIN_WIDTH)/width,static_cast<double>(CHAIN_HEIGHT)/height});
+  return GSVector2i(std::max(1,static_cast<int>(width*scale)),std::max(1,static_cast<int>(height*scale)));
+ }
+ static bool BlitEye(int eye, GLuint target, GLuint read_fbo, GLuint draw_fbo, const GSVector2i& used)
+ {
+  DrainGL("before","blit attachment setup");
+  glBindFramebuffer(GL_READ_FRAMEBUFFER,read_fbo);
+  glFramebufferTexture2D(GL_READ_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,eyes[eye],0);
+  glReadBuffer(GL_COLOR_ATTACHMENT0);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER,draw_fbo);
+  glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,target,0);
+  glDrawBuffer(GL_COLOR_ATTACHMENT0);

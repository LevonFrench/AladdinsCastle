+      if (!focused) ReleaseGunInput();
+      if (state==XR_SESSION_STATE_READY) { XrSessionBeginInfo bi{XR_TYPE_SESSION_BEGIN_INFO}; bi.primaryViewConfigurationType=XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO; running=Check(XRGL("xrBeginSession", p_xrBeginSession, session,&bi),"xrBeginSession"); }

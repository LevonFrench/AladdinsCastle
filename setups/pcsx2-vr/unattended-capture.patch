+static void PS2StereoOpen(u8* basemem)
+{
+ using namespace PS2Live;
+ if (enabled || GSGetCurrentRenderer()!=GSRendererType::OGL || Env("PCSX2_STEREO",0)==0 || Env("PCSX2_STEREO_LIVE",0)==0) return;
+ cache=std::move(g_texture_cache); renderer=std::move(g_gs_renderer);
+ g_gs_renderer=std::make_unique<GSRendererHW>();
+ g_gs_renderer->SetRegsMem(basemem); g_gs_renderer->ResetPCRTC(); g_gs_renderer->UpdateRenderFixes();
+ std::swap(g_texture_cache,cache); std::swap(g_gs_renderer,renderer);
+ enabled=true; other=false; stop=false; serial=0; ticks=0; proof_pending=false;
+ PS2VRInside::Reset(); PS2VRAim::ResetScene(); published_inside={};
+ drained_errors=frames_with_layers=0; swapchain_pair_created=false; using_window_dc=false; GSDeviceOGL::SetStereoEye(1);
+ g_gs_device->ResetStereoInterlacePhase();
+ live_log=std::fopen("pcsx2-live-stereo.log","w");
+ LiveLog("Live stereo: independent GS RAM, paths, render/depth caches and scanout history per eye");
+#ifdef _WIN32
+  Error error;
+  WindowInfo wi; wi.type=WindowInfo::Type::Surfaceless; wi.surface_width=16; wi.surface_height=16;
+  auto* gl=static_cast<GSDeviceOGL*>(g_gs_device.get())->GetGLContext();
+  context=gl->CreateSharedContext(wi,&error); gl->MakeCurrent();
+  if (Env("PCSX2_OPENXR",0)!=0 || Env("PCSX2_OPENXR_WINDOW_DC",0)!=0)
+  {
+   window_context=CreateWindowContext(gl,&error);
+   if (!window_context) LiveLog("Could not prepare hidden-window DC fallback");
+  }
+  if (Env("PCSX2_OPENXR_WINDOW_DC",0)!=0 && window_context)
+  { context.swap(window_context); using_window_dc=true; }
+  if (context) thread=std::thread(Env("PCSX2_OPENXR",0)!=0 ? ThreadXR : SaveSharedProof);
+  else { LiveLog(error.GetDescription().c_str()); Host::ReportErrorAsync("PCSX2 OpenXR","Could not create shared OpenGL context. See private live live_log."); }
+#endif
+ if (Env("PCSX2_OPENXR",0)==0) LiveLog("OpenXR disabled: loader is not loaded; both GPU textures are still published");
+}
+static void PS2StereoClose()
+{
+ using namespace PS2Live;
+ if (!enabled) return;
+ stop=true;
+ ready.notify_all();
+ if (thread.joinable()) thread.join();
+ context.reset(); window_context.reset();
+#ifdef _WIN32
+ if (presenter_window) { DestroyWindow(presenter_window); presenter_window=nullptr; }
+#endif
+ // Right-eye renderer destruction must occur with its own cache selected.
+ Switch(); g_gs_renderer->Destroy(); g_gs_renderer.reset();
+ g_gs_device->ClearCurrent();
+ Switch();
+ if (fence) { glDeleteSync(fence); fence=nullptr; }
+ glDeleteTextures(2,eyes); glDeleteTextures(2,pending);
+ eyes[0]=eyes[1]=pending[0]=pending[1]=0; width=height=pending_width=pending_height=0;
+ enabled=false; other=false;
+ PS2VRGun::Publish({});
+ LiveLog("Live stereo closed"); if (live_log) { std::fclose(live_log); live_log=nullptr; }
+}
+void PS2StereoScanout()
+{
+ using namespace PS2Live;
+ if (!enabled) return;
+ GSTexture* src=g_gs_device->GetCurrent(); if (!src) return;
+ std::unique_lock guard(mutex);
+ const u32 w=src->GetWidth(), h=src->GetHeight();
+ if (pending_width!=w || pending_height!=h)
+ {
+  glDeleteTextures(2,pending); glCreateTextures(GL_TEXTURE_2D,2,pending);
+  for (GLuint eye:pending) glTextureStorage2D(eye,1,GL_RGBA8,w,h);
+  pending_width=w; pending_height=h;
+ }
+ glCopyImageSubData(static_cast<GSTextureOGL*>(src)->GetID(),GL_TEXTURE_2D,0,0,0,0,pending[other?1:0],GL_TEXTURE_2D,0,0,0,0,w,h,1);
+ if (other) return;
+ if (width!=w || height!=h)
+ {
+  glDeleteTextures(2,eyes); glCreateTextures(GL_TEXTURE_2D,2,eyes);
+  for (GLuint eye:eyes) glTextureStorage2D(eye,1,GL_RGBA8,w,h);
+  width=w; height=h;
+ }
+ for (int eye=0; eye<2; eye++) glCopyImageSubData(pending[eye],GL_TEXTURE_2D,0,0,0,0,eyes[eye],GL_TEXTURE_2D,0,0,0,0,w,h,1);
+ native_width=static_cast<float>(w)/GSConfig.UpscaleMultiplier;
+ published_inside=PS2VRInside::Get();
+ if(PS2VRInside::Enabled() && PS2VRGun::Enabled())PS2VRAim::PublishScene();
+ if (fence) glDeleteSync(fence);
+ fence=glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE,0); glFlush(); serial++;
+ if (serial==1 || serial%600==0)
+ {
+  if (live_log) { std::fprintf(live_log,"Published pair %lu (GS tick %lu): textures %u/%u, %ux%u, upscale %.1fx, speed %.2f%%\n",serial,ticks,eyes[0],eyes[1],w,h,GSConfig.UpscaleMultiplier,PerformanceMetrics::GetSpeed()); std::fflush(live_log); }
+ }
+ const char* save_frame=std::getenv("PCSX2_LIVE_SAVE_FRAME");
+ if (save_frame && ticks==std::strtoul(save_frame,nullptr,10))
+ {
+  if (const char* path=std::getenv("PCSX2_LIVE_SAVE_PATH"))
+  {
+   std::vector<u32> pixels[2];
+   for (int eye=0; eye<2; eye++)
+   {
+    pixels[eye].resize(static_cast<size_t>(w)*h);
+    glGetTextureImage(eyes[eye],0,GL_RGBA,GL_UNSIGNED_BYTE,static_cast<GLsizei>(pixels[eye].size()*4),pixels[eye].data());
+    RGBA8Image image(w,h,pixels[eye]); image.SaveToFile(fmt::format("{}-{}.png",path,eye ? "right" : "left").c_str());
+   }
+   std::vector<u32> pair(static_cast<size_t>(w)*h*2);
+   for (u32 y=0; y<h; y++) for (int eye=0; eye<2; eye++) std::copy_n(pixels[eye].data()+static_cast<size_t>(y)*w,w,pair.data()+static_cast<size_t>(y)*w*2+eye*w);
+   RGBA8Image image(w*2,h,std::move(pair)); image.SaveToFile(fmt::format("{}-sbs.png",path).c_str());
+   LiveLog("Saved both published GPU textures and exact row-joined SBS");
+   if (live_log && PS2VRInside::Enabled()) { std::fprintf(live_log,"Inside pair proof: valid=%d pose_sequence=%llu predicted_time=%lld fake_yaw_deg=%.3f\n",published_inside.valid,static_cast<unsigned long long>(published_inside.sequence),static_cast<long long>(published_inside.predicted_display_time),Env("PCSX2_INSIDE_FAKE_YAW_DEG",0)); std::fflush(live_log); }
+   if (Env("PCSX2_OPENXR",0)==0 && context)
+   {
+    proof_pending=true; ready.notify_all();
+    if (!ready.wait_for(guard,std::chrono::seconds(5),[]() { return !proof_pending; }))
+     LiveLog("Shared-thread readback timed out");
+   }
+  }
+ }
+}
diff --git a/pcsx2/GS/PS2VRAim.h b/pcsx2/GS/PS2VRAim.h
new file mode 100644
--- /dev/null
+++ b/pcsx2/GS/PS2VRAim.h
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-3.0+
+#pragma once
+#include <cmath>
+#include <array>
+#include <vector>
+#include <memory>
+#include <mutex>
+#include <chrono>
+namespace PS2VRAim
+{
+struct V { float x=0,y=0,z=0; V operator+(V b)const{return {x+b.x,y+b.y,z+b.z};} V operator-(V b)const{return {x-b.x,y-b.y,z-b.z};} V operator*(float s)const{return{x*s,y*s,z*s};} };
+struct Q { float x=0,y=0,z=0,w=1; };
+inline float Dot(V a,V b){return a.x*b.x+a.y*b.y+a.z*b.z;}
+inline V Cross(V a,V b){return{a.y*b.z-a.z*b.y,a.z*b.x-a.x*b.z,a.x*b.y-a.y*b.x};}
+inline V Rotate(Q q,V p){V v{q.x,q.y,q.z}; return p+Cross(v,Cross(v,p)+p*q.w)*2;}
+struct Hit {float u=-1,v=-1; bool on_screen=false;};
+// Quad +Z faces the viewer; the tracked aim pose points down its local -Z.
+// Work in quad-local metres. No visual gun/recoil transform enters this path.
+inline Hit Intersect(V origin,V direction,V center,Q rotation,float width,float height)
+{
+ if (!(width>0 && height>0)) return {};
+ Q inverse{-rotation.x,-rotation.y,-rotation.z,rotation.w};
+ V o=Rotate(inverse,origin-center),d=Rotate(inverse,direction);
+ if (!std::isfinite(o.x+o.y+o.z+d.x+d.y+d.z) || d.z>=-1e-6f) return {};
+ float t=-o.z/d.z;
+ if (t<=0 || !std::isfinite(t)) return {};
+ V p=o+d*t;
+ Hit hit{p.x/width+.5f,.5f-p.y/height,false};
+ hit.on_screen=hit.u>=0 && hit.u<=1 && hit.v>=0 && hit.v<=1;
+ return hit;
+}
+// Immutable per-frame original-camera geometry. The GS thread owns staging;
+// input/presenter readers retain snapshots without blocking it during ray tests.
+struct Triangle { V a,b,c; };
+inline std::vector<Triangle> scene_staging;
+inline std::mutex scene_mutex;
+inline std::shared_ptr<const std::vector<Triangle>> scene_triangles;
+inline std::chrono::steady_clock::time_point scene_time;
+inline void AddTriangle(Triangle t) {
+ if(scene_staging.size()<32768 && std::isfinite(t.a.x+t.a.y+t.a.z+t.b.x+t.b.y+t.b.z+t.c.x+t.c.y+t.c.z))scene_staging.push_back(t);
+}
+inline void PublishScene() {
+ auto frame=std::make_shared<const std::vector<Triangle>>(std::move(scene_staging));
+ std::lock_guard lock(scene_mutex);scene_triangles=std::move(frame);scene_time=std::chrono::steady_clock::now();
+ scene_staging={};
+}
+inline void ResetScene() { scene_staging.clear();std::lock_guard lock(scene_mutex);scene_triangles.reset();scene_time={}; }
+struct Camera { float width=640,height=448,fx=320,fy=298.666667f; };
+struct SceneHit { Hit picture;V point;bool geometry=false;float distance=0;unsigned triangles=0; };
+inline SceneHit Inside(V origin,V direction,Camera camera,float fallback=100.f) {
+ SceneHit result;
+ const float length=std::sqrt(Dot(direction,direction));
+ if(!(length>1e-6f) || !std::isfinite(length) || !(camera.width>0&&camera.height>0&&camera.fx>0&&camera.fy>0&&fallback>.01f))return result;
+ direction=direction*(1/length);float nearest=fallback;
+ std::shared_ptr<const std::vector<Triangle>> triangles;
+ {std::lock_guard lock(scene_mutex);if(std::chrono::steady_clock::now()-scene_time<std::chrono::milliseconds(500))triangles=scene_triangles;}
+ if(triangles) {
+  result.triangles=static_cast<unsigned>(triangles->size());
+  for(const auto& triangle:*triangles) {
+   const V e1=triangle.b-triangle.a,e2=triangle.c-triangle.a,p=Cross(direction,e2);
+   const float det=Dot(e1,p);if(std::abs(det)<1e-8f)continue;
+   const float inverse=1/det;const V offset=origin-triangle.a;
+   const float u=Dot(offset,p)*inverse;if(u<0||u>1)continue;
+   const V q=Cross(offset,e1);const float v=Dot(direction,q)*inverse;if(v<0||u+v>1)continue;
+   const float distance=Dot(e2,q)*inverse;
+   if(distance>.01f&&distance<nearest){nearest=distance;result.geometry=true;}
+  }
+ }
+ result.point=origin+direction*nearest;result.distance=nearest;
+ if(!std::isfinite(result.point.x+result.point.y+result.point.z)||result.point.z>=-.001f)return result;
+ result.picture={.5f+camera.fx*result.point.x/(-result.point.z)/camera.width,.5f-camera.fy*result.point.y/(-result.point.z)/camera.height,false};
+ auto& h=result.picture;h.on_screen=std::isfinite(h.u+h.v)&&h.u>=0&&h.u<=1&&h.v>=0&&h.v<=1;
+ return result;
+}
+}
diff --git a/pcsx2/GS/PS2VRControllers.h b/pcsx2/GS/PS2VRControllers.h
new file mode 100644
--- /dev/null
+++ b/pcsx2/GS/PS2VRControllers.h
@@ -0,0 +1,320 @@
+// SPDX-License-Identifier: GPL-3.0+
+// Included inside PS2Live after the runtime function table. Presenter-thread only.
+static XrActionSet gun_actions=XR_NULL_HANDLE;
+static XrAction gun_aim=XR_NULL_HANDLE,gun_grip_pose=XR_NULL_HANDLE,gun_trigger=XR_NULL_HANDLE;
+static XrAction gun_a=XR_NULL_HANDLE,gun_b=XR_NULL_HANDLE,gun_squeeze=XR_NULL_HANDLE,gun_haptic=XR_NULL_HANDLE;
+static XrPath right_hand=XR_NULL_PATH,left_hand=XR_NULL_PATH;
+static XrAction menu_select=XR_NULL_HANDLE,menu_start=XR_NULL_HANDLE,menu_spare_start=XR_NULL_HANDLE;
+static XrSpace aim_space=XR_NULL_HANDLE,grip_space=XR_NULL_HANDLE;
+static bool gun_attached=false,grip_valid=false;
+static XrPosef grip_pose{},aim_pose{};
+static uint64_t seen_shot=0;
+static auto recoil_start=std::chrono::steady_clock::time_point{};
+static PS2VRGun::Renderer gun_model;
+static XrPath Path(const char* name)
+{
+ XrPath p=XR_NULL_PATH;
+ Check(XRGL("xrStringToPath",p_xrStringToPath,instance,name,&p),name);
+ return p;
+}
+static bool InitGunActions()
+{
+ gun_attached=false; seen_shot=PS2VRGun::ShotSerial();
+ XrActionSetCreateInfo ci{XR_TYPE_ACTION_SET_CREATE_INFO};
+ std::strcpy(ci.actionSetName,"ps2_controls"); std::strcpy(ci.localizedActionSetName,"PS2 Controls");
+ if (!Check(XRGL("xrCreateActionSet",p_xrCreateActionSet,instance,&ci,&gun_actions),"gun action set")) return false;
+ right_hand=Path("/user/hand/right"); left_hand=Path("/user/hand/left"); if (!right_hand || !left_hand) return false;
+ const auto action=[](const char* name,const char* label,XrActionType type,XrAction& handle,XrPath hand=XR_NULL_PATH)
+ {
+  XrActionCreateInfo info{XR_TYPE_ACTION_CREATE_INFO}; std::strcpy(info.actionName,name); std::strcpy(info.localizedActionName,label);
+  info.actionType=type; info.countSubactionPaths=1; info.subactionPaths=hand ? &hand : &right_hand;
+  return Check(XRGL("xrCreateAction",p_xrCreateAction,gun_actions,&info,&handle),name);
+ };
+ if (!action("menu_select","Select",XR_ACTION_TYPE_BOOLEAN_INPUT,menu_select,left_hand) ||
+     !action("menu_start","Start",XR_ACTION_TYPE_BOOLEAN_INPUT,menu_start,right_hand) ||
+     !action("menu_spare_start","Spare Start",XR_ACTION_TYPE_BOOLEAN_INPUT,menu_spare_start,left_hand)) return false;
+ if (!action("aim","Aim",XR_ACTION_TYPE_POSE_INPUT,gun_aim) ||
+     !action("grip_pose","Grip pose",XR_ACTION_TYPE_POSE_INPUT,gun_grip_pose) ||
+     !action("trigger","Trigger",XR_ACTION_TYPE_FLOAT_INPUT,gun_trigger) ||
+     !action("button_a","GunCon A",XR_ACTION_TYPE_BOOLEAN_INPUT,gun_a) ||
+     !action("button_b","GunCon B",XR_ACTION_TYPE_BOOLEAN_INPUT,gun_b) ||
+     !action("squeeze","Grip",XR_ACTION_TYPE_FLOAT_INPUT,gun_squeeze) ||
+     !action("haptic","Shot pulse",XR_ACTION_TYPE_VIBRATION_OUTPUT,gun_haptic)) return false;
+ for (const char* profile:{"/interaction_profiles/oculus/touch_controller","/interaction_profiles/valve/index_controller"})
+ {
+  std::vector<XrActionSuggestedBinding> bindings={
+   {gun_aim,Path("/user/hand/right/input/aim/pose")},
+   {gun_grip_pose,Path("/user/hand/right/input/grip/pose")},
+   {gun_trigger,Path("/user/hand/right/input/trigger/value")},
+   {gun_a,Path("/user/hand/right/input/a/click")},
+   {gun_b,Path("/user/hand/right/input/b/click")},
+   {gun_squeeze,Path("/user/hand/right/input/squeeze/value")},
+   {gun_haptic,Path("/user/hand/right/output/haptic")}};
+  bindings.push_back({menu_select,Path("/user/hand/left/input/thumbstick/click")});
+  bindings.push_back({menu_start,Path("/user/hand/right/input/thumbstick/click")});
+  // Index reserves the system button; left B is its exposed spare Start.
+  bindings.push_back({menu_spare_start,Path(std::strcmp(profile,"/interaction_profiles/valve/index_controller")==0 ? "/user/hand/left/input/b/click" : "/user/hand/left/input/menu/click")});
+  XrInteractionProfileSuggestedBinding suggested{XR_TYPE_INTERACTION_PROFILE_SUGGESTED_BINDING};
+  suggested.interactionProfile=Path(profile); suggested.countSuggestedBindings=std::size(bindings); suggested.suggestedBindings=bindings.data();
+  if (!Check(XRGL("xrSuggestInteractionProfileBindings",p_xrSuggestInteractionProfileBindings,instance,&suggested),profile)) return false;
+ }
+ XrSessionActionSetsAttachInfo attach{XR_TYPE_SESSION_ACTION_SETS_ATTACH_INFO}; attach.countActionSets=1; attach.actionSets=&gun_actions;
+ if (!Check(XRGL("xrAttachSessionActionSets",p_xrAttachSessionActionSets,session,&attach),"attach gun actions")) return false;
+ XrActionSpaceCreateInfo asi{XR_TYPE_ACTION_SPACE_CREATE_INFO}; asi.subactionPath=right_hand; asi.poseInActionSpace.orientation.w=1;
+ asi.action=gun_aim; if (!Check(XRGL("xrCreateActionSpace",p_xrCreateActionSpace,session,&asi,&aim_space),"aim action space")) return false;
+ asi.action=gun_grip_pose; if (!Check(XRGL("xrCreateActionSpace",p_xrCreateActionSpace,session,&asi,&grip_space),"grip action space")) return false;
+ gun_attached=true;
+ LiveLog("PS2 Controls attached: L-stick Select, R-stick Start, Touch L-menu / Index L-B spare Start; right gun trigger/A/B/grip-C; focus required, menus independent of aim tracking");
+ return true;
+}
+static void ReleaseGunInput()
+{
+ PS2VRGun::Publish({}); grip_valid=false; seen_shot=PS2VRGun::ShotSerial();
+}
+static void DestroyGunActions()
+{
+ ReleaseGunInput();
+ if (gun_attached && session)
+ {
+  XrHapticActionInfo hi{XR_TYPE_HAPTIC_ACTION_INFO}; hi.action=gun_haptic; hi.subactionPath=right_hand;
+  XRGL("xrStopHapticFeedback",p_xrStopHapticFeedback,session,&hi);
+ }
+ if (aim_space) XRGL("xrDestroySpace",p_xrDestroySpace,aim_space);
+ if (grip_space) XRGL("xrDestroySpace",p_xrDestroySpace,grip_space);
+ aim_space=grip_space=XR_NULL_HANDLE; gun_attached=false;
+}
+static void PollGunActions(XrTime time,bool focused,const XrPosef& screen,float sw,float sh,bool gun_tracking_allowed)
+{
+ if (!gun_attached || !focused) { ReleaseGunInput(); return; }
+ XrActiveActionSet active{gun_actions,XR_NULL_PATH};
+ XrActionsSyncInfo sync{XR_TYPE_ACTIONS_SYNC_INFO}; sync.countActiveActionSets=1; sync.activeActionSets=&active;
+ if (XRGL("xrSyncActions",p_xrSyncActions,session,&sync)!=XR_SUCCESS) { ReleaseGunInput(); return; }
+ auto scalar=[](XrAction action)
+ {
+  XrActionStateGetInfo gi{XR_TYPE_ACTION_STATE_GET_INFO}; gi.action=action; gi.subactionPath=right_hand;
+  XrActionStateFloat state{XR_TYPE_ACTION_STATE_FLOAT};
+  return XR_SUCCEEDED(XRGL("xrGetActionStateFloat",p_xrGetActionStateFloat,session,&gi,&state)) && state.isActive ? state.currentState : 0.f;
+ };
+ auto button=[](XrAction action,XrPath hand)
+ {
+  XrActionStateGetInfo gi{XR_TYPE_ACTION_STATE_GET_INFO}; gi.action=action; gi.subactionPath=hand;
+  XrActionStateBoolean state{XR_TYPE_ACTION_STATE_BOOLEAN};
+  return XR_SUCCEEDED(XRGL("xrGetActionStateBoolean",p_xrGetActionStateBoolean,session,&gi,&state)) && state.isActive && state.currentState;
+ };
+ PS2VRGun::Sample sample;
+ sample.controls_active=PS2VRGun::MenuEnabled();
+ sample.select=button(menu_select,left_hand); sample.start=button(menu_start,right_hand); sample.spare_start=button(menu_spare_start,left_hand);
+ auto pose_active=[](XrAction action)
+ {
+  XrActionStateGetInfo gi{XR_TYPE_ACTION_STATE_GET_INFO}; gi.action=action; gi.subactionPath=right_hand;
+  XrActionStatePose state{XR_TYPE_ACTION_STATE_POSE};
+  return XR_SUCCEEDED(XRGL("xrGetActionStatePose",p_xrGetActionStatePose,session,&gi,&state)) && state.isActive;
+ };
+ XrSpaceLocation loc{XR_TYPE_SPACE_LOCATION};
+ constexpr XrSpaceLocationFlags valid=XR_SPACE_LOCATION_POSITION_VALID_BIT|XR_SPACE_LOCATION_ORIENTATION_VALID_BIT|XR_SPACE_LOCATION_POSITION_TRACKED_BIT|XR_SPACE_LOCATION_ORIENTATION_TRACKED_BIT;
+ if (!PS2VRGun::Enabled() || !gun_tracking_allowed || !pose_active(gun_aim) || XR_FAILED(XRGL("xrLocateSpace",p_xrLocateSpace,aim_space,space,time,&loc)) || (loc.locationFlags&valid)!=valid)
+ { PS2VRGun::Publish(sample); grip_valid=false; seen_shot=PS2VRGun::ShotSerial(); return; }
+ aim_pose=loc.pose;
+ const auto& p=loc.pose.position; const auto& q=loc.pose.orientation;
+ const auto& sp=screen.position; const auto& sq=screen.orientation;
+ const auto ray=PS2VRAim::Rotate({q.x,q.y,q.z,q.w},{0,0,-1});
+ const auto hit=PS2VRAim::Intersect({p.x,p.y,p.z},ray,{sp.x,sp.y,sp.z},{sq.x,sq.y,sq.z,sq.w},sw,sh);
+ sample.active=true; sample.on_screen=hit.on_screen;
+ sample.u=hit.u; sample.v=hit.v; sample.trigger=std::clamp(scalar(gun_trigger),0.f,1.f);
+ if(PS2VRInside::Enabled()) {
+  const auto inverse=inside_origin.RigidInverse();
+  const float o[4]={p.x,p.y,p.z,1},d[4]={ray.x,ray.y,ray.z,0};
+  float local_o[3]{},local_d[3]{};
+  for(int row=0;row<3;row++)for(int col=0;col<4;col++){local_o[row]+=inverse.m[col*4+row]*o[col];local_d[row]+=inverse.m[col*4+row]*d[col];}
+  const float cw=Env("PCSX2_INSIDE_CANVAS_WIDTH",640),ch=Env("PCSX2_INSIDE_CANVAS_HEIGHT",448);
+  const float fx=Env("PCSX2_STEREO_FOCAL_PX",320),fy=Env("PCSX2_INSIDE_FY",fx*ch/(cw*.75f));
+  const auto scene=PS2VRAim::Inside({local_o[0],local_o[1],local_o[2]},{local_d[0],local_d[1],local_d[2]},{cw,ch,fx,fy});
+  sample.u=scene.picture.u;sample.v=scene.picture.v;sample.on_screen=scene.picture.on_screen;
+  sample.scene_point=scene.point;sample.scene_point_valid=std::isfinite(scene.point.x+scene.point.y+scene.point.z)&&scene.point.z<-.001f;sample.scene_hit=scene.geometry;
+ }
+
+ sample.a=button(gun_a,right_hand); sample.b=button(gun_b,right_hand); sample.grip=scalar(gun_squeeze)>.5f;
+ PS2VRGun::Publish(sample);
+ loc={XR_TYPE_SPACE_LOCATION};
+ grip_valid=pose_active(gun_grip_pose) && XR_SUCCEEDED(XRGL("xrLocateSpace",p_xrLocateSpace,grip_space,space,time,&loc)) && (loc.locationFlags&valid)==valid;
+ if (grip_valid) grip_pose=loc.pose;
+ const uint64_t shot=PS2VRGun::ShotSerial();
+ if (shot!=seen_shot)
+ {
+  seen_shot=shot; recoil_start=std::chrono::steady_clock::now();
+  XrHapticActionInfo hi{XR_TYPE_HAPTIC_ACTION_INFO}; hi.action=gun_haptic; hi.subactionPath=right_hand;
+  XrHapticVibration vibration{XR_TYPE_HAPTIC_VIBRATION}; vibration.duration=35000000; vibration.frequency=XR_FREQUENCY_UNSPECIFIED; vibration.amplitude=1.f;
+  if (Check(XRGL("xrApplyHapticFeedback",p_xrApplyHapticFeedback,session,&hi,reinterpret_cast<const XrHapticBaseHeader*>(&vibration)),"shot haptic") && live_log)
+  { std::fprintf(live_log,"Delivered GunCon shot %llu: 35ms haptic and visual recoil\n",static_cast<unsigned long long>(shot)); std::fflush(live_log); }
+ }
+}
+// The reticle is drawn LAST into the controller projection, never into the
+// opaque game swapchain. Both modes therefore use the same final alpha layer.
+static bool AimDotPosition(const PS2VRGun::Sample& sample,const PS2VRGun::Mat4& projection,
+ const PS2VRGun::Mat4& view_matrix,const PS2VRGun::Mat4& screen,float sw,float sh,float& u,float& v)
+{
+ if (!sample.active || !sample.on_screen) return false;
+ float point[4]={(sample.u-.5f)*sw,(.5f-sample.v)*sh,0,1};
+ auto origin=screen;
+ if (PS2VRInside::Enabled()) {
+  const float distance=Env("PCSX2_INSIDE_HUD_DISTANCE_M",2.5f);
+  const float cw=Env("PCSX2_INSIDE_CANVAS_WIDTH",640),ch=Env("PCSX2_INSIDE_CANVAS_HEIGHT",448);
+  const float fx=Env("PCSX2_STEREO_FOCAL_PX",320),fy=Env("PCSX2_INSIDE_FY",fx*ch/(cw*.75f));
+  point[0]=(sample.u-.5f)*cw/fx*distance;point[1]=(.5f-sample.v)*ch/fy*distance;point[2]=-distance;
+  if(sample.scene_point_valid) {point[0]=sample.scene_point.x;point[1]=sample.scene_point.y;point[2]=sample.scene_point.z;}
+  origin=inside_origin;
+ }
+ const auto transform=projection*view_matrix*origin;
+ float clip[4]{};for(int row=0;row<4;row++)for(int col=0;col<4;col++)clip[row]+=transform.m[col*4+row]*point[col];
+ if (!(clip[3]>.001f)) return false;
+ u=(clip[0]/clip[3]+1)*.5f;v=(clip[1]/clip[3]+1)*.5f;
+ return std::isfinite(u)&&std::isfinite(v)&&u>=0&&u<1&&v>=0&&v<1;
+}
+static void DrawAimDot(int width,int height,float u,float v)
+{
+ const int radius=std::max(2,width/500);
+ const int x=static_cast<int>(u*width),y=static_cast<int>(v*height);
+ const int left=std::max(0,x-radius),bottom=std::max(0,y-radius);
+ const int right=std::min(width,x+radius+1),top=std::min(height,y+radius+1);
+ glDisable(GL_DEPTH_TEST);glDisable(GL_FRAMEBUFFER_SRGB);glEnable(GL_SCISSOR_TEST);
+ glScissor(left,bottom,right-left,top-bottom);glColorMask(GL_TRUE,GL_TRUE,GL_TRUE,GL_TRUE);
+ glClearColor(1,.15f,.05f,1);glClear(GL_COLOR_BUFFER_BIT);glDisable(GL_SCISSOR_TEST);
+}
+static bool RenderControllerOverlay(PS2VRGun::Renderer& model,GLuint fbo,int width,int height,
+ const PS2VRGun::Mat4& projection,const PS2VRGun::Mat4& view_matrix,
+ const PS2VRGun::Mat4& grip,const PS2VRGun::Mat4& aim,float trigger,float recoil,bool show_model,
+ bool dot,float u,float v,std::string& error)
+{
+ // Clear even when only the dot is requested, with no inherited color/scissor
+ // mask. Every pixel outside the current model/dot is transparent every frame.
+ glBindFramebuffer(GL_FRAMEBUFFER,fbo);glDrawBuffer(GL_COLOR_ATTACHMENT0);
+ glDisable(GL_SCISSOR_TEST);glDisable(GL_RASTERIZER_DISCARD);glColorMask(GL_TRUE,GL_TRUE,GL_TRUE,GL_TRUE);
+ glClearColor(0,0,0,0);glClear(GL_COLOR_BUFFER_BIT);
+ if(show_model && !model.Draw(fbo,width,height,projection,view_matrix,grip,aim,trigger,recoil,error))return false;
+ if(dot)DrawAimDot(width,height,u,v);
+ return true;
+}
+// Gun projection graphics follow below. The model never changes the aim space.
+
+static XrSwapchain gun_chains[2]{};
+static std::vector<XrSwapchainImageOpenGLKHR> gun_images[2];
+static GLuint gun_fbo=0;
+static bool gun_graphics_attempted=false,gun_graphics_ready=false;
+static constexpr int GUN_RES=1024;
+static void DestroyGunGraphics()
+{
+ gun_model.Shutdown();
+ if (gun_fbo) glDeleteFramebuffers(1,&gun_fbo); gun_fbo=0;
+ for (int eye=0;eye<2;eye++) { if (gun_chains[eye]) XRGL("xrDestroySwapchain",p_xrDestroySwapchain,gun_chains[eye]); gun_chains[eye]=XR_NULL_HANDLE; gun_images[eye].clear(); }
+ gun_graphics_attempted=gun_graphics_ready=false;
+ DrainGL("after","gun graphics cleanup");
+}
+static bool InitGunGraphics()
+{
+ if (gun_graphics_attempted) return gun_graphics_ready;
+ gun_graphics_attempted=true;
+ std::string error;
+ DrainGL("before","gun model initialization");
+ if (!gun_model.Init(error)) { LiveLog(("Gun model load failed: "+error).c_str()); return false; }
+ for (int eye=0;eye<2;eye++)
+ {
+  XrSwapchainCreateInfo ci{XR_TYPE_SWAPCHAIN_CREATE_INFO}; ci.usageFlags=XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT;
+  ci.format=format; ci.sampleCount=1; ci.width=ci.height=GUN_RES; ci.faceCount=ci.arraySize=ci.mipCount=1;
+  if (!Check(XRGL("xrCreateSwapchain",p_xrCreateSwapchain,session,&ci,&gun_chains[eye]),"gun swapchain")) return false;
+  u32 count=0;
+  if (!Check(XRGL("xrEnumerateSwapchainImages",p_xrEnumerateSwapchainImages,gun_chains[eye],0,&count,nullptr),"gun images") || !count) return false;
+  gun_images[eye].resize(count,{XR_TYPE_SWAPCHAIN_IMAGE_OPENGL_KHR});
+  if (!Check(XRGL("xrEnumerateSwapchainImages",p_xrEnumerateSwapchainImages,gun_chains[eye],count,&count,reinterpret_cast<XrSwapchainImageBaseHeader*>(gun_images[eye].data())),"gun images")) return false;
+ }
+ glGenFramebuffers(1,&gun_fbo); gun_graphics_ready=true;
+ LiveLog("Gun projection layer ready: GLB grip/muzzle anchors, TOML trigger + LOD, two 1024 targets");
+ return true;
+}
+static bool DrawTrackedGun(XrTime time,const XrPosef& screen_pose,float sw,float sh,XrCompositionLayerProjection& layer,XrCompositionLayerProjectionView* projections)
+{
+ if (!PS2VRGun::Enabled() || !gun_attached) return false;
+ const bool show_model=grip_valid && Env("PCSX2_VR_GUN_SHOW_MODEL",1)!=0;
+ const auto sample=PS2VRGun::Snapshot();
+ const bool show_dot=Env("PCSX2_VR_GUN_DOT",1)!=0 && sample.active && sample.on_screen;
+ if ((!show_model && !show_dot) || !InitGunGraphics()) return false;
+ XrViewLocateInfo vi{XR_TYPE_VIEW_LOCATE_INFO}; vi.viewConfigurationType=XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO; vi.displayTime=time; vi.space=space;
+ XrViewState state{XR_TYPE_VIEW_STATE}; XrView views[2]{{XR_TYPE_VIEW},{XR_TYPE_VIEW}}; u32 count=0;
+ const auto valid=XR_VIEW_STATE_POSITION_VALID_BIT|XR_VIEW_STATE_ORIENTATION_VALID_BIT;
+ if (!Check(XRGL("xrLocateViews",p_xrLocateViews,session,&vi,&state,2,&count,views),"gun eye poses") || count!=2 || (state.viewStateFlags&valid)!=valid) return false;
+ const auto grip=grip_valid ? PS2VRGun::Mat4::FromPose(&grip_pose.position.x,&grip_pose.orientation.x) : PS2VRGun::Mat4::Identity();
+ const float recoil=recoil_start.time_since_epoch().count() ? std::chrono::duration<float>(std::chrono::steady_clock::now()-recoil_start).count() : -1;
+ bool pair=true;
+ for (int eye=0;eye<2;eye++)
+ {
+  u32 index=0; XrSwapchainImageAcquireInfo ai{XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO};
+  if (!Check(XRGL("xrAcquireSwapchainImage",p_xrAcquireSwapchainImage,gun_chains[eye],&ai,&index),"acquire gun image")) { pair=false; break; }
+  XrSwapchainImageWaitInfo wi{XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO}; wi.timeout=1000000000;
+  const XrResult waited=XRGL("xrWaitSwapchainImage",p_xrWaitSwapchainImage,gun_chains[eye],&wi);
+  if (waited!=XR_SUCCESS) { Check(waited,"wait gun image"); stop=true; pair=false; break; }
+  const auto& v=views[eye];
+  const auto projection=PS2VRGun::Mat4::Projection(std::tan(v.fov.angleLeft),std::tan(v.fov.angleRight),std::tan(v.fov.angleDown),std::tan(v.fov.angleUp));
+  const auto view_matrix=PS2VRGun::Mat4::FromPose(&v.pose.position.x,&v.pose.orientation.x).RigidInverse();
+  glBindFramebuffer(GL_FRAMEBUFFER,gun_fbo); glFramebufferTexture2D(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,gun_images[eye][index].image,0);
+  std::string error;
+  DrainGL("before","gun render");
+  const auto aim=PS2VRGun::Mat4::FromPose(&aim_pose.position.x,&aim_pose.orientation.x);
+  const auto screen=PS2VRGun::Mat4::FromPose(&screen_pose.position.x,&screen_pose.orientation.x);
+  float dot_u=0,dot_v=0;const bool dot=show_dot && AimDotPosition(sample,projection,view_matrix,screen,sw,sh,dot_u,dot_v);
+  bool drawn=RenderControllerOverlay(gun_model,gun_fbo,GUN_RES,GUN_RES,projection,view_matrix,grip,aim,sample.trigger,recoil,show_model,dot,dot_u,dot_v,error);
+  glFinish(); if (DrainGL("after","gun render / completion")) drawn=false;
+  glDisable(GL_DEPTH_TEST); glDisable(GL_SCISSOR_TEST); glDisable(GL_FRAMEBUFFER_SRGB);
+  XrSwapchainImageReleaseInfo ri{XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+  const bool released=Check(XRGL("xrReleaseSwapchainImage",p_xrReleaseSwapchainImage,gun_chains[eye],&ri),"release gun image");
+  if (!drawn || !released) { LiveLog(("Gun frame failed: "+error).c_str()); pair=false; break; }
+  projections[eye]={XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW}; projections[eye].pose=v.pose; projections[eye].fov=v.fov;
+  projections[eye].subImage.swapchain=gun_chains[eye]; projections[eye].subImage.imageRect.extent={GUN_RES,GUN_RES};
+ }
+ layer={XR_TYPE_COMPOSITION_LAYER_PROJECTION};
+ layer.space=space;
+ layer.layerFlags=XR_COMPOSITION_LAYER_BLEND_TEXTURE_SOURCE_ALPHA_BIT|XR_COMPOSITION_LAYER_UNPREMULTIPLIED_ALPHA_BIT;
+ layer.viewCount=2; layer.views=projections;
+ return pair;
+}
+
+// No loader/session calls: exercise the SAME overlay renderer and composition
+// builder with a deterministic controller pose in the live shared GL context.
+static void SaveOverlayProof()
+{
+ const char* prefix=std::getenv("PCSX2_VR_LAYER_PROOF");if(!prefix)return;
+ PS2VRGun::Renderer model;std::string error;
+ if(!model.Init(error)){LiveLog(("Overlay proof model init failed: "+error).c_str());return;}
+ GLuint fbo=0,tex=0;glGenFramebuffers(1,&fbo);glCreateTextures(GL_TEXTURE_2D,1,&tex);
+ glTextureStorage2D(tex,1,GL_SRGB8_ALPHA8,GUN_RES,GUN_RES);glBindFramebuffer(GL_FRAMEBUFFER,fbo);
+ glFramebufferTexture2D(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,tex,0);
+ const auto projection=PS2VRGun::Mat4::Projection(-1,1,-1,1);
+ const auto grip=PS2VRGun::Mat4::Translation(.12f,-.13f,-.42f)*PS2VRGun::Mat4::Rotation(1,0,0,-1.15f);
+ const auto aim=PS2VRGun::Mat4::Translation(.12f,-.095f,-.44f);
+ for(int eye=0;eye<2;eye++) {
+  const auto view_matrix=PS2VRGun::Mat4::Translation(eye?-.0315f:.0315f,0,0);
+  DrainGL("before","overlay proof render");
+  // Save gun-only alpha BEFORE adding the dot, then exercise dot-only with
+  // model hidden to catch stale opaque backgrounds on the following frame.
+  for(int pass=0;pass<2;pass++) {
+   const bool ok=RenderControllerOverlay(model,fbo,GUN_RES,GUN_RES,projection,view_matrix,grip,aim,0,-1,pass==0,pass==1,.5f,.5f,error);
+   glReadBuffer(GL_COLOR_ATTACHMENT0);glBindBuffer(GL_PIXEL_PACK_BUFFER,0);glPixelStorei(GL_PACK_ALIGNMENT,4);
+   glPixelStorei(GL_PACK_ROW_LENGTH,0);glPixelStorei(GL_PACK_SKIP_ROWS,0);glPixelStorei(GL_PACK_SKIP_PIXELS,0);
+   std::vector<u32> pixels(GUN_RES*GUN_RES),rgba(pixels.size()),alpha(pixels.size());
+   glReadPixels(0,0,GUN_RES,GUN_RES,GL_RGBA,GL_UNSIGNED_BYTE,pixels.data());
+   unsigned foreground=0,transparent=0;for(int y=0;y<GUN_RES;y++)for(int x=0;x<GUN_RES;x++) {
+    const auto value=pixels[(GUN_RES-1-y)*GUN_RES+x];const u32 a=value>>24;
+    rgba[y*GUN_RES+x]=value;alpha[y*GUN_RES+x]=0xff000000u|a|(a<<8)|(a<<16);
+    foreground+=a!=0;transparent+=a==0;
+   }
+   const std::string name=std::string(prefix)+(pass?"-dot":"-gun")+(eye?"-right":"-left");
+   const bool saved=RGBA8Image(GUN_RES,GUN_RES,std::move(rgba)).SaveToFile((name+"-rgba.png").c_str()) && RGBA8Image(GUN_RES,GUN_RES,std::move(alpha)).SaveToFile((name+"-alpha.png").c_str());
+   const auto errors=DrainGL("after","overlay proof render/readback");
+   if(live_log){std::fprintf(live_log,"Overlay alpha proof eye=%d part=%s draw=%d saved=%d foreground=%u transparent=%u GL_errors=%u error=%s\n",eye,pass?"dot":"gun",ok,saved,foreground,transparent,errors,error.c_str());std::fflush(live_log);}
+  }
+ }
+ XrCompositionLayerQuad quads[2]{{XR_TYPE_COMPOSITION_LAYER_QUAD},{XR_TYPE_COMPOSITION_LAYER_QUAD}};
+ XrCompositionLayerProjection scene{XR_TYPE_COMPOSITION_LAYER_PROJECTION},overlay{XR_TYPE_COMPOSITION_LAYER_PROJECTION};
+ overlay.layerFlags=XR_COMPOSITION_LAYER_BLEND_TEXTURE_SOURCE_ALPHA_BIT|XR_COMPOSITION_LAYER_UNPREMULTIPLIED_ALPHA_BIT;
+ for(bool inside:{false,true})RecordLayerOrder(ComposeLayers(inside,true,quads,scene,&overlay),inside,prefix,false);
+ model.Shutdown();glBindFramebuffer(GL_FRAMEBUFFER,0);glDeleteFramebuffers(1,&fbo);glDeleteTextures(1,&tex);
+ DrainGL("after","overlay proof cleanup");
+}

+  const char* value = std::getenv(name);
+  return value ? StringUtil::FromChars<float>(value).value_or(fallback) : fallback;
+ }
+ static void LiveLog(const char* message) { if (live_log) { std::fprintf(live_log, "%s\n", message); std::fflush(live_log); } }
+ static void SaveSharedProof()
+ {
+  if (!context->MakeCurrent()) { LiveLog("Proof shared context MakeCurrent failed"); return; }
+  LiveLog("OpenXR-disabled presenter thread has shared OpenGL context; no loader/runtime calls");
+  while (!stop)
+  {
+   std::unique_lock lock(mutex);
+   ready.wait(lock, []() { return stop || proof_pending; });
+   if (stop) break;
+   if (fence) glWaitSync(fence,0,GL_TIMEOUT_IGNORED);
+   const char* path=std::getenv("PCSX2_LIVE_SAVE_PATH");
+   if (path)
+   {
+    for (int eye=0; eye<2; eye++)
+    {
+     std::vector<u32> pixels(static_cast<size_t>(width)*height);
+     glGetTextureImage(eyes[eye],0,GL_RGBA,GL_UNSIGNED_BYTE,static_cast<GLsizei>(pixels.size()*4),pixels.data());
+     RGBA8Image image(width,height,std::move(pixels));
+     image.SaveToFile(fmt::format("{}-shared-{}.png",path,eye ? "right" : "left").c_str());
+    }
+    LiveLog("Presenter-thread readback saved from both shared GPU textures");
+   }
+   proof_pending=false; ready.notify_all();
+  }
+  context->DoneCurrent();
+ }

+  return GSVector2i(std::max(1,static_cast<int>(width*scale)),std::max(1,static_cast<int>(height*scale)));
+ }
+ static bool BlitEye(int eye, GLuint target, GLuint read_fbo, GLuint draw_fbo, const GSVector2i& used)
+ {
+  DrainGL("before","blit attachment setup");
+  glBindFramebuffer(GL_READ_FRAMEBUFFER,read_fbo);
+  glFramebufferTexture2D(GL_READ_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,eyes[eye],0);
+  glReadBuffer(GL_COLOR_ATTACHMENT0);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER,draw_fbo);
+  glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,target,0);
+  glDrawBuffer(GL_COLOR_ATTACHMENT0);
+  const GLenum read_status=glCheckFramebufferStatus(GL_READ_FRAMEBUFFER);
+  const GLenum draw_status=glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER);
+  const bool complete=read_status==GL_FRAMEBUFFER_COMPLETE && draw_status==GL_FRAMEBUFFER_COMPLETE;
+  if (!fbo_logged[eye] || !complete)
+  {
+   if (live_log) { std::fprintf(live_log,"Blit FBO eye=%d read=0x%04X draw=0x%04X source=%ux%u used=%dx%d fixed=%ux%u\n",eye,read_status,draw_status,width,height,used.x,used.y,chain_extent[eye].x,chain_extent[eye].y); std::fflush(live_log); }
+   fbo_logged[eye]=complete;
+  }
+  const unsigned attachment_errors=DrainGL("after","blit attachment setup / framebuffer status");
+  if (!complete || attachment_errors) return false;
+  // Source row zero is the GS picture top; GL OpenXR quads use bottom-left.
+  // A 1:1 copy stays exact (nearest). INSIDE stretches the GS eye into the
+  // headset grid by non-integer factors (1920x1536 -> 2592x2688): nearest
+  // made uneven pixel rows/columns that crawl differently in each eye as the
+  // head turns. Linear filtering removes that. PCSX2_VR_NEAREST_BLIT=1 restores it.
+  static const bool nearest=Env("PCSX2_VR_NEAREST_BLIT",0)!=0;
+  const bool scaled=used.x!=static_cast<int>(width) || used.y!=static_cast<int>(height);
+  glBlitFramebuffer(0,height,width,0,0,0,used.x,used.y,GL_COLOR_BUFFER_BIT,scaled && !nearest ? GL_LINEAR : GL_NEAREST);
+  return DrainGL("after","glBlitFramebuffer")==0;
+ }

+  rs.referenceSpaceType=XR_REFERENCE_SPACE_TYPE_VIEW;
+  if (!Check(XRGL("xrCreateReferenceSpace", p_xrCreateReferenceSpace, session,&rs,&view),"view space")) return false;
+  if ((PS2VRGun::MenuEnabled() || PS2VRGun::Enabled()) && !InitGunActions()) LiveLog("VR controls unavailable; gamepad remains active");

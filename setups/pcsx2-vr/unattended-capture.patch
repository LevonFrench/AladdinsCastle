+#ifdef _WIN32
+ #define PS2_XR_FUNCS(X) \
+ X(xrDestroyInstance) X(xrGetSystem) X(xrCreateSession) X(xrDestroySession) \
+ X(xrCreateReferenceSpace) X(xrDestroySpace) X(xrEnumerateSwapchainFormats) \
+ X(xrCreateSwapchain) X(xrDestroySwapchain) X(xrEnumerateSwapchainImages) \
+ X(xrAcquireSwapchainImage) X(xrWaitSwapchainImage) X(xrReleaseSwapchainImage) \
+ X(xrPollEvent) X(xrBeginSession) X(xrEndSession) X(xrWaitFrame) X(xrBeginFrame) \
+ X(xrEndFrame) X(xrLocateSpace) X(xrGetOpenGLGraphicsRequirementsKHR)
+ #define X(name) static PFN_##name p_##name = nullptr;
+ PS2_XR_FUNCS(X)
+ #undef X
+ static PFN_xrGetInstanceProcAddr getProc = nullptr;
+ static PFN_xrCreateInstance createInstance = nullptr;
+ static XrInstance instance = XR_NULL_HANDLE;
+ static XrSession session = XR_NULL_HANDLE;
+ static XrSpace space = XR_NULL_HANDLE, view = XR_NULL_HANDLE;
+ static XrSwapchain chains[2]{};
+ static std::vector<XrSwapchainImageOpenGLKHR> images[2];
+ static u32 chain_width = 0, chain_height = 0;
+ static int64_t format = 0;
+ static HMODULE loader = nullptr;
+ static bool Check(XrResult result, const char* operation)
+ {
+  if (XR_SUCCEEDED(result)) return true;
+  if (live_log) { std::fprintf(live_log, "%s failed: XrResult %d\n", operation, static_cast<int>(result)); std::fflush(live_log); }
+  return false;
+ }
+ static void DestroyChains()
+ {
+  for (int eye=0; eye<2; eye++) { if (chains[eye]) p_xrDestroySwapchain(chains[eye]); chains[eye]=XR_NULL_HANDLE; images[eye].clear(); }
+  chain_width=chain_height=0;
+ }
+ static bool InitXR()
+ {
+  // Never reached with PCSX2_OPENXR=0: no loader/runtime discovery in proofs.
+  loader=LoadLibraryW(L"openxr_loader.dll");
+  if (!loader) { LiveLog("OpenXR loader missing beside portable program"); return false; }
+  getProc=reinterpret_cast<PFN_xrGetInstanceProcAddr>(GetProcAddress(loader,"xrGetInstanceProcAddr"));
+  createInstance=reinterpret_cast<PFN_xrCreateInstance>(GetProcAddress(loader,"xrCreateInstance"));
+  if (!getProc || !createInstance) return false;
+  const char* extensions[]={XR_KHR_OPENGL_ENABLE_EXTENSION_NAME};
+  XrInstanceCreateInfo ci{XR_TYPE_INSTANCE_CREATE_INFO};
+  std::strcpy(ci.applicationInfo.applicationName,"ACVR PCSX2");
+  std::strcpy(ci.applicationInfo.engineName,"PCSX2");
+  ci.applicationInfo.apiVersion=XR_MAKE_VERSION(1,0,0);
+  ci.enabledExtensionCount=1; ci.enabledExtensionNames=extensions;
+  if (!Check(createInstance(&ci,&instance),"xrCreateInstance")) return false;
+  #define X(name) if (XR_FAILED(getProc(instance,#name,reinterpret_cast<PFN_xrVoidFunction*>(&p_##name))) || !p_##name) return false;
+  PS2_XR_FUNCS(X)
+  #undef X
+  XrSystemGetInfo si{XR_TYPE_SYSTEM_GET_INFO}; si.formFactor=XR_FORM_FACTOR_HEAD_MOUNTED_DISPLAY;
+  XrSystemId system{};
+  if (!Check(p_xrGetSystem(instance,&si,&system),"xrGetSystem")) return false;
+  XrGraphicsRequirementsOpenGLKHR req{XR_TYPE_GRAPHICS_REQUIREMENTS_OPENGL_KHR};
+  if (!Check(p_xrGetOpenGLGraphicsRequirementsKHR(instance,system,&req),"OpenGL requirements")) return false;
+  XrGraphicsBindingOpenGLWin32KHR binding{XR_TYPE_GRAPHICS_BINDING_OPENGL_WIN32_KHR};
+  binding.hDC=wglGetCurrentDC(); binding.hGLRC=wglGetCurrentContext();
+  XrSessionCreateInfo sci{XR_TYPE_SESSION_CREATE_INFO}; sci.next=&binding; sci.systemId=system;
+  if (!Check(p_xrCreateSession(instance,&sci,&session),"xrCreateSession")) return false;
+  XrReferenceSpaceCreateInfo rs{XR_TYPE_REFERENCE_SPACE_CREATE_INFO};
+  rs.referenceSpaceType=XR_REFERENCE_SPACE_TYPE_LOCAL; rs.poseInReferenceSpace.orientation.w=1;
+  if (!Check(p_xrCreateReferenceSpace(session,&rs,&space),"local space")) return false;
+  rs.referenceSpaceType=XR_REFERENCE_SPACE_TYPE_VIEW;
+  if (!Check(p_xrCreateReferenceSpace(session,&rs,&view),"view space")) return false;
+  u32 n=0;
+  if (!Check(p_xrEnumerateSwapchainFormats(session,0,&n,nullptr),"swapchain formats")) return false;
+  std::vector<int64_t> formats(n);
+  if (!n || !Check(p_xrEnumerateSwapchainFormats(session,n,&n,formats.data()),"swapchain formats")) return false;
+  for (int64_t wanted : {static_cast<int64_t>(GL_SRGB8_ALPHA8),static_cast<int64_t>(GL_RGBA8)})
+  { for (int64_t f:formats) if (f==wanted) { format=wanted; break; } if (format) break; }
+  return format != 0;
+ }
+ static bool EnsureChains()
+ {
+  if (chain_width==width && chain_height==height) return true;
+  DestroyChains();
+  for (int eye=0; eye<2; eye++)
+  {
+   XrSwapchainCreateInfo ci{XR_TYPE_SWAPCHAIN_CREATE_INFO};
+   ci.usageFlags=XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT|XR_SWAPCHAIN_USAGE_TRANSFER_DST_BIT;
+   ci.format=format; ci.sampleCount=1; ci.width=width; ci.height=height; ci.faceCount=1; ci.arraySize=1; ci.mipCount=1;
+   if (!Check(p_xrCreateSwapchain(session,&ci,&chains[eye]),"xrCreateSwapchain")) return false;
+   u32 n=0;
+   if (!Check(p_xrEnumerateSwapchainImages(chains[eye],0,&n,nullptr),"swapchain images")) return false;
+   images[eye].resize(n,{XR_TYPE_SWAPCHAIN_IMAGE_OPENGL_KHR});
+   if (!n || !Check(p_xrEnumerateSwapchainImages(chains[eye],n,&n,reinterpret_cast<XrSwapchainImageBaseHeader*>(images[eye].data())),"swapchain images")) return false;
+  }
+  chain_width=width; chain_height=height; return true;
+ }
+ static bool PlaceScreen(XrTime time, XrPosef& pose)
+ {
+  XrSpaceLocation loc{XR_TYPE_SPACE_LOCATION};
+  const auto valid=XR_SPACE_LOCATION_POSITION_VALID_BIT|XR_SPACE_LOCATION_ORIENTATION_VALID_BIT;
+  if (XR_FAILED(p_xrLocateSpace(view,space,time,&loc)) || (loc.locationFlags&valid)!=valid) return false;
+  const auto q=loc.pose.orientation;
+  const float yaw=std::atan2(2*(q.x*q.z+q.w*q.y),1-2*(q.x*q.x+q.y*q.y));
+  const float distance=Env("PCSX2_OPENXR_DISTANCE_M",2.5f);
+  pose.orientation={0,std::sin(yaw*.5f),0,std::cos(yaw*.5f)};
+  pose.position={loc.pose.position.x-std::sin(yaw)*distance,loc.pose.position.y,loc.pose.position.z-std::cos(yaw)*distance};
+  LiveLog("Screen recentered at current head position/yaw"); return true;
+ }
+ static void ThreadXR()
+ {
+  if (!context->MakeCurrent()) { LiveLog("Shared GL context MakeCurrent failed"); return; }
+  glDisable(GL_FRAMEBUFFER_SRGB); glDisable(GL_SCISSOR_TEST);
+  if (InitXR())
+  {
+   LiveLog("OpenXR session created on presenter thread");
+   GLuint fbos[2]{}; glGenFramebuffers(2,fbos);
+   bool running=false, placed=false, home_down=false;
+   XrPosef pose{};
+   while (!stop)
+   {
+    XrEventDataBuffer ev{XR_TYPE_EVENT_DATA_BUFFER};
+    while (p_xrPollEvent(instance,&ev)==XR_SUCCESS)
+    {
+     if (ev.type==XR_TYPE_EVENT_DATA_SESSION_STATE_CHANGED)
+     {
+      auto state=reinterpret_cast<XrEventDataSessionStateChanged*>(&ev)->state;
+      if (state==XR_SESSION_STATE_READY) { XrSessionBeginInfo bi{XR_TYPE_SESSION_BEGIN_INFO}; bi.primaryViewConfigurationType=XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO; running=Check(p_xrBeginSession(session,&bi),"xrBeginSession"); }
+      if (state==XR_SESSION_STATE_STOPPING) { p_xrEndSession(session); running=false; }
+      if (state==XR_SESSION_STATE_EXITING || state==XR_SESSION_STATE_LOSS_PENDING) stop=true;
+     }
+     if (ev.type==XR_TYPE_EVENT_DATA_INSTANCE_LOSS_PENDING) stop=true;
+     ev={XR_TYPE_EVENT_DATA_BUFFER};
+    }
+    if (stop) break;
+    if (!running) { std::this_thread::sleep_for(std::chrono::milliseconds(25)); continue; }
+    XrFrameWaitInfo wi{XR_TYPE_FRAME_WAIT_INFO}; XrFrameState fs{XR_TYPE_FRAME_STATE};
+    if (!Check(p_xrWaitFrame(session,&wi,&fs),"xrWaitFrame")) break;
+    XrFrameBeginInfo bi{XR_TYPE_FRAME_BEGIN_INFO}; if (!Check(p_xrBeginFrame(session,&bi),"xrBeginFrame")) break;
+    const bool home=(GetAsyncKeyState(VK_HOME)&0x8000)!=0;
+    if (!placed || (home && !home_down)) placed=PlaceScreen(fs.predictedDisplayTime,pose);
+    home_down=home;
+    XrCompositionLayerQuad quads[2]{};
+    const XrCompositionLayerBaseHeader* layers[2]{};
+    u32 count=0;
+    if (fs.shouldRender && placed)
+    {
+     std::lock_guard guard(mutex);
+     if (serial && EnsureChains())
+     {
+      if (fence) glWaitSync(fence,0,GL_TIMEOUT_IGNORED);
+      for (int eye=0; eye<2; eye++)
+      {
+       u32 index=0; XrSwapchainImageAcquireInfo ai{XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO};
+       if (!Check(p_xrAcquireSwapchainImage(chains[eye],&ai,&index),"xrAcquireSwapchainImage")) break;
+       XrSwapchainImageWaitInfo swi{XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO}; swi.timeout=1000000000;
+       if (!Check(p_xrWaitSwapchainImage(chains[eye],&swi),"xrWaitSwapchainImage")) break;
+       glBindFramebuffer(GL_READ_FRAMEBUFFER,fbos[0]); glFramebufferTexture2D(GL_READ_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,eyes[eye],0);
+       glBindFramebuffer(GL_DRAW_FRAMEBUFFER,fbos[1]); glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,images[eye][index].image,0);
+       // GS texture row zero is the top of the picture; OpenXR GL quads use bottom-left.
+       glBlitFramebuffer(0,height,width,0,0,0,width,height,GL_COLOR_BUFFER_BIT,GL_NEAREST);
+       glFinish(); // publication mutex protects GPU use, not just submission
+       XrSwapchainImageReleaseInfo ri{XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+       if (!Check(p_xrReleaseSwapchainImage(chains[eye],&ri),"xrReleaseSwapchainImage")) break;
+       auto& q=quads[eye]; q.type=XR_TYPE_COMPOSITION_LAYER_QUAD; q.space=space;
+       q.eyeVisibility=eye ? XR_EYE_VISIBILITY_RIGHT : XR_EYE_VISIBILITY_LEFT;
+       q.subImage.swapchain=chains[eye]; q.subImage.imageRect.extent={static_cast<int32_t>(width),static_cast<int32_t>(height)};
+       q.pose=pose;
+       q.size.width=Env("PCSX2_OPENXR_DISTANCE_M",2.5f)*native_width/Env("PCSX2_STEREO_FOCAL_PX",320);
+       q.size.height=q.size.width/Env("PCSX2_OPENXR_ASPECT",4.0f/3.0f);
+       layers[count++]=reinterpret_cast<XrCompositionLayerBaseHeader*>(&q);
+      }
+     }
+    }
+    XrFrameEndInfo ei{XR_TYPE_FRAME_END_INFO}; ei.displayTime=fs.predictedDisplayTime; ei.environmentBlendMode=XR_ENVIRONMENT_BLEND_MODE_OPAQUE;
+    ei.layerCount=count; ei.layers=count ? layers : nullptr;
+    if (!Check(p_xrEndFrame(session,&ei),"xrEndFrame")) break;
+   }
+   glDeleteFramebuffers(2,fbos);
+  }
+  DestroyChains();
+  if (view && p_xrDestroySpace) p_xrDestroySpace(view);
+  if (space && p_xrDestroySpace) p_xrDestroySpace(space);
+  if (session && p_xrDestroySession) p_xrDestroySession(session);
+  if (instance && p_xrDestroyInstance) p_xrDestroyInstance(instance);
+  view=space=XR_NULL_HANDLE; session=XR_NULL_HANDLE; instance=XR_NULL_HANDLE;
+  if (loader) { FreeLibrary(loader); loader=nullptr; }
+  context->DoneCurrent();
+ }
+#endif
+ static void Switch()
+ {
+  std::swap(g_gs_renderer,renderer); std::swap(g_texture_cache,cache);
+  g_gs_device->SwapStereoScanout(scanout);
+  other=!other; GSDeviceOGL::SetStereoEye(other ? -1 : 1);
+ }
+}
+
+bool PS2StereoSecondary() { return PS2Live::enabled && PS2Live::other; }
+bool PS2StereoLiveEnabled() { return PS2Live::enabled; }
+template<typename F> static void PS2StereoOther(F&& f)
+{
+ if (!PS2Live::enabled || PS2Live::other) return;
+ PS2Live::Switch(); f(); PS2Live::Switch();
+}
+static void PS2StereoOpen(u8* basemem)
+{
+ using namespace PS2Live;
+ if (enabled || GSGetCurrentRenderer()!=GSRendererType::OGL || Env("PCSX2_STEREO",0)==0 || Env("PCSX2_STEREO_LIVE",0)==0) return;
+ cache=std::move(g_texture_cache); renderer=std::move(g_gs_renderer);
+ g_gs_renderer=std::make_unique<GSRendererHW>();
+ g_gs_renderer->SetRegsMem(basemem); g_gs_renderer->ResetPCRTC(); g_gs_renderer->UpdateRenderFixes();
+ std::swap(g_texture_cache,cache); std::swap(g_gs_renderer,renderer);
+ enabled=true; other=false; stop=false; serial=0; ticks=0; proof_pending=false; GSDeviceOGL::SetStereoEye(1);
+ g_gs_device->ResetStereoInterlacePhase();
+ live_log=std::fopen("pcsx2-live-stereo.log","w");
+ LiveLog("Live stereo: independent GS RAM, paths, render/depth caches and scanout history per eye");
+#ifdef _WIN32
+  Error error;
+  WindowInfo wi; wi.type=WindowInfo::Type::Surfaceless; wi.surface_width=16; wi.surface_height=16;
+  auto* gl=static_cast<GSDeviceOGL*>(g_gs_device.get())->GetGLContext();
+  context=gl->CreateSharedContext(wi,&error); gl->MakeCurrent();
+  if (context) thread=std::thread(Env("PCSX2_OPENXR",0)!=0 ? ThreadXR : SaveSharedProof);
+  else { LiveLog(error.GetDescription().c_str()); Host::ReportErrorAsync("PCSX2 OpenXR","Could not create shared OpenGL context. See private live live_log."); }
+#endif
+ if (Env("PCSX2_OPENXR",0)==0) LiveLog("OpenXR disabled: loader is not loaded; both GPU textures are still published");
+}
+static void PS2StereoClose()
+{
+ using namespace PS2Live;
+ if (!enabled) return;
+ stop=true;
+ ready.notify_all();
+ if (thread.joinable()) thread.join();
+ context.reset();
+ // Right-eye renderer destruction must occur with its own cache selected.
+ Switch(); g_gs_renderer->Destroy(); g_gs_renderer.reset();
+ g_gs_device->ClearCurrent();
+ Switch();
+ if (fence) { glDeleteSync(fence); fence=nullptr; }
+ glDeleteTextures(2,eyes); glDeleteTextures(2,pending);
+ eyes[0]=eyes[1]=pending[0]=pending[1]=0; width=height=pending_width=pending_height=0;
+ enabled=false; other=false;
+ LiveLog("Live stereo closed"); if (live_log) { std::fclose(live_log); live_log=nullptr; }
+}
+void PS2StereoScanout()
+{
+ using namespace PS2Live;
+ if (!enabled) return;
+ GSTexture* src=g_gs_device->GetCurrent(); if (!src) return;
+ std::unique_lock guard(mutex);
+ const u32 w=src->GetWidth(), h=src->GetHeight();
+ if (pending_width!=w || pending_height!=h)
+ {
+  glDeleteTextures(2,pending); glCreateTextures(GL_TEXTURE_2D,2,pending);
+  for (GLuint eye:pending) glTextureStorage2D(eye,1,GL_RGBA8,w,h);
+  pending_width=w; pending_height=h;
+ }
+ glCopyImageSubData(static_cast<GSTextureOGL*>(src)->GetID(),GL_TEXTURE_2D,0,0,0,0,pending[other?1:0],GL_TEXTURE_2D,0,0,0,0,w,h,1);
+ if (other) return;
+ if (width!=w || height!=h)
+ {
+  glDeleteTextures(2,eyes); glCreateTextures(GL_TEXTURE_2D,2,eyes);
+  for (GLuint eye:eyes) glTextureStorage2D(eye,1,GL_RGBA8,w,h);
+  width=w; height=h;
+ }
+ for (int eye=0; eye<2; eye++) glCopyImageSubData(pending[eye],GL_TEXTURE_2D,0,0,0,0,eyes[eye],GL_TEXTURE_2D,0,0,0,0,w,h,1);
+ native_width=static_cast<float>(w)/GSConfig.UpscaleMultiplier;
+ if (fence) glDeleteSync(fence);
+ fence=glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE,0); glFlush(); serial++;
+ if (serial==1 || serial%600==0)
+ {
+  if (live_log) { std::fprintf(live_log,"Published pair %lu (GS tick %lu): textures %u/%u, %ux%u, upscale %.1fx, speed %.2f%%\n",serial,ticks,eyes[0],eyes[1],w,h,GSConfig.UpscaleMultiplier,PerformanceMetrics::GetSpeed()); std::fflush(live_log); }
+ }
+ const char* save_frame=std::getenv("PCSX2_LIVE_SAVE_FRAME");
+ if (save_frame && ticks==std::strtoul(save_frame,nullptr,10))
+ {
+  if (const char* path=std::getenv("PCSX2_LIVE_SAVE_PATH"))
+  {
+   std::vector<u32> pixels[2];
+   for (int eye=0; eye<2; eye++)
+   {
+    pixels[eye].resize(static_cast<size_t>(w)*h);
+    glGetTextureImage(eyes[eye],0,GL_RGBA,GL_UNSIGNED_BYTE,static_cast<GLsizei>(pixels[eye].size()*4),pixels[eye].data());
+    RGBA8Image image(w,h,pixels[eye]); image.SaveToFile(fmt::format("{}-{}.png",path,eye ? "right" : "left").c_str());
+   }
+   std::vector<u32> pair(static_cast<size_t>(w)*h*2);
+   for (u32 y=0; y<h; y++) for (int eye=0; eye<2; eye++) std::copy_n(pixels[eye].data()+static_cast<size_t>(y)*w,w,pair.data()+static_cast<size_t>(y)*w*2+eye*w);
+   RGBA8Image image(w*2,h,std::move(pair)); image.SaveToFile(fmt::format("{}-sbs.png",path).c_str());
+   LiveLog("Saved both published GPU textures and exact row-joined SBS");
+   if (Env("PCSX2_OPENXR",0)==0 && context)
+   {
+    proof_pending=true; ready.notify_all();
+    if (!ready.wait_for(guard,std::chrono::seconds(5),[]() { return !proof_pending; }))
+     LiveLog("Shared-thread readback timed out");
+   }
+  }
+ }
+}

+       q.pose=pose;
+       q.size.width=screen_width;
+       q.size.height=screen_height;
+       if (!PS2VRInside::Enabled()) layers[count++]=reinterpret_cast<XrCompositionLayerBaseHeader*>(&q);
+       else if (published_inside.valid)
+       {
+        const auto& e=published_inside.eyes[eye]; auto& p=inside_views[eye];
+        p.pose.position={e.pose[0],e.pose[1],e.pose[2]}; p.pose.orientation={e.pose[3],e.pose[4],e.pose[5],e.pose[6]};
+        p.fov={std::atan(e.tangents[0]),std::atan(e.tangents[1]),std::atan(e.tangents[3]),std::atan(e.tangents[2])};
+        p.subImage.swapchain=chains[eye]; p.subImage.imageRect.extent={used.x,used.y};
+       }
+      }
+      if (PS2VRInside::Enabled() && published_inside.valid && inside_views[0].subImage.swapchain && inside_views[1].subImage.swapchain)
+      {
+       inside_layer.space=space; inside_layer.viewCount=2; inside_layer.views=inside_views;
+       submitted_inside_sequence=published_inside.sequence;
+       layers[count++]=reinterpret_cast<XrCompositionLayerBaseHeader*>(&inside_layer);
+      }
+     }
+    }
+    XrFrameEndInfo ei{XR_TYPE_FRAME_END_INFO}; ei.displayTime=fs.predictedDisplayTime; ei.environmentBlendMode=XR_ENVIRONMENT_BLEND_MODE_OPAQUE;
+    const u32 expected_game_layers=PS2VRInside::Enabled()?1u:2u;
+    if (count!=expected_game_layers) count=0; // complete stereo projection or two eye quads
+    XrCompositionLayerProjection gun_layer{XR_TYPE_COMPOSITION_LAYER_PROJECTION};
+    XrCompositionLayerProjectionView gun_views[2]{};
+    const bool complete=count==expected_game_layers;
+    const bool overlay=complete && DrawTrackedGun(fs.predictedDisplayTime,pose,screen_width,screen_height,gun_layer,gun_views);
+    const auto composed=ComposeLayers(PS2VRInside::Enabled(),complete,quads,inside_layer,overlay?&gun_layer:nullptr);
+    count=composed.count;
+    ei.layerCount=count; ei.layers=count ? composed.layers : nullptr;
+    const XrResult ended=XRGL("xrEndFrame", p_xrEndFrame, session,&ei);
+    if (!Check(ended,"xrEndFrame")) break;
+    if (count>0 && ended==XR_SUCCESS)
+    {
+     frames_with_layers++;
+     static bool recorded_overlay=false;
+     if (overlay && !recorded_overlay) { RecordLayerOrder(composed,PS2VRInside::Enabled(),std::getenv("PCSX2_VR_LAYER_PROOF"),true); recorded_overlay=true; }
+     if (frames_with_layers==1 && live_log) { std::fprintf(live_log,"First successful xrEndFrame with layers: layers=%u mode=%s pose_sequence=%llu\n",count,PS2VRInside::Enabled()?"inside-projection":"stereo-screen",static_cast<unsigned long long>(submitted_inside_sequence)); std::fflush(live_log); }
+     if (frames_with_layers%300==0 && live_log) { std::fprintf(live_log,"XR progress: frames_with_layers=%llu gl_errors_drained=%llu\n",frames_with_layers,drained_errors); std::fflush(live_log); }
+    }
+    if (retry_window) break;
+   }
+   glDeleteFramebuffers(2,fbos);
+  }
+  ReleaseGunInput();
+  DestroyGunGraphics();
+  DestroyGunActions();
+  DestroyChains();
+  if (view && p_xrDestroySpace) XRGL("xrDestroySpace", p_xrDestroySpace, view);
+  if (space && p_xrDestroySpace) XRGL("xrDestroySpace", p_xrDestroySpace, space);
+  if (session && p_xrDestroySession) XRGL("xrDestroySession", p_xrDestroySession, session);
+  if (gun_actions && p_xrDestroyActionSet) XRGL("xrDestroyActionSet",p_xrDestroyActionSet,gun_actions);
+  gun_actions=XR_NULL_HANDLE;
+  if (instance && p_xrDestroyInstance) XRGL("xrDestroyInstance", p_xrDestroyInstance, instance);
+  view=space=XR_NULL_HANDLE; session=XR_NULL_HANDLE; instance=XR_NULL_HANDLE;
+  if (loader) { FreeLibrary(loader); loader=nullptr; }
+  context->DoneCurrent();
+  format=0;
+  return retry_window;
+ }
+ static void ThreadXR()
+ {
+  const bool retry=PresentContext();
+  if (retry && window_context && !using_window_dc && !stop)
+  {
+   LiveLog("Fixed swapchain creation failed; retrying one new session on hidden 1x1 window DC");
+   context.swap(window_context); using_window_dc=true;
+   PresentContext();
+  }
+  if (live_log) { std::fprintf(live_log,"OpenXR summary: swapchains_created=%s frames_with_layers=%llu gl_errors_drained=%llu context=%s\n",swapchain_pair_created ? "yes" : "no",frames_with_layers,drained_errors,using_window_dc ? "hidden-window DC" : "surfaceless"); std::fflush(live_log); }
+ }
+ static std::unique_ptr<GLContext> CreateWindowContext(GLContext* parent, Error* error)
+ {
+  const wchar_t* name=L"PCSX2StereoPresenter";
+  WNDCLASSW wc{}; wc.style=CS_OWNDC; wc.lpfnWndProc=DefWindowProcW;
+  wc.hInstance=GetModuleHandleW(nullptr); wc.lpszClassName=name;
+  if (!RegisterClassW(&wc) && GetLastError()!=ERROR_CLASS_ALREADY_EXISTS) return nullptr;
+  presenter_window=CreateWindowExW(0,name,L"PCSX2 stereo presenter",WS_POPUP,0,0,1,1,nullptr,nullptr,wc.hInstance,nullptr);
+  if (!presenter_window) return nullptr;
+  WindowInfo wi; wi.type=WindowInfo::Type::Win32; wi.window_handle=presenter_window;
+  wi.surface_width=wi.surface_height=1;
+  auto result=parent->CreateSharedContext(wi,error);
+  parent->MakeCurrent();
+  if (!result) { DestroyWindow(presenter_window); presenter_window=nullptr; }
+  return result;
+ }
+#endif
+ static void Switch()
+ {
+  std::swap(g_gs_renderer,renderer); std::swap(g_texture_cache,cache);
+  g_gs_device->SwapStereoScanout(scanout);
+  other=!other; GSDeviceOGL::SetStereoEye(other ? -1 : 1);
+ }

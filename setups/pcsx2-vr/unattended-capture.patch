+   if (!Check(XRGL("xrCreateSwapchain", p_xrCreateSwapchain, session,&ci,&chains[eye]),"xrCreateSwapchain")) return false;
+   u32 n=0;
+   if (!Check(XRGL("xrEnumerateSwapchainImages", p_xrEnumerateSwapchainImages, chains[eye],0,&n,nullptr),"swapchain images")) return false;
+   images[eye].resize(n,{XR_TYPE_SWAPCHAIN_IMAGE_OPENGL_KHR});
+   if (!n || !Check(XRGL("xrEnumerateSwapchainImages", p_xrEnumerateSwapchainImages, chains[eye],n,&n,reinterpret_cast<XrSwapchainImageBaseHeader*>(images[eye].data())),"swapchain images")) return false;
+  }
+  swapchain_pair_created=true;
+  if (live_log) { std::fprintf(live_log,"Swapchain pair created: fixed=%ux%u context=%s\n",CHAIN_WIDTH,CHAIN_HEIGHT,using_window_dc ? "hidden-window DC" : "surfaceless"); std::fflush(live_log); }
+  return true;
+ }
+ static bool PlaceScreen(XrTime time, XrPosef& pose)
+ {
+  XrSpaceLocation loc{XR_TYPE_SPACE_LOCATION};
+  const auto valid=XR_SPACE_LOCATION_POSITION_VALID_BIT|XR_SPACE_LOCATION_ORIENTATION_VALID_BIT;
+  if (XR_FAILED(XRGL("xrLocateSpace", p_xrLocateSpace, view,space,time,&loc)) || (loc.locationFlags&valid)!=valid) return false;
+  const auto q=loc.pose.orientation;
+  const float yaw=std::atan2(2*(q.x*q.z+q.w*q.y),1-2*(q.x*q.x+q.y*q.y));
+  const float distance=Env("PCSX2_OPENXR_DISTANCE_M",2.5f);
+  pose.orientation={0,std::sin(yaw*.5f),0,std::cos(yaw*.5f)};
+  pose.position={loc.pose.position.x-std::sin(yaw)*distance,loc.pose.position.y,loc.pose.position.z-std::cos(yaw)*distance};
+  inside_origin=PS2VRGun::Mat4::FromPose(&loc.pose.position.x,&pose.orientation.x);
+  LiveLog("Screen recentered at current head position/yaw"); return true;
+ }
+ static bool PresentContext()
+ {
+  if (!context->MakeCurrent()) { LiveLog("Shared GL context MakeCurrent failed"); return false; }
+  bool retry_window=false;
+  fbo_logged[0]=fbo_logged[1]=false;
+  LiveLog(using_window_dc ? "XR context attempt: hidden 1x1 window DC" : "XR context attempt: surfaceless");
+  glDisable(GL_FRAMEBUFFER_SRGB); glDisable(GL_SCISSOR_TEST);
+  if (InitXR())
+  {
+   LiveLog("OpenXR session created on presenter thread");
+   GLuint fbos[2]{}; glGenFramebuffers(2,fbos);
+   bool running=false, placed=false, home_down=false, focused=false;
+   XrPosef pose{};
+   while (!stop)
+   {
+    XrEventDataBuffer ev{XR_TYPE_EVENT_DATA_BUFFER};

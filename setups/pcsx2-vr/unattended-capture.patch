+   const unsigned w=static_cast<unsigned>(std::clamp(Env("PCSX2_INSIDE_TEST_EYE_WIDTH",1024),1.f,static_cast<float>(limit)));
+   const unsigned h=static_cast<unsigned>(std::clamp(Env("PCSX2_INSIDE_TEST_EYE_HEIGHT",1024),1.f,static_cast<float>(limit)));
+   chain_extent[0]=chain_extent[1]={static_cast<int>(w),static_cast<int>(h)};
+   PS2VRInside::SetRecommended({PS2VRInside::EyeSize{w,h},PS2VRInside::EyeSize{w,h}});
+   LiveLog("OFFLINE synthetic recommendation injected; NOT a headset measurement; no loader/runtime calls");
+  }
+  if (PS2VRGun::Enabled() && std::getenv("PCSX2_VR_GUN_MODEL_PROOF"))
+  {
+   PS2VRGun::Renderer model; std::string error;
+   DrainGL("before","gun model proof");
+   if (model.Init(error) && model.SaveProof(std::getenv("PCSX2_VR_GUN_MODEL_PROOF"),error)) LiveLog("Gun model trigger 0/1 GPU renders saved");
+   else LiveLog(("Gun model proof failed: "+error).c_str());
+   model.Shutdown(); DrainGL("after","gun model proof");
+  }
+#ifdef _WIN32
+  if (std::getenv("PCSX2_VR_LAYER_PROOF")) SaveOverlayProof();
+#endif
+  if(PS2VRInside::Enabled() && Env("PCSX2_OPENXR",0)==0 && Env("PCSX2_INSIDE_TEST_HEAD_YAW_DEG",0)!=0) {
+   SyntheticPresenter(Env("PCSX2_INSIDE_TEST_HEAD_YAW_DEG",0));
+   context->DoneCurrent(); return;
+  }
+  while (!stop)
+  {
+   {
+    std::unique_lock lock(mutex);
+    ready.wait(lock, []() { return stop || proof_pending; });
+    if (stop) break;
+   }
+   ServiceProof();
+  }
+  context->DoneCurrent();
+ }
+ // Presenter thread, shared context current: save the requested proof
+ // pictures, then clear proof_pending, all under the publication lock.
+ static void ServiceProof()
+ {
+  {
+   std::unique_lock lock(mutex);
+   if (!proof_pending) return;
+   if (fence) glWaitSync(fence,0,GL_TIMEOUT_IGNORED);
+   DrainGL("after","shared fence wait");
+   const char* path=std::getenv("PCSX2_LIVE_SAVE_PATH");
+   if (path)
+   {
+    for (int eye=0; eye<2; eye++)
+    {
+     std::vector<u32> pixels(static_cast<size_t>(width)*height);
+     glGetTextureImage(eyes[eye],0,GL_RGBA,GL_UNSIGNED_BYTE,static_cast<GLsizei>(pixels.size()*4),pixels.data());
+     RGBA8Image image(width,height,std::move(pixels));
+     image.SaveToFile(fmt::format("{}-shared-{}.png",path,eye ? "right" : "left").c_str());
+    }
+    LiveLog("Presenter-thread readback saved from both shared GPU textures");
+   }
+   if (path && Env("PCSX2_OPENXR_TEST_BLIT",0)!=0)
+   {
+    // Exercise the actual fixed-size, sRGB swapchain-copy path without loading
+    // OpenXR. Compare the used GPU region to the flipped published pixels.
+    GLuint targets[2]{}, fbos[2]{};
+    glCreateTextures(GL_TEXTURE_2D,2,targets); glGenFramebuffers(2,fbos);
+    for(int eye=0;eye<2;eye++)glTextureStorage2D(targets[eye],1,GL_SRGB8_ALPHA8,chain_extent[eye].x,chain_extent[eye].y);
+    glDisable(GL_FRAMEBUFFER_SRGB); glDisable(GL_SCISSOR_TEST);
+    for (int eye=0;eye<2;eye++)
+    {
+     const GSVector2i used=UsedExtent(eye);
+     const bool copied=BlitEye(eye,targets[eye],fbos[0],fbos[1],used);
+     std::vector<u32> result(static_cast<size_t>(chain_extent[eye].x)*chain_extent[eye].y);
+     std::vector<u32> original(static_cast<size_t>(width)*height);
+     glGetTextureImage(targets[eye],0,GL_RGBA,GL_UNSIGNED_BYTE,static_cast<GLsizei>(result.size()*4),result.data());
+     glGetTextureImage(eyes[eye],0,GL_RGBA,GL_UNSIGNED_BYTE,static_cast<GLsizei>(original.size()*4),original.data());
+     bool exact=copied && used.x==static_cast<int>(width) && used.y==static_cast<int>(height);
+     std::vector<u32> crop(static_cast<size_t>(used.x)*used.y);
+     for (int y=0;y<used.y;y++)
+     {
+      std::copy_n(result.data()+static_cast<size_t>(y)*chain_extent[eye].x,used.x,crop.data()+static_cast<size_t>(y)*used.x);
+      if (exact) exact=std::equal(crop.data()+static_cast<size_t>(y)*used.x,crop.data()+static_cast<size_t>(y+1)*used.x,original.data()+static_cast<size_t>(height-1-y)*width);
+     }
+     RGBA8Image image(used.x,used.y,std::move(crop)); image.SaveToFile(fmt::format("{}-blit-{}.png",path,eye ? "right" : "left").c_str());
+     if (live_log) { std::fprintf(live_log,"Fixed-target blit proof eye=%d copied=%d exact_vertical_flip=%d GL_errors_drained=%llu\n",eye,copied,exact,drained_errors); std::fflush(live_log); }
+    }
+    glDeleteFramebuffers(2,fbos); glDeleteTextures(2,targets);
+    DrainGL("after","fixed-target proof cleanup");
+   }
+#ifdef _WIN32
+   if(std::getenv("PCSX2_VR_SCREEN_PROOF"))SaveScreenProof();
+#endif
+   proof_pending=false; ready.notify_all();
+  }
+ }

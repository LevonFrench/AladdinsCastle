+ // Errors belong to a GL context. Drain at both sides of the boundary so a
+ // stale application error cannot be attributed to the runtime's next GL call.
+ static unsigned DrainGL(const char* phase, const char* operation)
+ {
+  unsigned count=0;
+  for (GLenum error; count<64 && (error=glGetError())!=GL_NO_ERROR; count++)
+  {
+   drained_errors++;
+   if (live_log) { std::fprintf(live_log,"GL error drained %s %s: 0x%04X (total=%llu)\n",phase,operation,error,drained_errors); std::fflush(live_log); }
+  }
+  if (count==64) LiveLog("GL error drain limit reached; context may be lost");
+  return count;
+ }
+ static GSVector2i UsedExtent(int eye=0)
+ {
+  if(PS2VRInside::Enabled() && PS2VRInside::Recommended()[eye].width)return chain_extent[eye];

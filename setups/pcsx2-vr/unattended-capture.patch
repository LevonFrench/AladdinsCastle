+  const GLenum draw_status=glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER);
+  const bool complete=read_status==GL_FRAMEBUFFER_COMPLETE && draw_status==GL_FRAMEBUFFER_COMPLETE;

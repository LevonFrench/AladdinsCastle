+ static std::unique_ptr<GLContext> CreateWindowContext(GLContext* parent, Error* error)
+ {
+  const wchar_t* name=L"PCSX2StereoPresenter";
+  WNDCLASSW wc{}; wc.style=CS_OWNDC; wc.lpfnWndProc=DefWindowProcW;
+  wc.hInstance=GetModuleHandleW(nullptr); wc.lpszClassName=name;
+  if (!RegisterClassW(&wc) && GetLastError()!=ERROR_CLASS_ALREADY_EXISTS) return nullptr;
+  presenter_window=CreateWindowExW(0,name,L"PCSX2 stereo presenter",WS_POPUP,0,0,1,1,nullptr,nullptr,wc.hInstance,nullptr);
+  if (!presenter_window) return nullptr;
+  WindowInfo wi; wi.type=WindowInfo::Type::Win32; wi.window_handle=presenter_window;
+  wi.surface_width=wi.surface_height=1;
+  auto result=parent->CreateSharedContext(wi,error);
+  parent->MakeCurrent();
+  if (!result) { DestroyWindow(presenter_window); presenter_window=nullptr; }

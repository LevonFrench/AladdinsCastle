+    }
+    glDeleteFramebuffers(2,fbos); glDeleteTextures(2,targets);
+    DrainGL("after","fixed-target proof cleanup");
+   }
+   proof_pending=false; ready.notify_all();
+  }
+  context->DoneCurrent();
+ }

+// SPDX-License-Identifier: GPL-3.0+
+// In-process screen presenter adapted from AladdinsCastle's ACVRXR.cpp
+// (claude/supermodel-vr), with PCSX2 GLContext sharing, two eye-only chains,
+// explicit GPU hand-off fences, fixed swapchains and an OpenXR-disabled proof path.
+// Included by GS.cpp; all renderer switching happens only on the GS thread.
+#include "GS/Renderers/OpenGL/GLContext.h"
+#include "GS/Renderers/HW/GSTextureCache.h"
+#include "common/Error.h"
+#include "common/Image.h"
+#include "PerformanceMetrics.h"
+#include "Input/PS2VRGun.h"

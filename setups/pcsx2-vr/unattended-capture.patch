+  return DrainGL("after","glBlitFramebuffer / glFinish")==0;
+ }
+#ifdef _WIN32
+ // This is also used by the no-runtime proof. The compositor blends in array
+ // order; no game/HUD layer may be appended after the transparent controllers.
+ struct LayerList
+ {
+  const XrCompositionLayerBaseHeader* layers[3]{};
+  const char* names[3]{};
+  u32 count=0;
+ };
+ static LayerList ComposeLayers(bool inside,bool complete,const XrCompositionLayerQuad* quads,
+  const XrCompositionLayerProjection& scene,const XrCompositionLayerProjection* overlay)
+ {
+  LayerList result;
+  if (!complete) return result;
+  if (inside) { result.layers[result.count]=reinterpret_cast<const XrCompositionLayerBaseHeader*>(&scene); result.names[result.count++]="scene-and-HUD-panel"; }
+  else for (int eye=0;eye<2;eye++) { result.layers[result.count]=reinterpret_cast<const XrCompositionLayerBaseHeader*>(&quads[eye]); result.names[result.count++]=eye?"screen-right":"screen-left"; }
+  if (overlay) { result.layers[result.count]=reinterpret_cast<const XrCompositionLayerBaseHeader*>(overlay); result.names[result.count++]="gun-then-aim-dot"; }
+  return result;
+ }
+ static void RecordLayerOrder(const LayerList& list,bool inside,const char* path,bool submitted)
+ {
+  if (live_log) {
+   std::fprintf(live_log,"Composition %s mode=%s back-to-front:",submitted?"submitted":"offline-proof",inside?"inside":"screen");
+   for(u32 i=0;i<list.count;i++)std::fprintf(live_log," %u:%s(type=%d,flags=%llu)",i,list.names[i],list.layers[i]->type,static_cast<unsigned long long>(list.layers[i]->layerFlags));
+   std::fprintf(live_log,"; HUD panel belongs to base; gun/dot overlay has no composition depth extension\n"); std::fflush(live_log);
+  }
+  if (!path) return;
+  std::ofstream f(std::string(path)+(inside?"-inside-order.json":"-screen-order.json"));
+  f<<"{\n  \"submitted_to_runtime\": "<<(submitted?"true":"false")<<",\n  \"mode\": \""<<(inside?"inside":"screen")<<"\",\n  \"HUD_panel\": \"in base image, before controller overlay\",\n  \"order_back_to_front\": [\n";
+  for(u32 i=0;i<list.count;i++) { const auto* layer=list.layers[i];
+   f<<"    {\"name\": \""<<list.names[i]<<"\", \"type\": "<<layer->type<<", \"flags\": "<<layer->layerFlags<<", \"has_composition_depth\": "<<(layer->next?"true":"false")<<"}"<<(i+1<list.count?",":"")<<"\n";
+  }
+  f<<"  ]\n}\n";
+ }
+ static void SaveOverlayProof();
+#endif
+ static void SaveSharedProof()
+ {
+  if (!context->MakeCurrent()) { LiveLog("Proof shared context MakeCurrent failed"); return; }
+  LiveLog("OpenXR-disabled presenter thread has shared OpenGL context; no loader/runtime calls");
+  if (PS2VRGun::Enabled() && std::getenv("PCSX2_VR_GUN_MODEL_PROOF"))
+  {
+   PS2VRGun::Renderer model; std::string error;
+   DrainGL("before","gun model proof");
+   if (model.Init(error) && model.SaveProof(std::getenv("PCSX2_VR_GUN_MODEL_PROOF"),error)) LiveLog("Gun model trigger 0/1 GPU renders saved");
+   else LiveLog(("Gun model proof failed: "+error).c_str());
+   model.Shutdown(); DrainGL("after","gun model proof");
+  }
+#ifdef _WIN32
+  if (std::getenv("PCSX2_VR_LAYER_PROOF")) SaveOverlayProof();
+#endif
+  while (!stop)
+  {
+   std::unique_lock lock(mutex);
+   ready.wait(lock, []() { return stop || proof_pending; });
+   if (stop) break;
+   if (fence) glWaitSync(fence,0,GL_TIMEOUT_IGNORED);
+   DrainGL("after","shared fence wait");
+   const char* path=std::getenv("PCSX2_LIVE_SAVE_PATH");
+   if (path)
+   {
+    for (int eye=0; eye<2; eye++)
+    {
+     std::vector<u32> pixels(static_cast<size_t>(width)*height);
+     glGetTextureImage(eyes[eye],0,GL_RGBA,GL_UNSIGNED_BYTE,static_cast<GLsizei>(pixels.size()*4),pixels.data());
+     RGBA8Image image(width,height,std::move(pixels));
+     image.SaveToFile(fmt::format("{}-shared-{}.png",path,eye ? "right" : "left").c_str());
+    }
+    LiveLog("Presenter-thread readback saved from both shared GPU textures");
+   }
+   if (path && Env("PCSX2_OPENXR_TEST_BLIT",0)!=0)
+   {
+    // Exercise the actual fixed-size, sRGB swapchain-copy path without loading
+    // OpenXR. Compare the used GPU region to the flipped published pixels.
+    GLuint targets[2]{}, fbos[2]{};
+    glCreateTextures(GL_TEXTURE_2D,2,targets); glGenFramebuffers(2,fbos);
+    for (GLuint target:targets) glTextureStorage2D(target,1,GL_SRGB8_ALPHA8,CHAIN_WIDTH,CHAIN_HEIGHT);
+    glDisable(GL_FRAMEBUFFER_SRGB); glDisable(GL_SCISSOR_TEST);
+    const GSVector2i used=UsedExtent();
+    for (int eye=0;eye<2;eye++)

+     std::vector<u32> crop(static_cast<size_t>(used.x)*used.y);
+     for (int y=0;y<used.y;y++)
+     {
+      std::copy_n(result.data()+static_cast<size_t>(y)*CHAIN_WIDTH,used.x,crop.data()+static_cast<size_t>(y)*used.x);

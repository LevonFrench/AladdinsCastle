+      if (state==XR_SESSION_STATE_EXITING || state==XR_SESSION_STATE_LOSS_PENDING) stop=true;
+     }
+     if (ev.type==XR_TYPE_EVENT_DATA_INSTANCE_LOSS_PENDING) stop=true;
+     ev={XR_TYPE_EVENT_DATA_BUFFER};
+    }
+    if (stop) break;
+    if (!running) { std::this_thread::sleep_for(std::chrono::milliseconds(25)); continue; }
+    XrFrameWaitInfo wi{XR_TYPE_FRAME_WAIT_INFO}; XrFrameState fs{XR_TYPE_FRAME_STATE};
+    if (!Check(XRGL("xrWaitFrame", p_xrWaitFrame, session,&wi,&fs),"xrWaitFrame")) break;
+    XrFrameBeginInfo bi{XR_TYPE_FRAME_BEGIN_INFO}; if (!Check(XRGL("xrBeginFrame", p_xrBeginFrame, session,&bi),"xrBeginFrame")) break;
+    const bool home=(GetAsyncKeyState(VK_HOME)&0x8000)!=0;
+    if (!placed || (home && !home_down)) placed=PlaceScreen(fs.predictedDisplayTime,pose);
+    home_down=home;
+    if (placed) PublishInsidePose(fs.predictedDisplayTime);
+    float screen_width=0;
+    { std::lock_guard guard(mutex); screen_width=Env("PCSX2_OPENXR_DISTANCE_M",2.5f)*native_width/Env("PCSX2_STEREO_FOCAL_PX",320); }
+    const float screen_height=screen_width/Env("PCSX2_OPENXR_ASPECT",4.0f/3.0f);
+    PollGunActions(fs.predictedDisplayTime,focused,pose,screen_width,screen_height,placed && fs.shouldRender);
+    XrCompositionLayerQuad quads[2]{};
+    XrCompositionLayerProjection inside_layer{XR_TYPE_COMPOSITION_LAYER_PROJECTION};
+    XrCompositionLayerProjectionView inside_views[2]{{XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW},{XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW}};
+    const XrCompositionLayerBaseHeader* layers[3]{};
+    u32 count=0;
+    std::uint64_t submitted_inside_sequence=0;
+    if (fs.shouldRender && placed)
+    {
+     std::lock_guard guard(mutex);
+     if (serial && !EnsureChains()) retry_window=true;
+     if (serial && !retry_window)
+     {
+      if (fence) glWaitSync(fence,0,GL_TIMEOUT_IGNORED);

--- /dev/null
+++ b/pcsx2/Input/PS2VRGun.h
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-3.0+
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <cstdio>
+#include <cmath>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <vector>
+#include "GS/PS2VRAim.h"
+#include "Input/PS2VRStickChord.h"
+#include "GS/PS2VRInside.h"
+namespace PS2VRGun {
+struct Sample { PS2VRAim::V scene_point;bool scene_point_valid=false,scene_hit=false,scene_panel=false;float u=0.5f, v=0.5f, trigger=0; bool on_screen=false, active=false, a=false, b=false, grip=false, controls_active=false, select=false, start=false, l3=false, r3=false; };
+inline std::mutex mailbox_mutex;
+inline Sample mailbox;
+inline std::chrono::steady_clock::time_point published_at;
+inline std::atomic<std::uint64_t> frame_clock{0}, shot_serial{0};
+inline std::atomic<bool> quit_requested{false};
+// U4 (both stick clicks held 3 s) comes from StickChord on the presenter thread.
+inline void RequestQuit() {
+ quit_requested.store(true,std::memory_order_release);
+ std::fprintf(stderr,"VR both stick clicks held 3 seconds: graceful quit requested (memory cards flush on shutdown).\n");
+}
+// Offline proof: feeds both clicks to a private StickChord, so it exercises the same 3 s timer.
+inline bool UpdateQuitHold(bool pressed,std::chrono::steady_clock::time_point now=std::chrono::steady_clock::now()) {
+ static StickChord proof;
+ if(!proof.Update(pressed,pressed,now).quit)return false;
+ RequestQuit();return true;
+}
+inline bool ConsumeQuit(){return quit_requested.exchange(false,std::memory_order_acq_rel);}
+inline bool Enabled() { static const bool enabled=[] { const char* e=std::getenv("PCSX2_VR_GUN"); return e && std::string(e)=="1"; }(); return enabled; }
+inline float EnvFloat(const char* key,float fallback) { const char* e=std::getenv(key); if (!e) return fallback; char* end; float v=std::strtof(e,&end); return end!=e && *end==0 && std::isfinite(v) ? v : fallback; }
+// Light-sensor emulation: a real GunCon 2 reports (0,0) while it sees a black
+// picture. Time Crisis calibration shows one black frame after the shot and
+// waits for that report. The GS thread latches whether the displayed frame is
+// a black clear/blank; the USB thread reads it. Needs proper testing per game.
+inline std::atomic<bool> display_dark{false};
+inline std::atomic<std::uint64_t> dark_displays{0};
+inline bool LightSense() { static const bool on=EnvFloat("PCSX2_VR_GUN_LIGHT_SENSE",1)!=0; return on; }
+inline void SetDisplayDark(bool dark) {
+ if(display_dark.exchange(dark,std::memory_order_acq_rel)!=dark && dark) dark_displays.fetch_add(1,std::memory_order_acq_rel);
+}
+inline bool DisplayDark() { return display_dark.load(std::memory_order_acquire); }
+// After a delivered trigger edge the GS also samples five small blocks of the
+// displayed picture for this many frames, because games may draw their black
+// frame with sprites rather than a clear (Crisis Zone). Bounded readback cost.
+inline std::atomic<int> sense_armed{0};
+inline void ArmLightSense() { sense_armed.store(45,std::memory_order_release); }
+// INSIDE: rays that hit no retained world triangle map through the stationary
+// picture panel (same quad mapping as screen mode). 0 restores the old 100m point.
+inline float InsidePanelDistance() {
+ static const float d=EnvFloat("PCSX2_INSIDE_GUN_PANEL",1)!=0 ? EnvFloat("PCSX2_INSIDE_HUD_DISTANCE_M",2.5f) : 0.f; return d;
+}
+// Native L3/R3 for the PS2 pad: left Y = L3, left X = R3 (the stick clicks belong to U1-U4). PCSX2_VR_L3R3=0 turns them off.
+inline bool L3R3Enabled() { const char* e=std::getenv("PCSX2_VR_L3R3"); return !e || std::string(e)!="0"; }
+inline bool MenuEnabled() { const char* e=std::getenv("PCSX2_VR_CONTROLLERS"); return e ? std::string(e)=="1" : Enabled(); }
+inline void Publish(const Sample& sample) { std::lock_guard<std::mutex> lock(mailbox_mutex); mailbox=sample; published_at=std::chrono::steady_clock::now(); }
+// Parent ticks the 60 Hz emulation/presentation timeline, never wall time.
+inline void Tick(std::uint64_t frame) { frame_clock.store(frame, std::memory_order_release); }
+inline std::uint64_t ShotSerial() { return shot_serial.load(std::memory_order_acquire); }
+inline void AcknowledgeShot() { shot_serial.fetch_add(1, std::memory_order_release); }
+inline Sample Snapshot() {
+ Sample s; { std::lock_guard<std::mutex> lock(mailbox_mutex); s=mailbox; if (std::chrono::steady_clock::now()-published_at>std::chrono::milliseconds(500)) s={}; }
+ struct Event { double seconds; float u,v,trigger; };
+ static const auto events=[] {
+  std::vector<Event> result;
+  const char* text=std::getenv("PCSX2_VR_GUN_SCRIPT"); if (!text || !*text) return result;
+  const char* xr=std::getenv("PCSX2_OPENXR");
+  if (!xr || std::string(xr)!="0") { std::fprintf(stderr,"VR gun script rejected: requires PCSX2_OPENXR=0.\n"); return result; }
+  std::istringstream input(text); std::string entry;
+  while (std::getline(input,entry,';')) {
+   Event e; char trailing;
+   if (std::sscanf(entry.c_str(),"%lf:%f:%f:%f %c",&e.seconds,&e.u,&e.v,&e.trigger,&trailing)!=4 || !std::isfinite(e.seconds) || e.seconds<0 || e.seconds>7200 || !std::isfinite(e.u) || !std::isfinite(e.v) || !std::isfinite(e.trigger) || e.trigger<0 || e.trigger>1 || result.size()>=256) { std::fprintf(stderr,"Invalid VR gun script event: %s\n",entry.c_str()); continue; }
+   result.push_back(e);
+  }
+  std::fprintf(stderr,"VR gun script: %zu quarter-second ray pulses on 60-Hz frame clock.\n",result.size()); return result;
+ }();
+ if (!events.empty()) {
+  s={}; const double now=frame_clock.load(std::memory_order_acquire)/60.0;
+  for (const auto& e:events) if (now>=e.seconds && now<e.seconds+0.25) {
+   const char* script_space=std::getenv("PCSX2_VR_GUN_SCRIPT_SPACE");
+   // "hand": a held gun below/right of the eyes, barrel aimed AT what the eye
+   // sees at picture (u,v) (screen quad, panel or world). Offset in metres.
+   const bool hand_space=script_space && std::string(script_space)=="hand";
+   PS2VRAim::V hand{EnvFloat("PCSX2_VR_GUN_SCRIPT_HAND_X",.18f),EnvFloat("PCSX2_VR_GUN_SCRIPT_HAND_Y",-.30f),EnvFloat("PCSX2_VR_GUN_SCRIPT_HAND_Z",-.25f)};
+   const PS2VRAim::V screen_target{(e.u-.5f)*5,(.5f-e.v)*3.75f,-2.5f};
+   const PS2VRAim::V screen_origin=hand_space ? hand : PS2VRAim::V{};
+   const auto hit=PS2VRAim::Intersect(screen_origin,screen_target-screen_origin,{0,0,-2.5f},{},5,3.75f);
+   s.u=hit.u; s.v=hit.v; s.on_screen=hit.on_screen; s.trigger=e.trigger; s.active=true;
+   if(PS2VRInside::Enabled()) {
+    const float cw=PS2VRInside::Env("PCSX2_INSIDE_CANVAS_WIDTH",640),ch=PS2VRInside::Env("PCSX2_INSIDE_CANVAS_HEIGHT",448);
+    const float fx=PS2VRInside::Env("PCSX2_STEREO_FOCAL_PX",320),fy=PS2VRInside::Env("PCSX2_INSIDE_FY",fx*ch/(cw*.75f));
+    const float yaw=PS2VRInside::Env("PCSX2_INSIDE_FAKE_YAW_DEG",0)*.017453292519943295f;
+    const PS2VRAim::Q head{0,std::sin(yaw*.5f),0,std::cos(yaw*.5f)};
+    const bool head_space=script_space && std::string(script_space)=="head";
+    PS2VRAim::V origin=head_space ? PS2VRAim::Rotate(head,{.12f,-.13f,-.42f}) : PS2VRAim::V{};
+    PS2VRAim::V direction{(e.u-.5f)*cw/fx,(.5f-e.v)*ch/fy,-1};
+    if(head_space)direction=PS2VRAim::Rotate(head,direction);
+    else if(hand_space) {
+     // What the viewer sees at (u,v): nearest world triangle, else the panel.
+     const auto seen=PS2VRAim::Inside({},direction,{cw,ch,fx,fy},100.f,PS2VRInside::Env("PCSX2_INSIDE_HUD_DISTANCE_M",2.5f));
+     origin=PS2VRAim::Rotate(head,hand);direction=seen.point-origin;
+    }
+    else direction=direction*100.f-origin;
+    const auto scene=PS2VRAim::Inside(origin,direction,{cw,ch,fx,fy},100.f,InsidePanelDistance());
+    s.u=scene.picture.u;s.v=scene.picture.v;s.on_screen=scene.picture.on_screen;
+    s.scene_point=scene.point;s.scene_point_valid=std::isfinite(scene.point.x+scene.point.y+scene.point.z)&&scene.point.z<-.001f;s.scene_hit=scene.geometry;s.scene_panel=scene.panel;
+   }
+
+  }
+ }
+
+ // Hidden deterministic menu proof shares the mailbox and normal pointer dispatch.
+ // Independent from ray events so menu controls never need a tracked aim pose.
+ struct MenuEvent { double seconds; unsigned button; };
+ static const auto menu_events=[] {
+  std::vector<MenuEvent> result;
+  const char* text=std::getenv("PCSX2_VR_MENU_SCRIPT"); if (!text || !*text) return result;
+  const char* xr=std::getenv("PCSX2_OPENXR");
+  if (!xr || std::string(xr)!="0") { std::fprintf(stderr,"VR menu script rejected: requires PCSX2_OPENXR=0.\n"); return result; }
+  std::istringstream input(text); std::string entry;
+  while (std::getline(input,entry,';')) {
+   double seconds; char name[32],trailing;
+   if (std::sscanf(entry.c_str(),"%lf:%31s %c",&seconds,name,&trailing)!=2 || !std::isfinite(seconds) || seconds<0 || seconds>7200 || result.size()>=256) continue;
+   const std::string button(name);
+   if (button=="Select" || button=="Start" || button=="L3" || button=="R3") result.push_back({seconds,button=="Select" ? 12u : button=="Start" ? 13u : button=="L3" ? 14u : 15u});
+  }
+  std::fprintf(stderr,"VR menu script: %zu quarter-second pointer pulses on 60-Hz frame clock.\n",result.size()); return result;
+ }();
+ if (!menu_events.empty()) {
+  s.controls_active=true; s.select=s.start=s.l3=s.r3=false;
+  const double now=frame_clock.load(std::memory_order_acquire)/60.0;
+  for (const auto& e:menu_events) if (now>=e.seconds && now<e.seconds+.25) {
+   s.select|=e.button==12; s.start|=e.button==13; s.l3|=e.button==14; s.r3|=e.button==15;
+  }
+ }
+ return s;
+}
+inline float Setting(const char* key, float fallback) { const char* e=std::getenv(key); if (!e) return fallback; char* end; float v=std::strtof(e,&end); return end!=e && *end==0 && std::isfinite(v) ? v : fallback; }
+}
diff --git a/pcsx2/Input/PS2VRStickChord.h b/pcsx2/Input/PS2VRStickChord.h
new file mode 100644
--- /dev/null
+++ b/pcsx2/Input/PS2VRStickChord.h
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-3.0+
+#pragma once
+#include <algorithm>
+#include <chrono>
+namespace PS2VRGun {
+// Universal controls U1-U4 (stick clicks only, same in every host):
+//   lone left click = Start, lone right click = Select,
+//   both clicks together = recentre (released within 1 s) or quit (held 3 s).
+// A click waits up to 150 ms for the other one. If it comes, the pair is a
+// chord and neither Start nor Select is sent. Otherwise the click is sent as
+// pressed for as long as it stays held. A tap shorter than the wait is
+// stretched to a short pulse so the game still sees it.
+struct StickChord {
+ using Clock=std::chrono::steady_clock;
+ using Time=Clock::time_point;
+ static constexpr std::chrono::milliseconds window{150},tap_pulse{100},recentre_limit{1000},quit_hold{3000};
+ struct Output { bool start=false,select=false,recentre=false,quit=false; };
+ struct Side { bool down=false,lone=false;Time pressed{},lone_at{},pulse_until{}; };
+ Side side[2]; // 0 = left click (Start), 1 = right click (Select)
+ bool chord=false,broken=false,quit_fired=false;
+ Time chord_since{};
+ void Reset(){*this=StickChord{};}
+ // Call every poll, also while nothing is pressed. Recentre and quit are
+ // one-poll edges; start and select are levels.
+ Output Update(bool left,bool right,Time now) {
+  Output out;
+  const bool input[2]={left,right};
+  for(int i=0;i<2;i++) {
+   Side& s=side[i];const Side& other=side[1-i];
+   if(input[i] && !s.down) {
+    s.down=true;s.lone=false;s.pressed=now;s.pulse_until={};
+    // Second click within the wait while the first is still held and unresolved.
+    if(!chord && other.down && !other.lone && now-other.pressed<=window) {
+     chord=true;broken=quit_fired=false;chord_since=now;
+     side[0].lone=side[1].lone=false;side[0].pulse_until=side[1].pulse_until={};
+    }
+   }
+  }
+  for(int i=0;i<2;i++) {
+   Side& s=side[i];
+   if(!input[i] && s.down) {
+    s.down=false;
+    if(chord) {
+     if(!quit_fired)broken=true; // one click up ends the quit countdown
+    }
+    else if(s.lone) s.pulse_until=std::max(now,s.lone_at+tap_pulse); // held at least the wait
+    else s.pulse_until=now+tap_pulse; // tapped before the wait ended
+   }
+  }
+  if(chord) {
+   const bool both=side[0].down && side[1].down;
+   if(!both)broken=true;
+   if(both && !broken && !quit_fired && now-chord_since>=quit_hold){quit_fired=true;out.quit=true;}
+   if(!side[0].down && !side[1].down) {
+    // Both released: recentre only for a quick pair, never after the quit hold.
+    out.recentre=!quit_fired && now-chord_since<=recentre_limit;
+    chord=broken=quit_fired=false;
+   }
+   return out;
+  }
+  for(int i=0;i<2;i++) {
+   Side& s=side[i];
+   if(s.down && !s.lone && now-s.pressed>window){s.lone=true;s.lone_at=now;}
+  }
+  out.start=(side[0].down && side[0].lone) || now<side[0].pulse_until;
+  out.select=(side[1].down && side[1].lone) || now<side[1].pulse_until;
+  return out;
+ }
+};
+}
diff --git a/pcsx2/GS/PS2VRBackendPolicy.h b/pcsx2/GS/PS2VRBackendPolicy.h
new file mode 100644
--- /dev/null
+++ b/pcsx2/GS/PS2VRBackendPolicy.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <chrono>
+namespace PS2VRBackend {
+enum class WaitResult { ready, stopped, deadline, error };
+// Same finite-wait policy as the Model 2 viewer. An acquired image survives
+// timeout frames; it must not be released until a wait actually succeeds.
+template<class Wait, class Stop, class Clock>
+WaitResult WaitImage(Wait wait, Stop stop, Clock clock)
+{
+ const auto deadline=clock()+std::chrono::milliseconds(250);
+ while (!stop()) {
+  const auto result=wait(10000000LL);
+  if (result==0) return stop()?WaitResult::stopped:WaitResult::ready;
+  if (result!=1) return WaitResult::error;
+  if (clock()>=deadline) return WaitResult::deadline;
+ }
+ return WaitResult::stopped;
+}
+template<class Wait, class Stop>
+WaitResult WaitImage(Wait wait, Stop stop)
+{
+ return WaitImage(wait,stop,[] {return std::chrono::steady_clock::now();});
+}
+
+}
diff --git a/pcsx2/GS/PS2VRScreenDepth.h b/pcsx2/GS/PS2VRScreenDepth.h
new file mode 100644
--- /dev/null
+++ b/pcsx2/GS/PS2VRScreenDepth.h
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: GPL-3.0+
+#pragma once
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+namespace PS2VRScreenDepth {
+inline bool Enabled(){static const bool enabled=[] {const char* v=std::getenv("PCSX2_STEREO_RUNTIME_IPD");return v && std::strcmp(v,"1")==0;}();return enabled;}
+inline std::int64_t Now(){return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();}
+inline std::atomic<float> baseline{0};
+inline std::atomic<std::int64_t> stamp{0};
+inline void Invalidate(){baseline.store(0,std::memory_order_relaxed);stamp.store(0,std::memory_order_release);}
+inline bool Publish(const std::array<float,3>& left,const std::array<float,3>& right,bool tracked,std::int64_t now=Now()){
+ if(!Enabled() || !tracked){Invalidate();return false;}
+ float squared=0;
+ for(unsigned i=0;i<3;i++){
+  if(!std::isfinite(left[i]) || !std::isfinite(right[i])){Invalidate();return false;}
+  const float delta=right[i]-left[i];squared+=delta*delta;
+ }
+ const float metres=std::sqrt(squared);
+ if(!std::isfinite(metres) || metres<.02f || metres>.12f){Invalidate();return false;}
+ baseline.store(metres,std::memory_order_relaxed);stamp.store(now,std::memory_order_release);return true;
+}
+inline float Sample(float configured,std::int64_t now=Now()){
+ const auto time=stamp.load(std::memory_order_acquire);const float metres=baseline.load(std::memory_order_relaxed);
+ return time>0 && now>=time && now-time<500 && metres>=.02f && metres<=.12f ? metres:configured;
+}
+struct FrameSample {std::uint64_t frame=0;float metres=0;bool valid=false;};
+inline thread_local FrameSample sample;
+// GS thread: one value for every draw/eye of this emulated frame. Runtime
+// updates cannot change the baseline halfway through an eye pair.
+inline float Select(float configured,bool inside,std::uint64_t frame,std::int64_t now=Now()){
+ if(!Enabled() || inside)return configured;
+ if(!sample.valid || frame!=sample.frame){sample={frame,Sample(configured,now),true};}
+ return sample.metres;
+}
+inline void Reset(){Invalidate();sample={};}
+}

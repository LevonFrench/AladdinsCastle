+ // OFFLINE ONLY (PCSX2_OPENXR=0): stands in for the headset presenter. It
+ // generates a swinging head pose at the headset rate, publishes it exactly
+ // like the OpenXR path, and does the same per-frame GPU work (fence wait,
+ // both eye blits into recommended-size targets, glFinish). Logs which pair
+ // and which pose each simulated display frame showed.
+ static void SyntheticPresenter(float amplitude_deg)
+ {
+  LiveLog("OFFLINE synthetic head and presenter: generated poses, NOT tracked; no loader/runtime calls");
+  const float hz=std::clamp(Env("PCSX2_INSIDE_TEST_HZ",90),30.f,240.f);
+  const float period=std::max(.1f,Env("PCSX2_INSIDE_TEST_HEAD_PERIOD_S",2));
+  const float tx=Env("PCSX2_INSIDE_TEST_TAN_X",1.0f), ty=Env("PCSX2_INSIDE_TEST_TAN_Y",1.037f);
+  GLuint targets[2]{}, fbos[2]{};
+  glCreateTextures(GL_TEXTURE_2D,2,targets); glGenFramebuffers(2,fbos);
+  for(int eye=0;eye<2;eye++)glTextureStorage2D(targets[eye],1,GL_SRGB8_ALPHA8,chain_extent[eye].x,chain_extent[eye].y);
+  glDisable(GL_FRAMEBUFFER_SRGB); glDisable(GL_SCISSOR_TEST);
+  using clock=std::chrono::steady_clock;
+  const auto start=clock::now(); const auto step=std::chrono::nanoseconds(static_cast<long long>(1e9/hz));
+  auto next=start; std::uint64_t sequence=0; unsigned long last_serial=0;
+  struct Window { unsigned long frames=0,fresh=0,again=0,late=0,max_age=0; double age=0,work=0,max_work=0; } window, total;
+  auto report=[&](const char* what,const Window& w) {
+   if(!live_log || !w.frames)return;
+   std::fprintf(live_log,"%s: frames=%lu new_pairs=%lu repeated_pairs=%lu late_frames=%lu pose_age_ms_avg=%.2f pose_age_ms_max=%.2f present_ms_avg=%.3f present_ms_max=%.3f hz=%.0f\n",
+    what,w.frames,w.fresh,w.again,w.late,w.age/w.frames*1000.0/hz,w.max_age*1000.0/hz,w.work/w.frames,w.max_work,hz); std::fflush(live_log);
+  };
+  auto fold=[](Window& into,const Window& from) {
+   into.frames+=from.frames;into.fresh+=from.fresh;into.again+=from.again;into.late+=from.late;into.age+=from.age;
+   into.max_age=std::max(into.max_age,from.max_age);into.work+=from.work;into.max_work=std::max(into.max_work,from.max_work);
+  };
+  while(!stop)
+  {
+   const double seconds=std::chrono::duration<double>(clock::now()-start).count();
+   const float yaw=amplitude_deg*0.017453292519943295f*static_cast<float>(std::sin(6.283185307179586*seconds/period));
+   PS2VRInside::Publish(PS2VRInside::Synthetic(yaw,{-tx,tx,-ty,ty},++sequence,static_cast<std::int64_t>((seconds+1.0/hz)*1e9)));
+   const auto work_start=clock::now();
+   unsigned long shown=0; std::uint64_t shown_pose=0;
+   {
+    std::lock_guard guard(mutex);
+    if(serial) {
+     shown=serial; shown_pose=published_inside.sequence;
+     if (fence) glWaitSync(fence,0,GL_TIMEOUT_IGNORED);
+     for(int eye=0;eye<2;eye++)BlitEye(eye,targets[eye],fbos[0],fbos[1],UsedExtent(eye));
+     if(consumer_fence)glDeleteSync(consumer_fence);
+     consumer_fence=glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE,0);glFlush();
+    }
+   }
+   glFinish();
+   const double ms=std::chrono::duration<double,std::milli>(clock::now()-work_start).count();
+   if(shown) {
+    window.frames++; window.work+=ms; window.max_work=std::max(window.max_work,ms);
+    if(shown!=last_serial)window.fresh++; else window.again++;
+    last_serial=shown;
+    const unsigned long a=shown_pose && sequence>shown_pose ? static_cast<unsigned long>(sequence-shown_pose) : 0;
+    window.age+=a; window.max_age=std::max(window.max_age,a);
+   }
+   if(proof_pending)ServiceProof();
+   next+=step;
+   const auto now=clock::now();
+   if(now>next+step) { window.late++; next=now; }
+   else std::this_thread::sleep_until(next);
+   if(window.frames>=static_cast<unsigned long>(hz*5)) { report("Synthetic presenter 5s",window); fold(total,window); window={}; }
+  }
+  fold(total,window);
+  report("Synthetic presenter total",total);
+  glDeleteFramebuffers(2,fbos); glDeleteTextures(2,targets);
+ }
+ static void SaveSharedProof()
+ {
+  if (!context->MakeCurrent()) { LiveLog("Proof shared context MakeCurrent failed"); return; }
+  LiveLog("OpenXR-disabled presenter thread has shared OpenGL context; no loader/runtime calls");
+  if(Env("PCSX2_OPENXR_TEST_SLOW_WAIT",0)!=0) {
+   unsigned long before=0,after=0;
+   {std::unique_lock guard(mutex);ready.wait_for(guard,std::chrono::seconds(5),[] {return serial>0 || stop.load();});before=serial;}
+   const auto waited=PS2VRBackend::WaitImage([](long long timeout) {
+    std::this_thread::sleep_for(std::chrono::nanoseconds(timeout));return 1;
+   },[] {return stop.load();});
+   {std::lock_guard guard(mutex);after=serial;}
+   const auto resumed=PS2VRBackend::WaitImage([](long long) {return 0;},[] {return stop.load();});
+   if(live_log) {std::fprintf(live_log,"OFFLINE simulated swapchain timeout: before=%lu after=%lu deadline=%d resumed=%d; no runtime calls\n",before,after,waited==PS2VRBackend::WaitResult::deadline,resumed==PS2VRBackend::WaitResult::ready);std::fflush(live_log);}
+  }
+
+  // Synthetic recommendation is explicitly restricted to the no-loader path.
+  if(PS2VRInside::Enabled() && Env("PCSX2_OPENXR",0)==0 && Env("PCSX2_INSIDE_TEST_EYE_WIDTH",0)>0 && Env("PCSX2_INSIDE_TEST_EYE_HEIGHT",0)>0) {

+	// ACVR: scripted button presses for unattended test runs, so no key or mouse is needed.
+	// ACVR_PRESS="6:8;14:8" presses mask 8 (Start) on port 0 at 6 s and 14 s of game time,
+	// each held for a quarter of a second.
+	{
+		static std::vector<std::pair<double, u32>> presses;
+		static bool parsed = false;
+		if (!parsed)
+		{
+			parsed = true;
+			if (const char *s = getenv("ACVR_PRESS"))
+			{
+				double at; unsigned mask; int used;
+				while (sscanf(s, "%lf:%u%n", &at, &mask, &used) == 2)
+				{
+					presses.emplace_back(at, (u32)mask);
+					s += used;
+					if (*s != ';')
+						break;
+					s++;
+				}
+			}
+		}
+		const double now = gameSeconds() - startedAt;
+		for (const auto& press : presses)
+		{
+			if (now >= press.first && now < press.first + 0.25)
+				kcode[0] &= ~press.second;
+			else if (now >= press.first + 0.25 && now < press.first + 0.35)
+				kcode[0] |= press.second;
+		}
+	}
 	const int every = config::VrDebugShots;
 	if (every <= 0)
 		return;

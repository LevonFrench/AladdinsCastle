@@ -688,11 +696,34 @@ static void hideLetterbox(rend_context& ctx, const std::vector<PolyParam>& list,
 {
 	if (activeProfile != nullptr && activeProfile->letterboxW > 0.f)
 		hudW = activeProfile->letterboxW;
+	// ACVR: with ACVR_LOG_BLACK set, log each new W at which the game draws a flat, opaque
+	// black polygon, to find a game's letterbox W for its profile.
+	static const bool logBlack = getenv("ACVR_LOG_BLACK") != nullptr;
+	static std::vector<int> loggedW;
 	for (u32 n = from; n < to && n < list.size(); n++)
 	{
 		const PolyParam& pp = list[n];
 		if (pp.count < 3 || pp.first + pp.count > ctx.verts.size())
 			continue;
+		if (logBlack && ctx.verts[pp.first].z > 0.f)
+		{
+			const float w0 = 1.f / ctx.verts[pp.first].z;
+			bool flatBlack = true;
+			float x0 = 1e9f, x1 = -1e9f, y0 = 1e9f, y1 = -1e9f;
+			for (u32 j = pp.first; j < pp.first + pp.count && flatBlack; j++)
+			{
+				const Vertex& v = ctx.verts[j];
+				flatBlack = v.z > 0.f && std::abs(1.f / v.z - w0) < 0.002f && opaqueBlack(v);
+				x0 = std::min(x0, v.x); x1 = std::max(x1, v.x); y0 = std::min(y0, v.y); y1 = std::max(y1, v.y);
+			}
+			const int key = (int)std::lround(w0 * 1000.f);
+			if (flatBlack && std::find(loggedW.begin(), loggedW.end(), key) == loggedW.end())
+			{
+				loggedW.push_back(key);
+				NOTICE_LOG(RENDERER, "VR: opaque black polygon at W %.4f (2D plane W %.4f), box %.0f,%.0f - %.0f,%.0f",
+						w0, hudW, x0, y0, x1, y1);
+			}
+		}
 		u32 i = pp.first;
 		while (i < pp.first + pp.count && onOverlay(ctx.verts[i], hudW) && opaqueBlack(ctx.verts[i]))
 			i++;

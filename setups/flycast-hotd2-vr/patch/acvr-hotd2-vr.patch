 namespace vr
@@ -36,6 +46,228 @@ void onEvent(Event event, void *)
 		lastShot = -1;
 		return;
 	}
+	// ACVR: scripted button presses for unattended test runs, so no key or mouse is needed.
+	// ACVR_PRESS="6:8;14:8" presses mask 8 (Start) on port 0 at 6 s and 14 s of game time,
+	// each held for a quarter of a second.
+	{
+		static std::vector<std::pair<double, u32>> presses;
+		static bool parsed = false;
+		if (!parsed)
+		{
+			parsed = true;
+			if (const char *s = getenv("ACVR_PRESS"))
+			{
+				double at; unsigned mask; int used;
+				while (sscanf(s, "%lf:%u%n", &at, &mask, &used) == 2)
+				{
+					presses.emplace_back(at, (u32)mask);
+					s += used;
+					if (*s != ';')
+						break;
+					s++;
+				}
+			}
+		}
+		const double now = gameSeconds() - startedAt;
+		for (const auto& press : presses)
+		{
+			if (now >= press.first && now < press.first + 0.25)
+				kcode[0] &= ~press.second;
+			else if (now >= press.first + 0.25 && now < press.first + 0.35)
+				kcode[0] |= press.second;
+		}
+	}
+	// ACVR: a scripted light gun for unattended aim and shot tests. ACVR_GUN="t:x:y:b;..."
+	// puts player 1's gun at x, y (1/10000ths of the screen, outside: off-screen) with the
+	// buttons b (lightgunSet's bits: 1 trigger, 2 reload, 4 start, 128 B) from game time t (s)
+	// until the next entry. Sent every frame, so the mouse stays out of it.
+	{
+		// (ACVR_GUN2: the same for player 2's gun)
+		struct GunStep { double at; int x, y; u32 buttons; };
+		static std::vector<GunStep> steps[2];
+		static bool parsed = false;
+		if (!parsed)
+		{
+			parsed = true;
+			for (int player = 0; player < 2; player++)
+				if (const char *s = getenv(player == 0 ? "ACVR_GUN" : "ACVR_GUN2"))
+				{
+					GunStep g; int used;
+					while (sscanf(s, "%lf:%d:%d:%u%n", &g.at, &g.x, &g.y, &g.buttons, &used) == 4)
+					{
+						steps[player].push_back(g);
+						s += used;
+						if (*s != ';')
+							break;
+						s++;
+					}
+				}
+		}
+		const double now = gameSeconds() - startedAt;
+		for (int player = 0; player < 2; player++)
+		{
+			const GunStep *cur = nullptr;
+			for (const GunStep& g : steps[player])
+				if (now >= g.at)
+					cur = &g;
+			if (cur != nullptr)
+				lightgunSet(player, cur->x, cur->y, cur->buttons);
+		}
+	}
+	// ACVR: snapshots at exact game times: ACVR_SNAP="t;t;..." (seconds) writes
+	// snap_<centiseconds>.png the first frame at or after each.
+	{
+		static std::vector<double> snaps;
+		static size_t nextSnap = 0;
+		static bool parsed = false;
+		if (!parsed)
+		{
+			parsed = true;
+			if (const char *s = getenv("ACVR_SNAP"))
+			{
+				double at; int used;
+				while (sscanf(s, "%lf%n", &at, &used) == 1)
+				{
+					snaps.push_back(at);
+					s += used;
+					if (*s != ';')
+						break;
+					s++;
+				}
+				std::sort(snaps.begin(), snaps.end());
+			}
+		}
+		const double now = gameSeconds() - startedAt;
+		while (nextSnap < snaps.size() && now >= snaps[nextSnap])
+		{
+			const int cs = (int)std::lround(snaps[nextSnap] * 100.0);
+			nextSnap++;
+			gui_runOnUiThread([cs]() {
+				std::vector<u8> rgb;
+				int w = 0, h = 0;
+				if (renderer == nullptr || !renderer->GetLastFrame(rgb, w, h) || w <= 0 || h <= 0)
+					return;
+				char name[32];
+				snprintf(name, sizeof(name), "snap_%06d.png", cs);
+				stbi_write_png(get_writable_data_path(name).c_str(), w, h, 3, rgb.data(), w * 3);
+			});
+		}
+	}
+	// ACVR: ACVR_RIP="t:count,every,ram;..." asks for a rip (vr_reproject.cpp ripRequested, PC with
+	// vr.Reproject) at game time t: count passes, every N, with the main RAM when ram is 1.
+	{
+		struct Rip { double at; unsigned count, every, ram; };
+		static std::vector<Rip> rips;
+		static size_t nextRip = 0;
+		static bool parsed = false;
+		if (!parsed)
+		{
+			parsed = true;
+			if (const char *s = getenv("ACVR_RIP"))
+			{
+				Rip r; int used;
+				while (sscanf(s, "%lf:%u,%u,%u%n", &r.at, &r.count, &r.every, &r.ram, &used) == 4)
+				{
+					rips.push_back(r);
+					s += used;
+					if (*s != ';')
+						break;
+					s++;
+				}
+			}
+		}
+		const double now = gameSeconds() - startedAt;
+		if (nextRip < rips.size() && now >= rips[nextRip].at)
+		{
+			if (FILE *f = fopen("rip.request", "w"))
+			{
+				fprintf(f, "%u %u %u\n", rips[nextRip].count, rips[nextRip].every, rips[nextRip].ram);
+				fclose(f);
+			}
+			nextRip++;
+		}
+	}
+	// ACVR: ACVR_WATCH="off:t,..." logs RAM values (offset hex from 0x8C000000; t: f float, h s16,
+	// w u32) whenever one changes, with the game time. ACVR_POKE="off:value,..." writes 16-bit
+	// values (hex offset, decimal value) every frame. To find and test a game's gun calibration.
+	{
+		struct Watch { u32 off; char type; u32 last; };
+		struct PokeW { u32 off; u16 value; };
+		static std::vector<Watch> watches;
+		static std::vector<PokeW> pokes;
+		static bool parsed = false;
+		if (!parsed)
+		{
+			parsed = true;
+			if (const char *s = getenv("ACVR_WATCH"))
+			{
+				unsigned off; char type; int used;
+				while (sscanf(s, "%x:%c%n", &off, &type, &used) == 2)
+				{
+					watches.push_back({ off & 0x00FFFFFFu, type, 0xDEADBEEFu });
+					s += used;
+					if (*s != ',')
+						break;
+					s++;
+				}
+			}
+			if (const char *s = getenv("ACVR_POKE"))
+			{
+				unsigned off; int value; int used;
+				while (sscanf(s, "%x:%d%n", &off, &value, &used) == 2)
+				{
+					pokes.push_back({ off & 0x00FFFFFFu, (u16)value });
+					s += used;
+					if (*s != ',')
+						break;
+					s++;
+				}
+			}
+		}
+		for (const PokeW& p : pokes)
+			if (ReadMem16_nommu(0x8C000000u + p.off) != p.value)
+				WriteMem16_nommu(0x8C000000u + p.off, p.value);
+		if (!watches.empty())
+		{
+			bool changed = false;
+			for (Watch& w : watches)
+			{
+				const u32 v = w.type == 'h' ? ReadMem16_nommu(0x8C000000u + w.off) : ReadMem32_nommu(0x8C000000u + w.off);
+				changed = changed || v != w.last;
+				w.last = v;
+			}
+			if (changed)
+			{
+				std::string line;
+				char buf[48];
+				for (const Watch& w : watches)
+				{
+					if (w.type == 'f') { float f; memcpy(&f, &w.last, 4); snprintf(buf, sizeof(buf), " %06x=%.3f", w.off, f); }
+					else if (w.type == 'h') snprintf(buf, sizeof(buf), " %06x=%d", w.off, (int)(s16)w.last);
+					else snprintf(buf, sizeof(buf), " %06x=%u", w.off, w.last);
+					line += buf;
+				}
+				NOTICE_LOG(COMMON, "ACVR watch t=%.3f%s", gameSeconds() - startedAt, line.c_str());
+			}
+		}
+	}
+	// ACVR: ACVR_QUIT=<seconds>: the run ends by itself at that game time (after the snapshots
+	// queued before it are written).
+	{
+		static double quitAt = -1.0;
+		static bool parsed = false, quitting = false;
+		if (!parsed)
+		{
+			parsed = true;
+			if (const char *s = getenv("ACVR_QUIT"))
+				quitAt = atof(s);
+		}
+		if (quitAt > 0.0 && !quitting && gameSeconds() - startedAt >= quitAt)
+		{
+			quitting = true;
+			gui_runOnUiThread([]() { dc_exit(); });
+		}
+	}
 	const int every = config::VrDebugShots;
 	if (every <= 0)
 		return;

+	// puts player 1's gun at x, y (1/10000ths of the screen, outside: off-screen) with the
+	// buttons b (lightgunSet's bits: 1 trigger, 2 reload, 4 start, 128 B) from game time t (s)
+	// until the next entry. Sent every frame, so the mouse stays out of it.
+	{
+		// (ACVR_GUN2: the same for player 2's gun)
+		struct GunStep { double at; int x, y; u32 buttons; };
+		static std::vector<GunStep> steps[2];
+		static bool parsed = false;
+		if (!parsed)
+		{
+			parsed = true;
+			for (int player = 0; player < 2; player++)
+				if (const char *s = getenv(player == 0 ? "ACVR_GUN" : "ACVR_GUN2"))
+				{
+					GunStep g; int used;
+					while (sscanf(s, "%lf:%d:%d:%u%n", &g.at, &g.x, &g.y, &g.buttons, &used) == 4)
+					{
+						steps[player].push_back(g);
+						s += used;
+						if (*s != ';')

+// Asks the runtime for the headset's highest refresh rate, or for the highest one not above
+// vr.XrRefreshRate when that is set. The head pose is redrawn every headset frame, so a higher
+// rate is smoother even though the game itself runs at 60. Runtimes without
+// XR_FB_display_refresh_rate (SteamVR on PC) keep the rate chosen in their own settings.
+static void requestBestRefreshRate()
+{
+	const float limit = (float)config::VrXrRefreshRate;
+	float chosen = limit;
+	uint32_t count = 0;
+	if (enumerateRefreshRates && XR_SUCCEEDED(enumerateRefreshRates(session, 0, &count, nullptr)) && count > 0)
+	{
+		std::vector<float> rates(count);
+		if (XR_SUCCEEDED(enumerateRefreshRates(session, count, &count, rates.data())))
+		{

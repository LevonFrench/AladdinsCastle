+++ b/src/mame/sega/model2_input.h
@@ -0,0 +1,13 @@
+// license:BSD-3-Clause
+#ifndef MAME_SEGA_MODEL2_INPUT_H
+#define MAME_SEGA_MODEL2_INPUT_H
+#include <algorithm>
+#include <cmath>
+namespace model2_input {
+inline unsigned coordinate(float normalized, unsigned minimum, unsigned maximum, bool off_screen)
+{
+ if (off_screen || !std::isfinite(normalized)) return minimum;
+ return minimum + unsigned(std::lround(std::clamp(normalized,0.0f,1.0f)*(maximum-minimum)));
+}
+}
+#endif
diff --git a/src/mame/sega/model2_stereo.h b/src/mame/sega/model2_stereo.h
new file mode 100644
--- /dev/null
+++ b/src/mame/sega/model2_stereo.h
@@ -0,0 +1,40 @@
+// license:BSD-3-Clause
+#ifndef MAME_SEGA_MODEL2_STEREO_H
+#define MAME_SEGA_MODEL2_STEREO_H
+
+#include <cmath>
+#include <cstdlib>
+
+namespace model2_stereo {
+
+inline double setting(const char *name, double fallback, double minimum, double maximum)
+{
+	const char *text = std::getenv(name);
+	if (!text || !*text)
+		return fallback;
+	char *end = nullptr;
+	const double value = std::strtod(text, &end);
+	return end != text && !*end && std::isfinite(value) && value >= minimum && value <= maximum ? value : fallback;
+}
+
+struct settings
+{
+	bool enabled = setting("ACVR_M2_STEREO", 0, 0, 1) == 1;
+	double separation_m = setting("ACVR_M2_IPD_M", 0.064, 0, 0.2);
+	double units_per_m = setting("ACVR_M2_UNITS_PER_M", 1, 0.001, 1000000);
+	double zero_m = setting("ACVR_M2_ZERO_M", 4, 0.01, 1000000);
+
+	double eye(int index) const { return (index ? 0.5 : -0.5) * separation_m * units_per_m; }
+	double zero() const { return zero_m * units_per_m; }
+};
+
+// x has already been multiplied by the game's focal length. Translate the
+// parallel camera before dividing by z; the last term shifts the frustum so
+// points on the zero-parallax plane stay in the same screen position.
+inline float focused_x(float x, float z, float focal, double eye, double zero)
+{
+	return float(x + focal * eye * (z / zero - 1.0));
+}
+
+} // namespace model2_stereo
+#endif

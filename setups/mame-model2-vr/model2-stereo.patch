+
+// The right VR controller becomes the cabinet's own control, as listed per
+// game in model2_input.h. Overrides go into the game's original input fields,
+// so the serial gun mux, the off-screen border/reload test and the analog
+// ports all read them normally. No list entry or no viewer means no overrides.
+void model2_state::stereo_controls_update()
+{
+	if (!m_stereo_map_checked)
+	{
+		m_stereo_map_checked = true;
+		m_stereo_map = model2_input::find(machine().system().name, machine().system().parent);
+		osd_printf_info("Model 2 controller map: %s\n", m_stereo_map ? m_stereo_map->name : "none (view only)");
+	}
+	const model2_input::game_map *map = m_stereo_map;
+	if (!map)
+		return;
+	auto digital = [this](const model2_input::input_bit &bit) -> ioport_field * {
+		ioport_port *port = bit.port ? ioport(bit.port) : nullptr;
+		return port ? port->field(bit.mask) : nullptr;
+	};
+	auto analog = [this](const char *tag) -> ioport_field * {
+		ioport_port *port = tag ? ioport(tag) : nullptr;
+		return port ? port->fields().first() : nullptr;
+	};
+	const bool h_pattern = map->shifter == model2_input::gears::h_pattern;
+	ioport_field *const start = digital(map->start), *const coin = digital({"IN0", 0x01});
+	ioport_field *const trigger = digital(map->trigger);
+	ioport_field *const grip_r = h_pattern ? nullptr : digital(map->grip_right);
+	ioport_field *const grip_l = h_pattern ? nullptr : digital(map->grip_left);
+	ioport_field *const aim_x = analog(map->aim_x), *const aim_y = analog(map->aim_y);
+	ioport_field *const steer = analog(map->steer), *const accel = analog(map->accel), *const brake = analog(map->brake);
+	ioport_field *gears[5] = {};
+	if (h_pattern)
+		for (int gear = 1; gear <= 4; ++gear)
+			gears[gear] = digital({"GEARS", 1u << gear});
+
+	model2_frames::controls input{};
+	bool active = false;
+	if (m_stereo_script)
+	{
+		const model2_script::ScriptState step = m_stereo_script->at(machine().time().as_double());
+		input.valid = 1; input.u = step.u; input.v = step.v; input.off_screen = step.off; input.trigger = step.trigger;
+		input.start = step.start; input.coin = step.coin; input.steer = step.steer; input.accel = step.accel; input.brake = step.brake;
+		input.buttons = (step.gripr ? 1u : 0u) | (step.gripl ? 2u : 0u); input.snapshot_request = step.snaps;
+		active = true;
+	}
+	else
+		active = m_stereo_stream->read_controls(input) && model2_frames::publisher::fresh(input);
+	ioport_field *const all[] = {start, coin, trigger, grip_r, grip_l, aim_x, aim_y, steer, accel, brake, gears[1], gears[2], gears[3], gears[4]};
+	if (active)
+	{
+		bool off_screen = input.off_screen != 0;
+		const float u = model2_input::untrim(model2_input::from_wide(input.u, m_stereo.wide, 496, off_screen), map->trim[0], map->trim[1]);
+		const float v = model2_input::untrim(input.v, map->trim[2], map->trim[3]);
+		if (aim_x && aim_y)
+		{
+			if (map->type == model2_input::kind::light_gun)
+			{
+				aim_x->set_value(model2_input::coordinate(u, aim_x->minval(), aim_x->maxval(), off_screen));
+				aim_y->set_value(model2_input::coordinate(v, aim_y->minval(), aim_y->maxval(), off_screen));
+			}
+			else
+			{
+				// A turret or a stick has no off-screen: it stops at its end.
+				aim_x->set_value(model2_input::analog(u, aim_x->minval(), aim_x->maxval(), aim_x->analog_reverse()));
+				aim_y->set_value(model2_input::analog(v, aim_y->minval(), aim_y->maxval(), aim_y->analog_reverse()));
+			}
+		}
+		if (steer) steer->set_value(model2_input::analog(0.5f * (input.steer + 1.0f), steer->minval(), steer->maxval(), steer->analog_reverse()));
+		if (accel) accel->set_value(model2_input::analog(input.accel, accel->minval(), accel->maxval(), accel->analog_reverse()));
+		if (brake) brake->set_value(model2_input::analog(input.brake, brake->minval(), brake->maxval(), brake->analog_reverse()));
+		if (trigger) trigger->set_value(input.trigger);
+		if (start) start->set_value(input.start);
+		if (coin) coin->set_value(input.coin);
+		if (grip_r) grip_r->set_value(input.buttons & 1);
+		if (grip_l) grip_l->set_value(input.buttons & 2);
+		if (h_pattern)
+		{
+			const u32 pressed = input.buttons & ~m_stereo_buttons_prev;
+			m_stereo_gear = model2_input::shift(m_stereo_gear, pressed & 1, pressed & 2);
+			for (int gear = 1; gear <= 4; ++gear)
+				if (gears[gear]) gears[gear]->set_value(gear == m_stereo_gear);
+		}
+		m_stereo_buttons_prev = input.buttons;
+	}
+	else if (m_stereo_controls_active)
+	{
+		for (ioport_field *field : all)
+			if (field) field->clear_value();
+		m_stereo_buttons_prev = 0;
+	}
+	m_stereo_controls_active = active;
+	m_stereo_controller_trigger = active && input.trigger && trigger;
+	// Only an explicit development switch permits scripted snapshot requests.
+	if (active && input.snapshot_request != m_stereo_snapshot_seen && model2_stereo::setting("ACVR_M2_INPUT_TEST", 0, 0, 1) == 1)
+	{
+		m_stereo_snapshot_seen = input.snapshot_request;
+		machine().video().save_active_screen_snapshots();
+		auto port = [this](const char *tag) -> int { ioport_port *p = tag ? ioport(tag) : nullptr; return p ? int(p->read()) : -1; };
+		std::printf("Controller proof snapshot %u at %.3f s: IN0=%02x IN1=%02x aim=(%d,%d) steer=%d accel=%d brake=%d gear=%d offscreen=%u\n",
+			input.snapshot_request, machine().time().as_double(), port("IN0"), port("IN1"), port(map->aim_x), port(map->aim_y),
+			port(map->steer), port(map->accel), port(map->brake), h_pattern ? m_stereo_gear : 0, unsigned(input.off_screen));
+		std::fflush(stdout);
+	}
+}
+
+// The game's actual read of its button port acknowledges controller trigger
+// edges. Held triggers cannot repeat feedback; no active mapping changes no bits.
+u8 model2_state::stereo_gun_buttons_r()
+{
+	const u8 buttons = ioport("IN1")->read();
+	const u8 mask = m_stereo_map && m_stereo_map->trigger.port && !std::strcmp(m_stereo_map->trigger.port, "IN1") ? m_stereo_map->trigger.mask : 0x01;
+	const bool pressed = m_stereo_controller_trigger && !(buttons & mask);
+	if (pressed && !m_stereo_trigger_latched)
+	{
+		++m_stereo_shot_serial;
+		if (model2_stereo::setting("ACVR_M2_INPUT_TEST", 0, 0, 1) == 1)
+		{
+			std::printf("Controller trigger acknowledged at %.3f s: serial=%llu\n",
+				machine().time().as_double(), static_cast<unsigned long long>(m_stereo_shot_serial));
+			std::fflush(stdout);
+		}
+	}
+	m_stereo_trigger_latched = pressed;
+	return buttons;
+}
diff --git a/src/mame/sega/model2_frames.h b/src/mame/sega/model2_frames.h
new file mode 100644
--- /dev/null
+++ b/src/mame/sega/model2_frames.h
@@ -0,0 +1,102 @@
+// license:BSD-3-Clause
+#ifndef MAME_SEGA_MODEL2_FRAMES_H
+#define MAME_SEGA_MODEL2_FRAMES_H
+#include <cstdint>
+#include <cstring>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <cstdio>
+#endif
+
+namespace model2_frames {
+// The 4:3 picture is 496 wide; an open-frame picture adds up to 256 pixels per side.
+constexpr unsigned width = 496, height = 384, max_width = 1008, magic = 0x4d325352;
+constexpr unsigned protocol_version = 4;
+struct controls
+{
+	std::uint64_t heartbeat_ms;
+	std::uint32_t valid, off_screen, trigger, start, coin, snapshot_request;
+	float u, v;
+	// Protocol 4: analog cabinet controls and extra buttons. steer -1 (left) .. 1 (right),
+	// accel and brake 0..1; buttons: bit 0 right grip, bit 1 left grip.
+	float steer, accel, brake;
+	std::uint32_t buttons;
+};
+struct frame
+{
+	std::uint32_t tag, version, w, h;
+	std::uint64_t serial;
+	float tan_l, tan_r, tan_b, tan_t, distance;
+	std::uint32_t exit_request;
+	double emulated_seconds;
+	std::uint64_t shot_serial, shot_time_ms;
+	controls input;
+	std::uint32_t pixels[2][height][max_width]; // rows of w pixels each
+};
+
+// Plain bitmap transport to a separate viewer, not a linked OpenXR module.
+class publisher
+{
+public:
+#ifdef _WIN32
+	publisher()
+	{
+		char name[80];
+		std::snprintf(name, sizeof(name), "Local\\ACVRM2-%lu", GetCurrentProcessId());
+		char lock_name[96]; std::snprintf(lock_name, sizeof(lock_name), "%s-lock", name);
+		m_lock = CreateMutexA(nullptr, TRUE, lock_name);
+		m_mapping = CreateFileMappingA(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, sizeof(frame), name);
+		if (m_mapping) m_frame = static_cast<frame *>(MapViewOfFile(m_mapping, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(frame)));
+		if (m_frame) { std::memset(m_frame, 0, sizeof(frame)); m_frame->tag = magic; m_frame->version = protocol_version; m_frame->w = width; m_frame->h = height; }
+		if (m_lock) ReleaseMutex(m_lock);
+	}
+	~publisher() { if (m_frame) UnmapViewOfFile(m_frame); if (m_mapping) CloseHandle(m_mapping); if (m_lock) CloseHandle(m_lock); }
+	bool publish(const std::uint32_t *left, const std::uint32_t *right, unsigned stride_l, unsigned stride_r, unsigned picture_width, const float *tangents, float distance, double seconds, std::uint64_t shots)
+	{
+		if (!m_frame || !m_lock || picture_width > max_width) return false;
+		const DWORD result = WaitForSingleObject(m_lock, 0);
+		if (result != WAIT_OBJECT_0 && result != WAIT_ABANDONED) return false;
+		for (unsigned y = 0; y < height; ++y)
+		{
+			std::memcpy(m_frame->pixels[0][y], left + y * stride_l, picture_width * 4);
+			std::memcpy(m_frame->pixels[1][y], right + y * stride_r, picture_width * 4);
+		}
+		m_frame->w = picture_width;
+		m_frame->tan_l = tangents[0]; m_frame->tan_r = tangents[1];
+		m_frame->tan_b = tangents[2]; m_frame->tan_t = tangents[3]; m_frame->distance = distance;
+		m_frame->emulated_seconds = seconds;
+		if (m_frame->shot_serial != shots) { m_frame->shot_serial = shots; m_frame->shot_time_ms = GetTickCount64(); }
+		++m_frame->serial;
+		const bool exit = m_frame->exit_request != 0;
+		ReleaseMutex(m_lock);
+		return exit;
+	}
+	bool read_controls(controls &input)
+	{
+		if (!m_frame || !m_lock) return false;
+		const DWORD result = WaitForSingleObject(m_lock, 0);
+		if (result != WAIT_OBJECT_0 && result != WAIT_ABANDONED) { input = m_last_input; return true; }
+		input = m_last_input = m_frame->input;
+		ReleaseMutex(m_lock);
+		return true;
+	}
+	static bool fresh(const controls &input)
+	{
+		const auto now = GetTickCount64();
+		return input.valid && input.heartbeat_ms <= now && now - input.heartbeat_ms < 250;
+	}
+private:
+	HANDLE m_mapping = nullptr, m_lock = nullptr;
+	frame *m_frame = nullptr;
+	controls m_last_input{};
+#else
+	bool publish(const std::uint32_t *, const std::uint32_t *, unsigned, unsigned, unsigned, const float *, float, double, std::uint64_t) { return false; }
+	bool read_controls(controls &) { return false; }
+	static bool fresh(const controls &) { return false; }
+#endif
+};
+}
+#endif

@@ -0,0 +1,95 @@
+// license:BSD-3-Clause
+#ifndef MAME_SEGA_MODEL2_INPUT_H
+#define MAME_SEGA_MODEL2_INPUT_H
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+namespace model2_input {
+inline unsigned coordinate(float normalized, unsigned minimum, unsigned maximum, bool off_screen)
+{
+ if (off_screen || !std::isfinite(normalized)) return minimum;
+ return minimum + unsigned(std::lround(std::clamp(normalized,0.0f,1.0f)*(maximum-minimum)));
+}
+
+// An analog cabinet control from a 0..1 amount. A field that MAME reverses for
+// a user's device is reversed here too, so an override equals what the same
+// physical movement would give through MAME's own input path.
+inline unsigned analog(float amount, unsigned minimum, unsigned maximum, bool reverse)
+{
+ if (!std::isfinite(amount)) amount = 0;
+ amount = std::clamp(amount, 0.0f, 1.0f);
+ if (reverse) amount = 1.0f - amount;
+ return minimum + unsigned(std::lround(amount * float(maximum - minimum)));
+}
+
+// A 4:3 coordinate from a coordinate across a wider presented picture whose
+// original 4:3 area sits in the middle with `margin` extra pixels per side.
+// Points in the extra sides are off the cabinet screen.
+inline float from_wide(float wide, unsigned margin, unsigned width, bool &off_screen)
+{
+ if (!margin) return wide;
+ const float total = float(width + 2 * margin);
+ const float inner = (wide * total - float(margin)) / float(width);
+ if (inner < 0 || inner > 1) off_screen = true;
+ return inner;
+}
+
+// What the right VR controller is on each cabinet. Field locations come from
+// MAME's own input definitions for the game (src/mame/sega/model2.cpp).
+enum class kind { none, light_gun, mounted_gun, yoke, racing };
+enum class gears { none, h_pattern, buttons };
+struct input_bit { const char *port; unsigned mask; };
+struct game_map
+{
+ const char *name;
+ kind type;
+ input_bit start, trigger, grip_right, grip_left;
+ const char *aim_x, *aim_y;            // light gun, mounted gun or yoke
+ const char *steer, *accel, *brake;    // racing
+ gears shifter;
+ // Aim trim measured against the game's own on-screen mark (default calibration):
+ // mark = scale * aim + offset, per axis, in 0..1 picture units. The inverse is applied.
+ float trim[4] = {1, 0, 1, 0}; // x scale, x offset, y scale, y offset
+};
+constexpr input_bit none_bit{nullptr, 0};
+constexpr game_map maps[] = {
+ // Light guns: Virtua Gun / Sega gun positions with the game's own off-screen border.
+ {"vcop2", kind::light_gun, {"IN0",0x10}, {"IN1",0x01}, none_bit, none_bit, "P1_X", "P1_Y", nullptr, nullptr, nullptr, gears::none},
+ {"vcop",  kind::light_gun, {"IN0",0x10}, {"IN1",0x01}, none_bit, none_bit, "P1_X", "P1_Y", nullptr, nullptr, nullptr, gears::none},
+ {"hotd",  kind::light_gun, {"IN0",0x10}, {"IN1",0x01}, none_bit, none_bit, "P1_X", "P1_Y", nullptr, nullptr, nullptr, gears::none},
+ // Mounted guns: the turret's two potentiometers. Behind Enemy Lines has a missile button.
+ {"gunblade", kind::mounted_gun, {"IN0",0x10}, {"IN1",0x01}, none_bit, none_bit, "P1_X", "P1_Y", nullptr, nullptr, nullptr, gears::none, {1.144f, -0.0552f, 1.154f, -0.084f}},
+ {"bel",      kind::mounted_gun, {"IN0",0x10}, {"IN1",0x01}, {"IN1",0x10}, none_bit, "P1_X", "P1_Y", nullptr, nullptr, nullptr, gears::none},
+ {"rchase2",  kind::mounted_gun, {"IN0",0x10}, {"IN1",0x01}, none_bit, none_bit, "P1_X", "P1_Y", nullptr, nullptr, nullptr, gears::none},
+ // Sky Target: the flight stick follows where the controller points; trigger = machine gun.
+ {"skytargt", kind::yoke, {"IN0",0x40}, {"IN1",0x10}, {"IN1",0x20}, {"IN0",0x20}, "STICKX", "STICKY", nullptr, nullptr, nullptr, gears::none},
+ // Racing: steering, accelerator and brake; the grips shift or punch/kick.
+ {"daytona",  kind::racing, {"IN0",0x10}, none_bit, none_bit, none_bit, nullptr, nullptr, "STEER", "ACCEL", "BRAKE", gears::h_pattern},
+ {"srallyc",  kind::racing, {"IN0",0x40}, none_bit, none_bit, none_bit, nullptr, nullptr, "STEER", "ACCEL", "BRAKE", gears::h_pattern},
+ {"indy500",  kind::racing, {"IN0",0x40}, none_bit, {"IN1",0x10}, {"IN1",0x20}, nullptr, nullptr, "STEER", "ACCEL", "BRAKE", gears::buttons},
+ {"manxtt",   kind::racing, {"IN0",0x40}, none_bit, {"IN1",0x10}, {"IN1",0x20}, nullptr, nullptr, "BANK", "THROTTLE", "BRAKE", gears::buttons},
+ {"motoraid", kind::racing, {"IN0",0x40}, none_bit, {"IN1",0x10}, {"IN1",0x20}, nullptr, nullptr, "BANK", "THROTTLE", "BRAKE", gears::none},
+};
+// The set itself, else its parent (clones share their parent's controls).
+inline const game_map *find(const char *name, const char *parent)
+{
+ for (const auto &map : maps) if (name && !std::strcmp(map.name, name)) return &map;
+ for (const auto &map : maps) if (parent && !std::strcmp(map.name, parent)) return &map;
+ return nullptr;
+}
+
+// The cabinet amount that puts the game's mark where the controller points.
+inline float untrim(float aim, float scale, float offset)
+{
+ return scale > 0 ? (aim - offset) / scale : aim;
+}
+
+// Sequential shifting for an H-pattern box: gear 1..4, one step per press.
+inline int shift(int gear, bool up_edge, bool down_edge)
+{
+ if (up_edge) ++gear;
+ if (down_edge) --gear;
+ return std::clamp(gear, 1, 4);
+}
+}
+#endif
diff --git a/src/mame/sega/model2_script.h b/src/mame/sega/model2_script.h
new file mode 100644
--- /dev/null
+++ b/src/mame/sega/model2_script.h
@@ -0,0 +1,82 @@
+// license:BSD-3-Clause
+// Headset-free proof input read from a plain text file (ACVR_M2_SCRIPT).
+// Each line: <emulated seconds> followed by settings that stay until changed:
+//   u=<0..1> v=<0..1> off=<0|1> trigger=<0|1> start=<0|1> coin=<0|1>
+//   steer=<-1..1> accel=<0..1> brake=<0..1> gripr=<0|1> gripl=<0|1>
+// and the word "snap", which asks MAME for one snapshot. "#" starts a comment.
+// The viewer feeds it through the shared-memory controller path; MAME can also read
+// it itself (ACVR_M2_MAME_SCRIPT) for frame-exact, repeatable proof runs.
+#ifndef MAME_SEGA_MODEL2_SCRIPT_H
+#define MAME_SEGA_MODEL2_SCRIPT_H
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace model2_script {
+struct ScriptState
+{
+	float u=.5f, v=.5f, steer=0, accel=0, brake=0;
+	unsigned off=0, trigger=0, start=0, coin=0, gripr=0, gripl=0, snaps=0;
+};
+
+class ScriptFile
+{
+public:
+	bool load(const char *path, std::string &error)
+	{
+		m_steps.clear();
+		FILE *file=std::fopen(path,"r");
+		if(!file) { error="cannot open script file"; return false; }
+		char line[1024]; unsigned number=0;
+		while(std::fgets(line,sizeof(line),file)) {
+			++number;
+			if(char *hash=std::strchr(line,'#')) *hash=0;
+			char *cursor=line; char *end=nullptr;
+			const double time=std::strtod(cursor,&end);
+			if(end==cursor) { bool blank=true; for(char *c=line;*c;++c) if(*c>' ') blank=false; if(blank) continue; error="line "+std::to_string(number)+": no time"; std::fclose(file); return false; }
+			Step step; step.time=time; cursor=end;
+			for(char *token=std::strtok(cursor," \t\r\n");token;token=std::strtok(nullptr," \t\r\n")) {
+				if(!std::strcmp(token,"snap")) { step.snap=true; continue; }
+				char *equals=std::strchr(token,'=');
+				if(!equals) { error="line "+std::to_string(number)+": bad token"; std::fclose(file); return false; }
+				*equals=0;
+				static const char *const known[]={"u","v","off","trigger","start","coin","steer","accel","brake","gripr","gripl"};
+				if(std::none_of(std::begin(known),std::end(known),[token](const char *k){return !std::strcmp(k,token);})) {
+					error="line "+std::to_string(number)+": unknown setting "+token; std::fclose(file); return false;
+				}
+				step.keys.push_back(token); step.values.push_back(std::strtod(equals+1,nullptr));
+			}
+			m_steps.push_back(step);
+		}
+		std::fclose(file);
+		std::stable_sort(m_steps.begin(),m_steps.end(),[](const Step &a,const Step &b){return a.time<b.time;});
+		return !m_steps.empty() || (error="empty script",false);
+	}
+	// The state after every step up to the given emulated time.
+	ScriptState at(double seconds) const
+	{
+		ScriptState state;
+		for(const auto &step:m_steps) {
+			if(step.time>seconds) break;
+			if(step.snap) ++state.snaps;
+			for(size_t i=0;i<step.keys.size();++i) apply(state,step.keys[i],float(step.values[i]));
+		}
+		return state;
+	}
+	double last() const { return m_steps.empty()?0:m_steps.back().time; }
+private:
+	struct Step { double time=0; bool snap=false; std::vector<std::string> keys; std::vector<double> values; };
+	static void apply(ScriptState &s,const std::string &k,float v)
+	{
+		const unsigned b=v!=0;
+		if(k=="u") s.u=v; else if(k=="v") s.v=v; else if(k=="off") s.off=b; else if(k=="trigger") s.trigger=b;
+		else if(k=="start") s.start=b; else if(k=="coin") s.coin=b; else if(k=="steer") s.steer=v;
+		else if(k=="accel") s.accel=v; else if(k=="brake") s.brake=v; else if(k=="gripr") s.gripr=b; else if(k=="gripl") s.gripl=b;
+	}
+	std::vector<Step> m_steps;
+};
+}
+#endif
diff --git a/src/mame/sega/model2_stereo.h b/src/mame/sega/model2_stereo.h
new file mode 100644
--- /dev/null
+++ b/src/mame/sega/model2_stereo.h
@@ -0,0 +1,43 @@
+// license:BSD-3-Clause
+#ifndef MAME_SEGA_MODEL2_STEREO_H
+#define MAME_SEGA_MODEL2_STEREO_H
+
+#include <cmath>
+#include <cstdlib>
+
+namespace model2_stereo {
+
+inline double setting(const char *name, double fallback, double minimum, double maximum)
+{
+	const char *text = std::getenv(name);
+	if (!text || !*text)
+		return fallback;
+	char *end = nullptr;
+	const double value = std::strtod(text, &end);
+	return end != text && !*end && std::isfinite(value) && value >= minimum && value <= maximum ? value : fallback;
+}
+
+struct settings
+{
+	bool enabled = setting("ACVR_M2_STEREO", 0, 0, 1) == 1;
+	double separation_m = setting("ACVR_M2_IPD_M", 0.064, 0, 0.2);
+	double units_per_m = setting("ACVR_M2_UNITS_PER_M", 1, 0.001, 1000000);
+	double zero_m = setting("ACVR_M2_ZERO_M", 4, 0.01, 1000000);
+	// Open frame: extra pixels drawn on each side of the 496-pixel 4:3 picture
+	// (93 gives 16:9). Only the game's full-width 3D windows are widened.
+	int wide = enabled ? int(setting("ACVR_M2_WIDE", 0, 0, 256)) : 0;
+
+	double eye(int index) const { return (index ? 0.5 : -0.5) * separation_m * units_per_m; }
+	double zero() const { return zero_m * units_per_m; }
+};
+
+// x has already been multiplied by the game's focal length. Translate the
+// parallel camera before dividing by z; the last term shifts the frustum so
+// points on the zero-parallax plane stay in the same screen position.
+inline float focused_x(float x, float z, float focal, double eye, double zero)
+{
+	return float(x + focal * eye * (z / zero - 1.0));
+}
+
+} // namespace model2_stereo
+#endif

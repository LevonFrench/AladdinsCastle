+void model2_state::render_stereo_polygons(bitmap_rgb32 &left, bitmap_rgb32 &right, const rectangle &cliprect)
+{
+	raster_state *raster = m_raster.get();
+	if (!m_render_done)
+	{
+		measure_stereo_reference();
+		const rectangle scene_rect = m_screen->visible_area();
+		for (int eye = 0; eye < 2; ++eye)
+		{
+			m_renderer->destmap().fill(0);
+			m_renderer->fillmap().fill(0);
+			for (int window = raster->cur_window; window >= 0; --window)
+				for (int z = raster->min_z; z <= raster->max_z; ++z)
+					for (polygon *source = raster->poly_sorted_list[z]; source; source = static_cast<polygon *>(source->next))
+					{
+						if (source->window != window)
+							continue;
+						// Projection and texturing mutate vertices. Keep the shared
+						// view-space list intact for the other eye and later redraws.
+						polygon poly = *source;
+						poly_vertex input[8], output[8];
+						int count = poly.num_vertices;
+						for (int i = 0; i < count; ++i)
+						{
+							input[i] = poly.v[i];
+							input[i].x = model2_stereo::focused_x(input[i].x, input[i].pz,
+								poly.focal_x, m_stereo.eye(eye), m_stereo.zero());
+						}
+						// Clip separately for each shifted, parallel camera, before
+						// the perspective divide. No central-frustum edge loss.
+						for (int plane = 0; plane < 4 && count; ++plane)
+						{
+							count = clip_polygon(input, count, output, poly.eye_clip[plane]);
+							std::copy_n(output, count, input);
+						}
+						if (count < 3)
+							continue;
+						poly.num_vertices = count;
+						std::copy_n(input, count, poly.v);
+						model2_3d_project(&poly);
+						m_renderer->model2_3d_render(&poly, scene_rect);
+					}
+			m_renderer->wait("End of stereo eye");
+			copybitmap(m_stereo_scene[eye], m_renderer->destmap(), 0, 0, 0, 0, scene_rect);
+		}
+		m_render_done = true;
+	}
+	copybitmap_trans(left, m_stereo_scene[0], 0, 0, 0, 0, cliprect, 0);
+	copybitmap_trans(right, m_stereo_scene[1], 0, 0, 0, 0, cliprect, 0);
+}
+
+u32 model2_state::stereo_screen_update(screen_device &screen, bitmap_rgb32 &bitmap, const rectangle &cliprect)
+{
+	bitmap.fill(0, cliprect);
+	copybitmap(bitmap, m_stereo_eye[0], 0, 0, 0, 0, cliprect);
+	copybitmap(bitmap, m_stereo_eye[1], 0, 0, m_screen->visible_area().width(), 0, cliprect);
+	return 0;
+}

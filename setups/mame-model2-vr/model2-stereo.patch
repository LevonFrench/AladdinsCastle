+void model2_state::measure_stereo_reference()
+{
+	const double seconds = model2_stereo::setting("ACVR_M2_MEASURE_SECOND", -1, 0, 10000000);
+	if (m_stereo_measure_done || seconds < 0 || machine().time().as_double() < seconds)
+		return;
+	const double target[2][2] = {
+		{ model2_stereo::setting("ACVR_M2_MEASURE_AX", 0, -10000, 10000), model2_stereo::setting("ACVR_M2_MEASURE_AY", 0, -10000, 10000) },
+		{ model2_stereo::setting("ACVR_M2_MEASURE_BX", 0, -10000, 10000), model2_stereo::setting("ACVR_M2_MEASURE_BY", 0, -10000, 10000) }
+	};
+	struct sample { double x = 0, y = 0, z = 0, error = 1e30, px = 0, py = 0, fx = 0, fy = 0; } picked[2];
+	for (int which = 0; which < 2; ++which)
+		for (unsigned p = 0; p < m_raster->poly_list_index; ++p)
+		{
+			const polygon &poly = m_raster->poly_list[p];
+			if (poly.focal_x <= 0 || poly.focal_y <= 0)
+				continue;
+			for (int v = 0; v < poly.num_vertices; ++v)
+			{
+				const poly_vertex &vertex = poly.v[v];
+				if (vertex.pz <= 0 || (which && std::abs(vertex.pz - picked[0].z) > 0.2 * picked[0].z))
+					continue;
+				const double x = m_crtc_xoffset + poly.center[0] + model2_stereo::focused_x(vertex.x,
+					vertex.pz, poly.focal_x, m_stereo.eye(0), m_stereo.zero()) / vertex.pz;
+				const double y = 384 - poly.center[1] + m_crtc_yoffset - vertex.y / vertex.pz;
+				const double error = std::hypot(x - target[which][0], y - target[which][1]);
+				if (error < picked[which].error)
+					picked[which] = {vertex.x / poly.focal_x, vertex.y / poly.focal_y, vertex.pz,
+						error, x, y, poly.focal_x, poly.focal_y};
+			}
+		}
+	const double span = std::sqrt(std::pow(picked[1].x - picked[0].x, 2) +
+		std::pow(picked[1].y - picked[0].y, 2) + std::pow(picked[1].z - picked[0].z, 2));
+	const double reference_m = model2_stereo::setting("ACVR_M2_REFERENCE_M", 1, 0.001, 1000000);
+	if (model2_stereo::setting("ACVR_M2_MEASURE_BODY", 0, 0, 1) == 1)
+	{
+		sample low, high;
+		low.y = 1e30;
+		high.y = -1e30;
+		const double xmin = model2_stereo::setting("ACVR_M2_MEASURE_XMIN", 0, -10000, 10000);
+		const double xmax = model2_stereo::setting("ACVR_M2_MEASURE_XMAX", 496, -10000, 10000);
+		const double ymin = model2_stereo::setting("ACVR_M2_MEASURE_YMIN", 0, -10000, 10000);
+		const double ymax = model2_stereo::setting("ACVR_M2_MEASURE_YMAX", 384, -10000, 10000);
+		for (unsigned p = 0; p < m_raster->poly_list_index; ++p)
+		{
+			const polygon &poly = m_raster->poly_list[p];
+			if (poly.focal_x <= 0 || poly.focal_y <= 0)
+				continue;
+			for (int v = 0; v < poly.num_vertices; ++v)
+			{
+				const poly_vertex &vertex = poly.v[v];
+				if (vertex.pz <= 0 || std::abs(vertex.pz - picked[0].z) > 0.1 * picked[0].z)
+					continue;
+				const double px = m_crtc_xoffset + poly.center[0] + model2_stereo::focused_x(vertex.x,
+					vertex.pz, poly.focal_x, m_stereo.eye(0), m_stereo.zero()) / vertex.pz;
+				const double py = 384 - poly.center[1] + m_crtc_yoffset - vertex.y / vertex.pz;
+				if (px < xmin || px > xmax || py < ymin || py > ymax)
+					continue;
+				const sample current = {vertex.x / poly.focal_x, vertex.y / poly.focal_y, vertex.pz,
+					0, px, py, poly.focal_x, poly.focal_y};
+				if (current.y < low.y) low = current;
+				if (current.y > high.y) high = current;
+			}
+		}
+		osd_printf_info("M2 upright reference: y=[%.9g,%.9g], bottom pixel=(%.3f,%.3f), top pixel=(%.3f,%.3f), height=%.9g world units, assumed height=%.9g metres, estimated units/metre=%.9g\n",
+			low.y, high.y, low.px, low.py, high.px, high.py, high.y - low.y, reference_m, (high.y - low.y) / reference_m);
+		m_stereo_measure_done = true;
+		return;
+	}
+	for (int i = 0; i < 2; ++i)
+		osd_printf_info("M2 reference %c: pixel=(%.3f,%.3f), error=%.3f px, view=(%.9g,%.9g,%.9g), focal=(%.9g,%.9g)\n",
+			'A' + i, picked[i].px, picked[i].py, picked[i].error, picked[i].x, picked[i].y, picked[i].z, picked[i].fx, picked[i].fy);
+	osd_printf_info("M2 reference: span=%.9g world units, assumed length=%.9g metres, estimated units/metre=%.9g\n",
+		span, reference_m, span / reference_m);
+	m_stereo_measure_done = true;
+}
+
+// The game's main 3D window spans the visible screen; only that one is widened
+// for the open frame. Small windows (mirrors, HUD models) keep their size.
+static bool full_width_window(const model2_state::polygon &poly, int xoffset)
+{
+	return poly.viewport[0] + xoffset <= 8 && poly.viewport[2] + xoffset >= 487;
+}
+
+void model2_state::render_stereo_polygons()
+{
+	raster_state *raster = m_raster.get();
+	if (m_render_done)
+		return;
+	measure_stereo_reference();
+	const int margin = m_stereo.wide;
+	const rectangle &visible = m_screen->visible_area();
+	const rectangle scene_rect(visible.min_x, visible.max_x + 2 * margin, visible.min_y, visible.max_y);
+	// Everything moves right by the margin; the original picture sits in the middle.
+	m_renderer->set_xoffset(m_crtc_xoffset + margin);
+	for (int eye = 0; eye < 2; ++eye)
+	{
+		m_renderer->destmap().fill(0);
+		m_renderer->fillmap().fill(0);
+		for (int window = raster->cur_window; window >= 0; --window)
+			for (int z = raster->min_z; z <= raster->max_z; ++z)
+				for (polygon *source = raster->poly_sorted_list[z]; source; source = static_cast<polygon *>(source->next))
+				{
+					if (source->window != window)
+						continue;
+					// Projection and texturing mutate vertices. Keep the shared
+					// view-space list intact for the other eye and later redraws.
+					polygon poly = *source;
+					if (margin && full_width_window(poly, m_crtc_xoffset))
+					{
+						// Same frustum construction as the hardware's window command,
+						// with the left and right edges moved out by the margin.
+						poly.viewport[0] -= margin;
+						poly.viewport[2] += margin;
+						const float left_plane = float(poly.center[0] - poly.viewport[0]);
+						const float right_plane = float(poly.viewport[2] - poly.center[0]);
+						poly.eye_clip[0].normal.x = 1.0f / std::hypot(1.0f, left_plane);
+						poly.eye_clip[0].normal.pz = left_plane / std::hypot(1.0f, left_plane);
+						poly.eye_clip[1].normal.x = -1.0f / std::hypot(-1.0f, right_plane);
+						poly.eye_clip[1].normal.pz = right_plane / std::hypot(-1.0f, right_plane);
+					}
+					poly_vertex input[8], output[8];
+					int count = poly.num_vertices;
+					for (int i = 0; i < count; ++i)
+					{
+						input[i] = poly.v[i];
+						input[i].x = model2_stereo::focused_x(input[i].x, input[i].pz,
+							poly.focal_x, m_stereo.eye(eye), m_stereo.zero());
+					}
+					// Clip separately for each shifted, parallel camera, before
+					// the perspective divide. No central-frustum edge loss.
+					for (int plane = 0; plane < 4 && count; ++plane)
+					{
+						count = clip_polygon(input, count, output, poly.eye_clip[plane]);
+						std::copy_n(output, count, input);
+					}
+					if (count < 3)
+						continue;
+					poly.num_vertices = count;
+					std::copy_n(input, count, poly.v);
+					model2_3d_project(&poly);
+					for (int i = 0; i < count; ++i)
+						poly.v[i].x += margin;
+					m_renderer->model2_3d_render(&poly, scene_rect);
+				}

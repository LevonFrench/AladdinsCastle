+struct XFBCopyRectangles
+{
+  MathUtil::Rectangle<int> source;
+  MathUtil::Rectangle<int> destination;
+  bool requires_scale = false;
+};
+
+struct XFBCopyOperation
+{
+  TCacheEntry* source = nullptr;
+  XFBCopyRectangles rectangles;
+  bool mono_provenance = false;
+};
+
+struct XFBCopyAnalysis
+{
+  std::vector<XFBCopyOperation> operations;
+  bool has_layered_gpu_source = false;
+  bool has_scaled_mono_source = false;
+  bool has_unsupported_layered_scale = false;
+};
+
+// One geometry calculation is shared by promotion preflight and the changed copy loop. The caller
+// performs the original optional upscale first, so bounds here always use the actual destination.
+static bool CalculateXFBCopyRectangles(const TCacheEntry& destination, const TCacheEntry& source,
+                                       XFBCopyRectangles* rectangles)
+{
+  if (destination.native_width <= 0 || destination.native_height <= 0 ||
+      source.native_width <= 0 || source.native_height <= 0 || !source.texture)
+  {
+    return false;
+  }
+
+  int src_x;
+  int src_y;
+  int dst_x;
+  int dst_y;
+  if (source.addr >= destination.addr)
+  {
+    const int pixel_offset = (source.addr - destination.addr) / 2;
+    src_x = 0;
+    src_y = 0;
+    dst_x = pixel_offset % destination.native_width;
+    dst_y = pixel_offset / destination.native_width;
+  }
+  else
+  {
+    const int pixel_offset = (destination.addr - source.addr) / 2;
+    src_x = pixel_offset % source.native_width;
+    src_y = pixel_offset / source.native_width;
+    dst_x = 0;
+    dst_y = 0;
+  }
+
+  const int native_width =
+      std::min(source.native_width - src_x, destination.native_width - dst_x);
+  const int native_height =
+      std::min(source.native_height - src_y, destination.native_height - dst_y);
+  if (native_width <= 0 || native_height <= 0)
+    return false;
+
+  int src_width = native_width;
+  int src_height = native_height;
+  int dst_width = native_width;
+  int dst_height = native_height;
+  // Map rectangle endpoints using each allocation's own dimensions. Cached source/destination
+  // textures can retain a scale different from the current framebuffer-manager scale.
+  const auto scale_endpoint = [](int value, int native_extent, u32 allocation_extent) {
+    return static_cast<int>(static_cast<s64>(value) * allocation_extent / native_extent);
+  };
+  const int src_right = src_x + src_width;
+  const int src_bottom = src_y + src_height;
+  const int dst_right = dst_x + dst_width;
+  const int dst_bottom = dst_y + dst_height;
+  const int scaled_src_x = scale_endpoint(src_x, source.native_width, source.GetWidth());
+  const int scaled_src_y = scale_endpoint(src_y, source.native_height, source.GetHeight());
+  const int scaled_dst_x = scale_endpoint(dst_x, destination.native_width, destination.GetWidth());
+  const int scaled_dst_y = scale_endpoint(dst_y, destination.native_height, destination.GetHeight());
+  src_width = scale_endpoint(src_right, source.native_width, source.GetWidth()) - scaled_src_x;
+  src_height = scale_endpoint(src_bottom, source.native_height, source.GetHeight()) - scaled_src_y;
+  dst_width = scale_endpoint(dst_right, destination.native_width, destination.GetWidth()) - scaled_dst_x;
+  dst_height = scale_endpoint(dst_bottom, destination.native_height, destination.GetHeight()) - scaled_dst_y;
+  src_x = scaled_src_x;
+  src_y = scaled_src_y;
+  dst_x = scaled_dst_x;
+  dst_y = scaled_dst_y;
+
+  if (src_x < 0 || src_y < 0 || dst_x < 0 || dst_y < 0 || src_width <= 0 || src_height <= 0 ||
+      dst_width <= 0 || dst_height <= 0 ||
+      static_cast<u32>(src_x + src_width) > source.GetWidth() ||
+      static_cast<u32>(src_y + src_height) > source.GetHeight() ||
+      static_cast<u32>(dst_x + dst_width) > destination.GetWidth() ||
+      static_cast<u32>(dst_y + dst_height) > destination.GetHeight())
+  {
+    return false;
+  }
+
+  rectangles->source = {src_x, src_y, src_x + src_width, src_y + src_height};
+  rectangles->destination = {dst_x, dst_y, dst_x + dst_width, dst_y + dst_height};
+  rectangles->requires_scale = src_width != dst_width || src_height != dst_height;
+  return true;
+}
+
+// Analyze only hash-valid entries admitted by StitchXFBCopy's IsCopy()/overlap/stride checks.
+// XFB containers retain mono RAM provenance even after a prior W2 promotion.
+static XFBCopyAnalysis AnalyzeXFBCopyCandidates(const TCacheEntry& destination,
+                                                const std::vector<TCacheEntry*>& candidates)
+{
+  XFBCopyAnalysis analysis;
+  analysis.operations.reserve(candidates.size());
+  for (TCacheEntry* source : candidates)
+  {
+    if (!source->IsCopy() || source->GetNumLayers() == 0)
+      continue;
+
+    XFBCopyRectangles rectangles;
+    if (!CalculateXFBCopyRectangles(destination, *source, &rectangles))
+      continue;
+
+    const bool mono_provenance = source->is_xfb_container || source->GetNumLayers() < 2;
+    if (mono_provenance && rectangles.requires_scale)
+      analysis.has_scaled_mono_source = true;
+    if (!source->is_xfb_container && source->GetNumLayers() >= 2)
+    {
+      analysis.has_layered_gpu_source = true;
+      if (rectangles.requires_scale && !g_backend_info.bSupportsGeometryShaders)
+        analysis.has_unsupported_layered_scale = true;
+    }
+
+    analysis.operations.push_back({source, rectangles, mono_provenance});
+  }
+  return analysis;
+}

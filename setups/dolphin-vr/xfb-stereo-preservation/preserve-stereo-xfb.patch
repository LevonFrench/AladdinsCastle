+static std::optional<double> GetNonnegativeEnvironmentSeconds(const char* name)
+{
+  const char* value = std::getenv(name);
+  if (!value || !*value)
+    return std::nullopt;
+
+  char* end = nullptr;
+  const double seconds = std::strtod(value, &end);
+  if (end == value || *end != '\0' || !std::isfinite(seconds) || seconds < 0.0)
+    return std::nullopt;
+  return seconds;
+}
+
+static bool IsW2DiagnosticTimeSelected(double emulated_seconds)
+{
+  const std::optional<double> start = GetNonnegativeEnvironmentSeconds("AC_W2_TRACE_START_S");
+  const std::optional<double> duration = GetNonnegativeEnvironmentSeconds("AC_W2_TRACE_DURATION_S");
+  if (!IsW2SyntheticDiagnosticEnabled() || !start || !duration || *duration <= 0.0 ||
+      *duration > 60.0)
+  {
+    return false;
+  }
+  const double end = *start + *duration;
+  return std::isfinite(end) && emulated_seconds >= *start && emulated_seconds < end;
+}

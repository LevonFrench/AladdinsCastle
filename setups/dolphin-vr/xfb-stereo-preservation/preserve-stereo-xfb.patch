+bool TextureCacheBase::PromoteXFBEntryToStereo(RcTcacheEntry& entry)
+{
+  if (!entry || !entry->texture)
+    return false;
+  if (entry->GetNumLayers() >= 2)
+    return true;
+  if (entry->GetNumLayers() != 1)
+    return false;
+
+  TextureConfig promoted_config = entry->texture->GetConfig();
+  promoted_config.layers = 2;
+  std::optional<TexPoolEntry> promoted = AllocateTexture(promoted_config);
+  if (!promoted)
+  {
+    return false;
+  }
+
+  // Guest RAM contains a single image. Duplicate it into both slices as explicitly mono fallback.
+  // Real two-layer EFB copies overwrite only their clipped destination regions later in stitching.
+  const MathUtil::Rectangle<int> rect = entry->texture->GetConfig().GetRect();
+  for (u32 layer = 0; layer < 2; ++layer)
+  {
+    promoted->texture->CopyRectangleFromTexture(entry->texture.get(), rect, 0, 0, rect, layer, 0);
+  }
+  promoted->texture->FinishedRendering();
+  entry->texture.swap(promoted->texture);
+  entry->framebuffer.swap(promoted->framebuffer);
+
+  // Retain the TCacheEntry identity, hashes, references, and refcount. Recycle only its old texture.
+  const TextureConfig old_config = promoted->texture->GetConfig();
+  m_texture_pool.emplace(
+      old_config, TexPoolEntry(std::move(promoted->texture), std::move(promoted->framebuffer)));
+  return true;
+}

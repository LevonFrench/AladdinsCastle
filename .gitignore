# Never commit saves, save states, memory cards, keys or credentials
*.sav
*.state
*.srm
*.mcr
*.mcd
*.vmu
*.keys
*.pem
*.p12
.env
# Synthetic test certificates are public fixtures
!hub/tests/fixtures/**/*.pem

# Build output
build/
out/
bin/
obj/
.godot/
*.apk

# Local machine / agent files
AGENCY.md
AGENCY-HISTORY.md
DECISIONS.md
.claude/
.vs/
.vscode/
*.log

# Local machine reports (never commit)
.local/
# Output files named by a mangled path (a script wrote the path into the file name)
/projectsgames*

# Runtime data (user art, installs) never published
/user/
/installed/
/emulators/
.wrangler/

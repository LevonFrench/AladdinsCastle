get_filename_component(AC_PRODUCT_FILE "${CMAKE_CURRENT_SOURCE_DIR}/../data/product.json" ABSOLUTE)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${AC_PRODUCT_FILE}")
file(READ "${AC_PRODUCT_FILE}" AC_PRODUCT_JSON)
string(JSON AC_PRODUCT_SCHEMA GET "${AC_PRODUCT_JSON}" schema)
if(NOT AC_PRODUCT_SCHEMA EQUAL 1)
    message(FATAL_ERROR "Unsupported product identity schema")
endif()
foreach(field display_name short_id program_name overlay_key steam_shortcut_name user_data_folder dsu_server_name)
    string(JSON AC_PRODUCT_${field} GET "${AC_PRODUCT_JSON}" ${field})
    if(NOT AC_PRODUCT_${field} MATCHES "^[A-Za-z0-9][A-Za-z0-9 ._-]*$")
        message(FATAL_ERROR "Invalid product identity field: ${field}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated")
configure_file("${AC_PRODUCT_FILE}" "${CMAKE_BINARY_DIR}/generated/product.json" COPYONLY)
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/src/core/app/ProductIdentity.h.in" "${CMAKE_BINARY_DIR}/generated/ProductIdentity.h" @ONLY)

{
  "controller_type": "oculus_touch",
  "bindings": {
    "/actions/hub": {
      "sources": [
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/hub/in/close_game"
            }
          }
        }
      ]
    }
  },
  "description": "AladdinsCastle Hub: hold the left upper face button to close the game"
}

{
  "controller_type": "oculus_touch",
  "bindings": {
    "/actions/hub": {
      "sources": [
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/hub/in/back"
            }
          }
        }
      ]
    }
  },
  "description": "AladdinsCastle Hub: the right B button goes back one page in the panel; no other button, and no menu or system button, is bound"
}

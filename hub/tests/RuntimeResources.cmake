# Execute the real resource commands with small native targets, not Qt/XR.
file(READ "${HUB_SOURCE}/CMakeLists.txt" source)
string(FIND "${source}" "file(MAKE_DIRECTORY \"\${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/resources\")" begin)
string(FIND "${source}" "ac_project_warnings(aladdinscastle-hub)" end)
if(begin LESS 0 OR end LESS begin)
    message(FATAL_ERROR "Hub runtime resource block not found")
endif()
math(EXPR length "${end}-${begin}")
string(SUBSTRING "${source}" ${begin} ${length} resource_commands)
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef run)
set(root "${TEST_ROOT}/${run}")
set(fixture "${root}/source")
file(MAKE_DIRECTORY "${fixture}/resources")
file(COPY "${HUB_SOURCE}/resources/dashboard.vrmanifest.in"
    "${HUB_SOURCE}/resources/overlay-thumbnail.png" DESTINATION "${fixture}/resources")
file(WRITE "${fixture}/main.cpp" "int main() { return 0; }\n")
file(WRITE "${fixture}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.28)\nproject(ResourceFixture LANGUAGES CXX)\nset(CMAKE_RUNTIME_OUTPUT_DIRECTORY \"\${CMAKE_BINARY_DIR}/bin\")\nset(AC_PRODUCT_short_id synthetic)\nset(AC_PRODUCT_program_name synthetic-program)\nset(AC_PRODUCT_display_name \"Synthetic Product\")\nset(AC_PRODUCT_overlay_key org.synthetic.product)\nadd_executable(aladdinscastle-hub main.cpp)\nset_target_properties(aladdinscastle-hub PROPERTIES OUTPUT_NAME synthetic-program)\n${resource_commands}\n")
# The fixture exercises layout, not debug symbols. Avoid an unrelated local
# MSVC PDB-manager mismatch while retaining actual Debug target generation.
file(APPEND "${fixture}/CMakeLists.txt" "if(MSVC)\nset(CMAKE_CXX_FLAGS_DEBUG \"/Ob0 /Od /RTC1\")\nset_property(TARGET aladdinscastle-hub PROPERTY MSVC_DEBUG_INFORMATION_FORMAT Embedded)\nendif()\n")
file(SHA256 "${fixture}/resources/overlay-thumbnail.png" expected_thumbnail)
set(failures "")
foreach(generator IN ITEMS "Ninja" "Ninja Multi-Config")
    string(REPLACE " " "-" directory "${generator}")
    set(build "${root}/${directory}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${build}"
        -G "${generator}" "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}"
        -DCMAKE_TRY_COMPILE_CONFIGURATION=Release
        -DCMAKE_BUILD_TYPE=Release
        "-DCMAKE_MAKE_PROGRAM=${NINJA}" RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${generator} configure failed: ${output}${error}")
    endif()
    if(generator STREQUAL "Ninja")
        set(configurations Release)
    else()
        set(configurations Release Debug)
    endif()
    foreach(config IN LISTS configurations)
        execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --config "${config}"
            --target aladdinscastle-hub RESULT_VARIABLE result
            OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${generator}/${config} build failed: ${output}${error}")
        endif()
        set(executable_dir "${build}/bin")
        if(generator STREQUAL "Ninja Multi-Config")
            string(APPEND executable_dir "/${config}")
        endif()
        set(thumbnail "${executable_dir}/resources/overlay-thumbnail.png")
        set(manifest "${executable_dir}/resources/synthetic.vrmanifest")
        if(NOT EXISTS "${executable_dir}/synthetic-program${EXE_SUFFIX}")
            message(FATAL_ERROR "Actual target executable missing: ${executable_dir}")
        endif()
        if(NOT EXISTS "${thumbnail}" OR NOT EXISTS "${manifest}")
            string(APPEND failures "\n${generator}/${config}: assets absent beside actual target at ${executable_dir}")
            continue()
        endif()
        file(SHA256 "${thumbnail}" actual_thumbnail)
        if(NOT actual_thumbnail STREQUAL expected_thumbnail)
            message(FATAL_ERROR "Thumbnail bytes changed: ${thumbnail}")
        endif()
        file(READ "${manifest}" manifest_json)
        string(JSON binary GET "${manifest_json}" applications 0 binary_path_windows)
        string(JSON image GET "${manifest_json}" applications 0 image_path)
        string(JSON key GET "${manifest_json}" applications 0 app_key)
        if(NOT binary STREQUAL "../synthetic-program.exe" OR
           NOT image STREQUAL "overlay-thumbnail.png" OR NOT key STREQUAL "org.synthetic.product")
            message(FATAL_ERROR "Portable manifest identity/relative paths changed: ${manifest}")
        endif()
        message(STATUS "PASS ${generator}/${config}: actual target, byte-exact thumbnail and portable manifest")
    endforeach()
endforeach()
if(failures)
    message(FATAL_ERROR "Runtime resource placement failed:${failures}")
endif()

# Changing only an asset must update adjacent copies without source relinking.
file(APPEND "${fixture}/resources/overlay-thumbnail.png" "synthetic asset update")
file(SHA256 "${fixture}/resources/overlay-thumbnail.png" updated_thumbnail)
set(update_failures "")
foreach(layout IN ITEMS "Ninja/Release" "Ninja-Multi-Config/Release" "Ninja-Multi-Config/Debug")
    string(REPLACE "/" ";" parts "${layout}")
    list(GET parts 0 directory)
    list(GET parts 1 config)
    set(build "${root}/${directory}")
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --config "${config}"
        --target aladdinscastle-hub RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${layout} asset-only build failed: ${output}${error}")
    endif()
    set(executable_dir "${build}/bin")
    if(directory STREQUAL "Ninja-Multi-Config")
        string(APPEND executable_dir "/${config}")
    endif()
    file(SHA256 "${executable_dir}/resources/overlay-thumbnail.png" actual_thumbnail)
    if(NOT actual_thumbnail STREQUAL updated_thumbnail)
        string(APPEND update_failures "\n${layout}: adjacent thumbnail stale after asset-only build")
    else()
        message(STATUS "PASS ${layout}: asset-only update copied byte-exactly")
    endif()
endforeach()
if(update_failures)
    message(FATAL_ERROR "Incremental runtime resource update failed:${update_failures}")
endif()

# Exercise the real extra-test registration with program discovery disabled.
# A non-Ninja build must not require Ninja merely to configure Hub tests.
string(FIND "${source}" "    find_program(_ac_resource_ninja" registration_begin)
string(FIND "${source}" "    qt_add_executable(gun-room-tests" registration_end)
math(EXPR registration_length "${registration_end}-${registration_begin}")
string(SUBSTRING "${source}" ${registration_begin} ${registration_length} registration)
set(no_ninja "${root}/no-ninja-source")
file(MAKE_DIRECTORY "${no_ninja}")
file(WRITE "${no_ninja}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.28)\nproject(NoNinjaDiscovery LANGUAGES NONE)\nenable_testing()\n${registration}\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${no_ninja}" -B "${root}/no-ninja-build"
    -G Ninja "-DCMAKE_MAKE_PROGRAM=${NINJA}"
    -DCMAKE_FIND_USE_CMAKE_ENVIRONMENT_PATH=FALSE -DCMAKE_FIND_USE_CMAKE_PATH=FALSE
    -DCMAKE_FIND_USE_SYSTEM_ENVIRONMENT_PATH=FALSE -DCMAKE_FIND_USE_CMAKE_SYSTEM_PATH=FALSE
    -DCMAKE_FIND_USE_INSTALL_PREFIX=FALSE
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "No-Ninja discovery configuration failed: ${output}${error}")
endif()
if(NOT output MATCHES "Skipping hub-runtime-resources")
    message(FATAL_ERROR "No-Ninja configuration must explain the skipped extra regression: ${output}")
endif()
message(STATUS "PASS no-Ninja discovery: configure succeeds with explicit extra-test skip")
